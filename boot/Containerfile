# sdlc-bootstrap: the trust root. bin/sdlc-bootstrap grown into an image.
#
# It holds cosign, sdlc's public key, the major version it follows and a
# minimum version, all baked in, and runs the verified sdlc image as a sibling
# container (boot/sdlc). The fleet file names this image by digest, so a change
# to anything below is a fleet edit.
#
# Build context is the repo root: podman build -f boot/Containerfile .

ARG DOCKER_CLI_VERSION=29.9.3
# The base by digest: this image is the fleet's trust root and is itself named
# by digest, so nothing in it floats. scripts/update_tools.py moves this when
# 2-builder's digest moves on quay.
ARG BOOT_BASE_DIGEST=sha256:3f42474b6433b58659076dd80a96d93bb9b124aa3d79a244d1dbb0282fbe71e9

# The docker CLI, not podman-remote: the job container's socket is dockerd on
# GitHub-hosted runners, which podman-remote cannot speak (it uses libpod
# endpoints). The docker CLI speaks both dockerd and podman's Docker-compatible
# API on gha-runner.
FROM docker.io/library/docker:${DOCKER_CLI_VERSION}-cli@sha256:5a7af0dcb0e46c803efe9b45371dd21cb500e5b4453250394ac6f06d49b6e6f1 AS docker

FROM quay.io/hummingbird/core-runtime:2-builder@${BOOT_BASE_DIGEST}

ARG COSIGN_VERSION=2.6.5
ARG DOCKER_CLI_VERSION=29.9.3
ARG SDLC_MAJOR=0
ARG SDLC_MIN_VERSION=0.12.0
ARG VERSION=unknown
ARG REVISION=unknown
ARG CREATED=unknown

# The builder tag defaults to a non-root user; dnf and the job both want root.
USER root

# jq reads cosign's output and names the environment to pass on. bash,
# coreutils and the CA bundle come with the base.
RUN dnf install -y jq && dnf clean all && rm -rf /var/cache/dnf /var/cache/libdnf5 /var/lib/dnf/history* /tmp/*

# cosign v2.6.5, the signer's version, as bin/sdlc-bootstrap: v3 keeps
# signatures where podman and bootc cannot read them. The index digest, so
# every architecture gets it.
COPY --from=ghcr.io/sigstore/cosign/cosign@sha256:ad281047f85c5e1fc6ffbc30c2b55be3b07b4032bef715a12122ce5829619aca /ko-app/cosign /usr/local/bin/cosign
COPY --from=docker /usr/local/bin/docker /usr/local/bin/docker

COPY boot/keys/ /etc/sdlc-bootstrap/keys/
# The trust policy, as files and not ENV: the major to follow and the oldest
# release it may run. A job's env: can override ENV; it cannot rewrite these.
RUN printf '%s\n' "${SDLC_MAJOR}" > /etc/sdlc-bootstrap/major \
 && printf '%s\n' "${SDLC_MIN_VERSION}" > /etc/sdlc-bootstrap/minimum
COPY boot/sdlc /usr/local/bin/sdlc
RUN chmod 0755 /usr/local/bin/sdlc

LABEL org.opencontainers.image.source="https://github.com/crunchtools/sdlc" \
      org.opencontainers.image.description="sdlc-bootstrap: verifies the signed sdlc image and runs it as a sibling container" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.created="${CREATED}" \
      version="${VERSION}" \
      com.crunchtools.sdlc-bootstrap.major="${SDLC_MAJOR}" \
      com.crunchtools.sdlc-bootstrap.minimum="${SDLC_MIN_VERSION}" \
      com.crunchtools.sdlc-bootstrap.cosign="${COSIGN_VERSION}" \
      com.crunchtools.sdlc-bootstrap.docker-cli="${DOCKER_CLI_VERSION}"

# Stays root: GitHub runs job containers as root and overrides this entrypoint
# anyway, and the socket is reachable only as root.
ENTRYPOINT ["/usr/local/bin/sdlc"]
