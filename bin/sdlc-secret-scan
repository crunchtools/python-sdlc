#!/bin/sh
# sdlc-secret-scan BASE [TARGET]: refuse a change that adds a plaintext secret.
#
# Constitution XVII: no plaintext secret in any committed file. This is
# gatehouse's `Refuse plaintext secrets` step (gourmand.yml, last at
# crunchtools/gatehouse@9ac16df), moved here when the fleet ci.yml replaced
# every repo's gourmand.yml (#213). The event and fetch logic stayed behind:
# `sdlc secret-scan` resolves BASE, and the check job fetches it in CI.
#
# Reads only the lines added between BASE and TARGET (HEAD by default). A
# vendor credential shape, or a secret-named key given a literal, fails with
# an `::error` naming the file, line and key, never the value. A named literal
# in a test or doc file only warns. A line carrying `gatehouse: allow-secret`
# is a fixture and is skipped.
#
# 0 clean, 1 refused, 2 git could not diff BASE and TARGET.
if [ $# -lt 1 ] || [ $# -gt 2 ] || [ -z "$1" ]; then
  echo "usage: sdlc-secret-scan BASE [TARGET]" >&2
  exit 2
fi
BASE=$1
TARGET=${2:-HEAD}
set -eu
hits=0
warns=0
shapes='AIza[0-9A-Za-z_-]{35}|sk-ant-[A-Za-z0-9_-]{20,}|sk-or-v1-[0-9a-f]{32,}|gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{22,}|glpat-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,}|eyJ[A-Za-z0-9_-]{8,}\.eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}'
# Secret-named keys given a literal (a475). Bracket escapes only, so
# GNU, BSD and busybox grep read them alike. ENV is an environment
# variable's name, KEY the same word as code spells it.
Q="[\"']"
ENV='(PASSWORD|PASSWD|PASSPHRASE|SECRET|TOKEN|API_?KEY)'
KEY='([Pp]ass(word|wd|phrase)|PASS(WORD|WD|PHRASE)|[Ss]ecret|SECRET|[Tt]oken|TOKEN|[Aa]pi[_-]?[Kk]ey|API_?KEY|([Pp]rivate|[Aa]ccess)[_-]?[Kk]ey|(PRIVATE|ACCESS)_KEY)'
# A secret env read with a literal default: `|| 'x'`, `?? 'x'`, `or 'x'`,
# `${X:-x}`, `getenv("X", "x")`. Refused even as a placeholder: the
# default is what runs when the variable is unset.
fallback="${ENV}[]\"')]*[[:space:]]*([|][|]|[?][?]|[[:space:]]or)[[:space:]]*${Q}[^\"']{3,}${Q}|[\$][{][A-Z0-9_]*${ENV}:?-[^}\$]{3,}[}]|(getenv|environ[.]get|env[.]get)[(]${Q}[A-Z0-9_]*${ENV}${Q},[[:space:]]*${Q}[^\"']{3,}${Q}"
# A secret-named key given a quoted literal: `password: 'x'`, `token = "x"`.
akey="[A-Za-z0-9_.-]*${KEY}${Q}?[[:space:]]*(:|=|:=|=>)[[:space:]]*"
assign="${akey}${Q}[^\"'[:space:]]{3,}${Q}"
# In env, compose, yaml, conf and unit files and Containerfiles:
# `PGPASSWORD=x`, `- SECRET: "x"`, `ENV X=x`, `Environment="X=x"`,
# `PodmanArgs=--env X=x`.
prefix="(export[[:space:]]+|ENV[[:space:]]+|ARG[[:space:]]+|Environment=${Q}?|([A-Za-z]+=)?--env[[:space:]=]+)?"
ekey="^[[:space:]]*(-[[:space:]]+)?${prefix}[A-Z0-9_]*${ENV}[[:space:]]*[=:][[:space:]]*"
pvalue="(${Q}[^\"'[:space:]\$<{|>&]|[^\"'[:space:]\$<{#|>&])[^\"'[:space:]]{2,}"
envline="${ekey}${pvalue}"
# Every later pair too, not just the first: `ENV A=x PGPASSWORD=y`,
# `Environment="A=x" "B=y"`, `export A=x B=y`, and an `-e`/`--env`
# pair anywhere (`docker run -e A=x -e B=y`). A bare pair counts
# only on an ENV, ARG, export or Environment= line, before a `#`
# that opens a word (a comment), not one inside a value.
pname="((-e|--env)[[:space:]=]+)?${Q}?[A-Z0-9_]*${ENV}="
pair="(^|[[:space:]])${pname}${pvalue}"
pairline="^[[:space:]]*(export|ENV|ARG|Environment=)[^[:space:]]*([[:space:]]+[^#[:space:]][^[:space:]]*)*${pair}"
dashpair="(^|[[:space:]])(-e|--env)[[:space:]=]+${Q}?[A-Z0-9_]*${ENV}=${pvalue}"
# A default that is only a switch or an unset sentinel:
# `getenv("REQUIRE_PASSPHRASE", "yes")`, `${TOKEN:-unset}`.
switch="(${Q}|[{][A-Z0-9_]*:?-)(yes|no|true|false|none|null|on|off|unset|not[_-]set|missing)(${Q}|[}])\$"
# Values that hold no secret, matched against the whole value:
# placeholders, alone or as a -/_ word (`gate-dummy`, not
# `myexample-key`), references (`"$X"`, `a${X}`), CI fakes
# (`test_token_for_ci`), masks, and a field's own name
# (`STATIC_TOKEN = "static_token"`).
held="(.*[_-])?(example|placeholder|dummy|fake)([_-].*)?|(change|replace)[_-]?(me|this)([_-].*)?|redacted|x{3,}|(your|test)[_-].*|.*[_-]for[_-]ci|.*<[^>]*>.*|[\$].*|.*([\$][{(]|[{][{]|%[(]).*|.*[*][*][*].*|.*(•)(•).*|.*[.][.][.].*|[a-z]+_[a-z_]*(pass(word|wd|phrase)|secret|token|key)|yes|no|true|false|none|null|on|off"
placeholder="^${Q}?(${held})${Q}?\$"
# In a systemd unit, quadlet or drop-in, a specifier alone or
# leading a path (`%d/x`, `%h/.pgpass`) is a reference too. Anything
# else, and `%d/x` outside a unit, is a literal with a percent sign.
unitholder="^${Q}?(%[aAbBCdEfgGhHiIjJlLmMnNopPqsStTuUvVwWyY](/.*)?|${held})${Q}?\$"
units='[.](service|socket|timer|path|mount|target|container|pod|volume|network|kube|build|image)$|[.](service|socket|timer|path|mount|container|pod|volume|network|kube|build|image)[.]d/[^/]*[.]conf$|(^|/)systemd/.*[.]conf$'
tests='(^|/)(tests?|__tests__|spec|fixtures?|testdata)/|(^|/)test_[^/]*$|_test[.][a-z]+$|[.](test|spec)[.][jt]sx?$|(^|/)conftest[.]py$'
configs='(^|/)([.]env[^/]*|[^/]*[.](env|ya?ml|conf|cfg|ini|properties|container|service|sh|[Cc]ontainerfile|[Dd]ockerfile)|Containerfile[^/]*|Dockerfile[^/]*|docker-compose[^/]*|compose[^/]*)$'
# Prose and sample files describe secrets: a named literal or a
# fallback there warns.
docs='[.](md|markdown|rst|adoc|example|sample)$|(^|/)docs?/'
diff_file=$(mktemp)
cand_file=$(mktemp)
if ! git diff --unified=0 --no-color --no-ext-diff "$BASE" "$TARGET" > "$diff_file"; then
  rm -f "$diff_file" "$cand_file"
  echo "git could not diff $BASE and $TARGET; nothing was scanned" >&2
  exit 2
fi
# One pass picks the candidates: the number of every diff line that
# adds a match. Other lines are blanked, not dropped, so the numbers
# stay the diff's. The common case, none, ends here, and the walk
# below spawns nothing for a line that is not a candidate, so a large
# change costs one grep, not a few processes per line. No awk: the
# Gourmand image has none.
# A `+++ ` row is a file header only between `diff --git` and the
# first `@@`; past that it is an added line that began `++ `.
sed -e '/^diff --git /,/^@@ /s/^+++ .*//' -e 's/^+//' -e t -e 's/.*//' "$diff_file" \
  | grep -nE -e "$shapes" -e "$fallback" -e "$assign" -e "$envline" -e "$pairline" -e "$dashpair" \
  | cut -d: -f1 > "$cand_file" || true
if [ ! -s "$cand_file" ]; then
  rm -f "$diff_file" "$cand_file"
  echo "No plaintext secrets in the added lines."
  exit 0
fi
exec 3< "$cand_file"
read -r want <&3 || want=0
file=""
line=0
row_no=0
hdr=0
classed=""
soft=""
conf=""
while IFS= read -r row; do
  row_no=$((row_no + 1))
  case "$row" in
    'diff --git '*) hdr=1; continue ;;
    '@@ '*)
      # `@@ -a,b +c,d @@`: the new side starts at c.
      hdr=0
      start=${row#*+}
      start=${start%% *}
      line=${start%%,*}
      continue ;;
  esac
  if [ "$hdr" -eq 1 ]; then
    case "$row" in
      '+++ b/'*) file=${row#+++ b/} ;;
      '+++ '*) file="" ;;
    esac
    continue
  fi
  case "$row" in '+'*) ;; *) continue ;; esac
  added=${row#+}
  at=$line
  line=$((line + 1))
  [ "$row_no" -eq "$want" ] || continue
  read -r want <&3 || want=0
  [ -n "$file" ] || continue
  case "$added" in *'gatehouse: allow-secret'*) continue ;; esac
  # Classify a file once, at its first candidate line.
  if [ "$file" != "$classed" ]; then
    classed=$file
    soft=""
    if printf '%s\n' "$file" | grep -Eq "$tests"; then
      soft="test"
    elif printf '%s\n' "$file" | grep -Eq "$docs"; then
      soft=doc
    fi
    conf=""
    if printf '%s\n' "$file" | grep -Eq "$configs"; then conf=1; fi
    held_by=$placeholder
    if printf '%s\n' "$file" | grep -Eq "$units"; then held_by=$unitholder; fi
  fi
  verdict=""
  kept=""
  if printf '%s\n' "$added" | grep -Eq -e "$shapes"; then
    verdict=refuse
  elif printf '%s\n' "$added" | grep -oE -e "$fallback" | grep -vEq "$switch"; then
    if [ "$soft" = doc ]; then verdict=warn; else verdict=refuse; fi
  else
    # One segment per line: grep -o output, not its input, carries
    # the newlines, so the greps run in one group.
    named=$(
      printf '%s\n' "$added" | grep -oE -e "$assign" || true
      if [ -n "$conf" ]; then
        printf '%s\n' "$added" | grep -oE -e "$envline" || true
        if printf '%s\n' "$added" | grep -Eq -e "$pairline"; then
          printf '%s\n' "$added" | sed -E 's/(^|[[:space:]])#.*//' | grep -oE -e "$pair" || true
        else
          printf '%s\n' "$added" | grep -oE -e "$dashpair" || true
        fi
      fi
    )
    # Strip each key so the placeholder test reads the value alone.
    values=$(printf '%s\n' "$named" | grep -v '^$' | sed -E -e "s/^${akey}//" -e "s/${ekey}//" -e "s/^[[:space:]]*${pname}//" || true)
    if [ -n "$values" ] && printf '%s\n' "$values" | grep -viEq "$held_by"; then
      # Only a line about to be refused pays for this: drop a value
      # that only repeats its key, any case (`TOKEN = "token"`,
      # `"password": "Password"`).
      # Each kept value goes out as `key value`; neither holds a space.
      kept=$(printf '%s\n' "$named" | grep -v '^$' | while IFS= read -r seg; do
        v=$(printf '%s\n' "$seg" | sed -E -e "s/^${akey}//" -e "s/${ekey}//" -e "s/^[[:space:]]*${pname}//")
        k=$(printf '%s\n' "${seg%"$v"}" | sed -E -e 's/[^A-Za-z0-9_.-]+$//' -e 's/.*[^A-Za-z0-9_.-]//')
        lk=$(printf '%s\n' "$k" | tr '[:upper:]' '[:lower:]')
        [ "$(printf '%s\n' "$v" | tr -d "\"'" | tr '[:upper:]' '[:lower:]')" = "$lk" ] || printf '%s %s\n' "$k" "$v"
      done || true)
      values=$(printf '%s\n' "$kept" | sed -n 's/^[^ ]* //p')
    fi
    if [ -n "$values" ] && printf '%s\n' "$values" | grep -viEq "$held_by"; then
      if [ -n "$soft" ]; then verdict=warn; else verdict=refuse; fi
    fi
  fi
  [ -n "$verdict" ] || continue
  # Strip any prefix first, so the name's group number never moves.
  name=$(printf '%s\n' "$added" | sed -n -E -e "s/^[[:space:]]*(-[[:space:]]+)?${prefix}//" -e 's/^"?([A-Za-z_][A-Za-z0-9_.-]*)"?[[:space:]]*[:=].*/\1/p')
  # A hit in a later pair names the key whose value failed.
  if [ -n "$kept" ] && printf '%s\n' "$added" | grep -Eq -e "$pairline" -e "$dashpair"; then
    name=$(printf '%s\n' "$kept" | while read -r k v; do
      if printf '%s\n' "$v" | grep -viEq "$held_by"; then printf '%s\n' "$k"; break; fi
    done)
  fi
  if [ "$verdict" = refuse ]; then
    echo "::error file=${file},line=${at}::plaintext secret in ${name:-(unnamed value)}"
    hits=$((hits + 1))
  else
    echo "::warning file=${file},line=${at}::literal secret in ${soft} file, ${name:-(unnamed value)}; mark it 'gatehouse: allow-secret' if it is a fixture"
    warns=$((warns + 1))
  fi
done < "$diff_file"
exec 3<&-
rm -f "$diff_file" "$cand_file"
if [ "$hits" -gt 0 ]; then
  echo "Refusing ${hits} plaintext secret(s). Move each to a *_FILE path or the host's encrypted store; mark a test fixture line 'gatehouse: allow-secret'."
  exit 1
fi
if [ "$warns" -gt 0 ]; then
  echo "${warns} literal secret(s) in test or doc files, warned only."
fi
echo "No plaintext secrets in the added lines."
