#!/bin/sh
# The host half of the CrunchTools Python SDLC gate.
#
# POSIX shell on purpose. Constitution XII's host contract says a developer
# machine has git, podman, pre-commit and gh and NOTHING else may be assumed --
# so this cannot be Python, even though the image it starts is full of it. The
# only two programs this file runs are `git` and `podman`.
#
# What lives here rather than in the image:
#   - anything needing the developer's git identity, credentials or network
#     (fetching origin, computing the branch diff)
#   - `hooks-installed`, which is a question about this clone's .git
#   - the resource budget, because a pre-commit `entry:` is a static string and
#     cannot read one
#
# Everything else is one `podman run` into quay.io/crunchtools/python-sdlc.
#
# EXIT CODES, and they are the contract:
#   0  ran, found nothing
#   1  ran, found something
#   2  COULD NOT RUN -- never to be worked around
#
# Podman's own 125/126/127 mean the container never started, so they map to 2.
# trentina's gates.sh maps them to 1 via `|| fail`, which reports "found
# something" for "could not invoke". That is the one behaviour here that
# deliberately differs from the script this replaces.

set -eu

ME=$(basename "$0")
HOOKS_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)

die()  { printf '%s: GATE CANNOT RUN: %s\n' "$ME" "$*" >&2; exit 2; }
fail() { printf '%s: GATE FAILED: %s\n'     "$ME" "$*" >&2; exit 1; }
step() { printf '\n== %s\n' "$*"; }

# ------------------------------------------------------------------ the image

[ -f "$HOOKS_DIR/IMAGE_TAG" ] || die "$HOOKS_DIR/IMAGE_TAG is missing"
IMAGE_TAG=$(tr -d ' \t\n\r' < "$HOOKS_DIR/IMAGE_TAG")
[ -n "$IMAGE_TAG" ] || die "IMAGE_TAG is empty"
# Read from the cloned hooks repo, so the `rev:` a repo pins fixes the launcher
# and the image together and they cannot disagree. Overridable for development
# of this repo itself, not for consumers.
IMAGE=${SDLC_IMAGE:-quay.io/crunchtools/python-sdlc:$IMAGE_TAG}

# --------------------------------------------------------------- preconditions

command -v podman >/dev/null 2>&1 || die "podman is not on PATH"
command -v git    >/dev/null 2>&1 || die "git is not on PATH"

# A hook entry that calls a tier would re-enter this script forever.
[ "${SDLC_DEPTH:-0}" -eq 0 ] || die "$ME re-entered itself; a hook entry calls a tier"
SDLC_DEPTH=1
export SDLC_DEPTH

# pre-commit chdirs to the consumer's toplevel, but a human or an agent in the
# inner loop will call this from a subdirectory. Ask git rather than guess.
REPO=$(git rev-parse --show-toplevel 2>/dev/null) \
  || die "not inside a git repository"
cd "$REPO"
PROJECT=$(basename "$REPO")

# ---------------------------------------------------------- the resource budget
#
# Ported from gates.sh:55-80. A gate must not take the machine away from the
# person running it, and nproc alone is wrong twice: it ignores a cpuset and it
# ignores a cgroup quota, both of which are how this ends up on a CI runner.

_cpus_in_list() {               # "0-3,7,10-11" -> 7
  printf '%s' "$1" | tr ',' '\n' | awk -F- '
    NF==1 && $1!="" { n += 1 }
    NF==2           { n += ($2 - $1) + 1 }
    END { print (n ? n : 0) }'
}

_cgroup_cpu_ceiling() {         # cpu.max from leaf to root, smallest quota wins
  _dir=$(awk -F: '$2=="" {print $3; exit}' /proc/self/cgroup 2>/dev/null) || _dir=
  # Inside a container with its own cgroup namespace -- podman's default, and
  # the GitHub runner on gloval -- the path is "/" or climbs with "..". Both
  # mean "the namespace root", which is /sys/fs/cgroup itself, and the root is
  # exactly where a container's quota lives, so it is read, not skipped.
  case "$_dir" in /|*..*) _dir= ;; esac
  _path="/sys/fs/cgroup${_dir%/}"
  _best=0
  # The walk ends AT /sys/fs/cgroup or anywhere outside it, never by hoping
  # dirname lands there exactly. It used to stop only on an exact match, so
  # "/sys/fs/cgroup/" walked to "/" and then dirname'd "/" forever: every
  # command, `--help` included, hung inside a container before printing a
  # line. That was 30 minutes of a CI job doing nothing.
  while :; do
    if [ -r "$_path/cpu.max" ]; then
      _q=$(awk '{print $1}' "$_path/cpu.max" 2>/dev/null) || _q=max
      _p=$(awk '{print $2}' "$_path/cpu.max" 2>/dev/null) || _p=100000
      if [ "$_q" != "max" ] && [ -n "$_p" ] && [ "$_p" -gt 0 ] 2>/dev/null; then
        _n=$(( (_q + _p - 1) / _p ))
        [ "$_n" -lt 1 ] && _n=1
        if [ "$_best" -eq 0 ] || [ "$_n" -lt "$_best" ]; then _best=$_n; fi
      fi
    fi
    case "$_path" in
      /sys/fs/cgroup/*) _path=$(dirname "$_path") ;;
      *) break ;;
    esac
  done
  printf '%s' "$_best"
}

budget() {
  _all=$(nproc 2>/dev/null || printf 1)
  _allowed=$(_cpus_in_list "$(awk -F': *' '/^Cpus_allowed_list/{print $2}' /proc/self/status 2>/dev/null)")
  [ "${_allowed:-0}" -gt 0 ] 2>/dev/null && [ "$_allowed" -lt "$_all" ] && _all=$_allowed
  _ceil=$(_cgroup_cpu_ceiling)
  [ "${_ceil:-0}" -gt 0 ] 2>/dev/null && [ "$_ceil" -lt "$_all" ] && _all=$_ceil
  # Half the machine, floor of one: the desktop is not in the gate's cgroup.
  _half=$(( _all / 2 ))
  [ "$_half" -lt 1 ] && _half=1
  printf '%s' "$_half"
}

GATE_CPUS=${SDLC_CPUS:-$(budget)}
GATE_MEMORY=${SDLC_MEMORY:-8g}

# Validated BEFORE any arithmetic uses them, because `$(( ))` on a non-number
# aborts the script with a shell error rather than our exit 2 (gates.sh:122-134).
case "$GATE_CPUS" in ''|*[!0-9]*) die "SDLC_CPUS must be a whole number" ;; esac
{ [ "$GATE_CPUS" -ge 1 ] && [ "$GATE_CPUS" -le 1024 ]; } \
  || die "SDLC_CPUS must be between 1 and 1024"
case "$GATE_MEMORY" in
  '' | *[!0-9kKmMgG]* | [!0-9]*) die "SDLC_MEMORY must be a size like 8g or 4096m" ;;
esac

CACHE_VOLUME=${SDLC_CACHE_VOLUME:-crunchtools-hook-cache}

need_volume() {
  podman volume exists "$1" 2>/dev/null || podman volume create "$1" >/dev/null \
    || die "cannot create the podman volume $1"
}

# ------------------------------------------------------------------ podman run
#
# `z`, not `Z`: more than one of these can mount the same tree at once, and `Z`
# relabels it exclusively, taking it out from under whichever started first
# (gates.sh:157-161). `--events-backend=none --log-driver=none` keeps a gate out
# of the journal.

run_in_image() {
  _mode=$1; shift          # ro | rw
  _stdin=$1; shift         # stdin | nostdin
  need_volume "$CACHE_VOLUME"

  # The mount convention is Gourmand's and Gatehouse's, unchanged:
  #   -v <repo>:/repo:<mode>,Z -w /repo
  # and the container runs as its own root. Rootless podman maps that to the
  # invoking user, so a file ruff writes is the developer's and the cache volume
  # is writable, with no --user and no --userns=keep-id. Two bugs came from
  # trying to be cleverer than this.
  #
  # ONE deliberate difference: `z`, not `Z`. A tier runs several of these and
  # `Z` relabels the tree EXCLUSIVELY, taking it out from under whichever
  # container started first (gates.sh:157-161). Those two run one at a time and
  # never hit it.
  set -- \
    --events-backend=none run --rm --log-driver=none \
    --cpus "$GATE_CPUS" --memory "$GATE_MEMORY" --cpu-shares 256 \
    -v "$REPO:/repo:$_mode,z" -w /repo \
    -v "$CACHE_VOLUME:/cache" \
    --tmpfs /tmp:rw,exec,size=4g,mode=1777 \
    -e HOME=/tmp \
    -e SEMGREP_SETTINGS_FILE=/tmp/semgrep.yml \
    -e "SDLC_PROJECT=$PROJECT" \
    -e "SDLC_JOBS=$GATE_CPUS" \
    -e "SDLC_HOST_REPO=$REPO" \
    -e "SDLC_CACHE_VOLUME=$CACHE_VOLUME" \
    ${SDLC_SKIP:+-e SDLC_SKIP} \
    ${SDLC_GATEHOUSE_SAMPLES:+-e SDLC_GATEHOUSE_SAMPLES} \
    "$@"

  # Reset HERE, not inherited. A shell function's variables are global, so a
  # caller's earlier `|| _rc=$?` -- t_gatehouse's `git diff --quiet`, which is 1
  # whenever there IS a diff -- survived into this function, and a container
  # that succeeded reported the caller's 1 as its own failure.
  _rc=0
  if [ "$_stdin" = stdin ]; then
    podman "$@" || _rc=$?
  else
    podman "$@" </dev/null || _rc=$?
  fi
  # 125 podman itself failed, 126 not executable, 127 not found. The container
  # never ran, so this is not a finding.
  case "$_rc" in
    125|126|127) die "podman could not run $IMAGE (exit $_rc); nothing was checked" ;;
  esac
  return "$_rc"
}

# --------------------------------------------------------------- host-only work

t_hooks_installed() {
  # Asked of git, not assembled: in a linked worktree `.git` is a file, and
  # core.hooksPath moves the directory somewhere else entirely (gates.sh:178-188).
  _hook=$(git config --get core.hooksPath 2>/dev/null) && _hook="$_hook/pre-push" \
    || _hook=$(git rev-parse --git-path hooks/pre-push) \
    || die "cannot ask git where its hooks live"
  [ -f "$_hook" ] || fail "$_hook is missing -- run: pre-commit install --install-hooks"
  grep -q "pre-commit" "$_hook" 2>/dev/null \
    || fail "$_hook is not pre-commit's -- run: pre-commit install"
  printf 'pre-push hook is installed\n'
}

default_branch() {
  # gates.sh hard-codes origin/main. 10 of the 69 checkouts in this fleet
  # default to master, so ask the remote instead of assuming.
  _ref=$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null) \
    && { printf '%s' "${_ref#refs/remotes/}"; return; }
  for _c in origin/main origin/master; do
    git rev-parse --verify --quiet "$_c" >/dev/null 2>&1 && { printf '%s' "$_c"; return; }
  done
  die "cannot determine the default branch; no origin/HEAD, origin/main or origin/master"
}

t_gatehouse() {
  _env=${GATEHOUSE_ENV:-$HOME/.config/mcp-env/gatehouse.env}
  [ -f "$_env" ] || die "$_env is missing; Gatehouse has no API key"

  _base=$(default_branch)
  git fetch --quiet origin "${_base#origin/}" \
    || die "cannot reach origin to read ${_base#origin/}; the branch diff is unknown"

  # 0 is no differences, 1 is differences, anything above is git failing -- which
  # is a gate that could not run, not a gate that found something.
  _rc=0
  git diff --quiet "$_base...HEAD" || _rc=$?
  case "$_rc" in
    0) printf 'nothing to review: HEAD matches %s\n' "$_base"; return 0 ;;
    1) ;;
    *) die "git could not compute $_base...HEAD" ;;
  esac

  step "gatehouse over $_base...HEAD"
  # The diff goes in on stdin so the container needs no git credentials and no
  # network to origin.
  git diff "$_base...HEAD" | run_in_image ro stdin \
    --env-file "$_env" -i "$IMAGE" gatehouse
}

# --------------------------------------------------------------------- the plan
#
# Which checks run is decided by the repo's [tool.sdlc.commit], [tool.sdlc.push]
# and [tool.sdlc.ci] blocks, and this shell cannot read TOML. So it asks the
# image for a plan -- one line per step, `check TAB mode TAB payload` -- and
# carries it out. The modes:
#
#   image-ro | image-rw   `sdlc <payload>` in the image, the tree ro or rw
#   local                 a check this file answers itself
#   host                  a podman argv, words joined by the unit separator
#
# A host line that does not start with `podman build` or `podman run` is
# refused: the host contract is held here, by the launcher, not trusted to
# anything a repo's config says. The argv is SPLIT on the separator, never
# `eval`ed, so nothing in it is ever read as shell -- no expansion, no command
# substitution -- before or after that check.

TAB=$(printf '\t')
US=$(printf '\037')

run_host() {
  _ifs=$IFS
  IFS=$US
  # shellcheck disable=SC2086  # splitting on the separator is the point
  set -- $1
  IFS=$_ifs
  [ "${1:-}" = podman ] || die "a host step may only run podman; refused: ${1:-<empty>}"
  _sub=${2:-}
  shift 2
  # The budget is applied here so it is defined once, whatever the step.
  case "$_sub" in
    build) set -- build --cpu-period 100000 --cpu-quota "$(( GATE_CPUS * 100000 ))" \
                        --memory "$GATE_MEMORY" "$@" ;;
    run)   set -- --events-backend=none run --log-driver=none \
                        --cpus "$GATE_CPUS" --memory "$GATE_MEMORY" --cpu-shares 256 "$@" ;;
    *)     die "a host step may only build or run; refused: podman $_sub" ;;
  esac
  _rc=0
  podman "$@" </dev/null || _rc=$?
  # A failed build is a finding: the code does not produce an image. A run
  # that podman could not start (125-127) never ran, so it is a 2, and so is a
  # pytest status above 1 (interrupted, usage error, internal error, no tests).
  case "$_sub:$_rc" in
    *:0) return 0 ;;
    build:*) return 1 ;;
    run:1) return 1 ;;
    *) printf '%s: podman %s exited %s; nothing was judged\n' "$ME" "$_sub" "$_rc" >&2; return 2 ;;
  esac
}

run_step() {           # mode payload -> the step's exit status
  case "$1" in
    image-ro) run_in_image ro nostdin "$IMAGE" "$2" ;;
    image-rw) run_in_image rw nostdin "$IMAGE" "$2" ;;
    local)
      case "$2" in
        hooks-installed) ( t_hooks_installed ) ;;
        gatehouse)       ( t_gatehouse ) ;;
        *) die "the image asked for an unknown local check: $2" ;;
      esac ;;
    host) run_host "$2" ;;
    *) die "the image asked for an unknown step mode: $1" ;;
  esac
}

run_plan() {           # commit | push | ci | <check>
  _plan=$(run_in_image ro nostdin "$IMAGE" plan "$1") \
    || die "the image could not plan '$1'; nothing was checked"
  [ -n "$_plan" ] || die "the image planned nothing for '$1'"

  _worst=0
  _failed=
  _ifs=$IFS
  set -f
  IFS='
'
  for _line in $_plan; do
    IFS=$_ifs
    _check=${_line%%"$TAB"*}
    _rest=${_line#*"$TAB"}
    _mode=${_rest%%"$TAB"*}
    _payload=${_rest#*"$TAB"}
    # One failed step ends that check; the next check still runs.
    case " $_failed " in *" $_check "*) continue ;; esac
    _rc=0
    run_step "$_mode" "$_payload" || _rc=$?
    if [ "$_rc" -ne 0 ]; then
      _failed="$_failed $_check"
      printf '\n%s: %s %s\n' "$ME" "$_check" \
        "$([ "$_rc" -eq 2 ] && echo 'COULD NOT RUN' || echo 'FAILED')" >&2
      # A later 1 must not mask an earlier 2.
      if [ "$_rc" -eq 2 ] || [ "$_worst" -eq 2 ]; then _worst=2; else _worst=1; fi
    fi
  done
  IFS=$_ifs
  set +f
  return "$_worst"
}

# ---------------------------------------------------------------------- dispatch

case "${1:---help}" in
  -h|--help|help)
    cat <<EOF
usage: $ME commit | push | ci | <check> | tiers | list | versions | codeql-baseline

  commit            the pre-commit hook: seconds, offline, free
  push              the pre-push hook: every verdict, no container builds
  ci                what CI runs: push's checks except the two reviewers,
                    plus the repo's own
  <check>           one check by name -- the inner loop
  tiers             what each command runs in this repo
  list              the built-in checks and the kinds
  versions          the exact tool versions the image carries
  codeql-baseline   accept every current CodeQL finding into the baseline

Configure each command in pyproject.toml: [tool.sdlc.commit],
[tool.sdlc.push], [tool.sdlc.ci]. Skip one check once: SDLC_SKIP=name.
Exit 2 means a check COULD NOT RUN and is never to be worked around.
Image: $IMAGE
EOF
    ;;
  tiers|list|versions) run_in_image ro nostdin "$IMAGE" "$1" ;;
  codeql-baseline)     run_in_image rw nostdin "$IMAGE" "$1" ;;
  *)                   SDLC_DEPTH=0 run_plan "$1" ;;
esac
