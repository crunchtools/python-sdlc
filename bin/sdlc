#!/bin/sh
# The host half of the CrunchTools Python SDLC gate.
#
# POSIX shell on purpose. Constitution XII's host contract says a developer
# machine has git, podman, pre-commit and gh and NOTHING else may be assumed --
# so this cannot be Python, even though the image it starts is full of it. The
# only two programs this file runs are `git` and `podman`.
#
# What lives here rather than in the image:
#   - anything needing the developer's git identity, credentials or network
#     (fetching origin, computing the branch diff)
#   - `hooks-installed`, which is a question about this clone's .git
#   - the resource budget, because a pre-commit `entry:` is a static string and
#     cannot read one
#
# Everything else is one `podman run` into quay.io/crunchtools/sdlc.
#
# EXIT CODES, and they are the contract:
#   0  ran, found nothing
#   1  ran, found something
#   2  COULD NOT RUN -- never to be worked around
#   3  COULD NOT RUN, deferred to CI -- push only, granted by the image when
#      CodeQL itself broke and `sdlc ci` will judge the same commit. Printed
#      loudly, recorded, and not a refusal (#33). Anywhere but a
#      push it is a 2.
#
# Podman's own 125/126/127 mean the container never started, so they map to 2.
# trentina's gates.sh maps them to 1 via `|| fail`, which reports "found
# something" for "could not invoke". That is the one behaviour here that
# deliberately differs from the script this replaces.

set -eu
# No pathname expansion, anywhere. Words split from a plan line are a repo's
# argv, and `/home/*/.ssh/*` unquoted would be expanded against THIS machine's
# filesystem before podman saw it. The one glob this file wants turns it back on
# for itself (state_init).
set -f

ME=$(basename "$0")

# The image this file came from, when it came from one. `sdlc launcher <ref>`,
# run inside quay.io/crunchtools/sdlc, prints this file with the ref written on
# the next line; that is how a repo with no `rev:` gets its launcher
# (bin/sdlc-bootstrap). Empty in a clone of this repo, which pins by IMAGE_TAG.
LAUNCHED_FROM=

die()  { printf '%s: GATE CANNOT RUN: %s\n' "$ME" "$*" >&2; exit 2; }
fail() { printf '%s: GATE FAILED: %s\n'     "$ME" "$*" >&2; exit 1; }
step() { printf '\n== %s\n' "$*"; }

# ------------------------------------------------------------------ the image

# The fleet image: releases at their version tags, `:latest` the newest of
# them, and `:main`, which is what has merged to main and not yet been released.
FLEET_IMAGE=quay.io/crunchtools/sdlc
if [ -n "$LAUNCHED_FROM" ]; then
  # Floating: the launcher and the image are one artifact, so the image that
  # printed this file is the one it runs. The release it floats on is :latest.
  DEFAULT_IMAGE=$LAUNCHED_FROM
  RELEASE_IMAGE=$FLEET_IMAGE:latest
else
  HOOKS_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
  [ -f "$HOOKS_DIR/IMAGE_TAG" ] || die "$HOOKS_DIR/IMAGE_TAG is missing"
  IMAGE_TAG=$(tr -d ' \t\n\r' < "$HOOKS_DIR/IMAGE_TAG")
  [ -n "$IMAGE_TAG" ] || die "IMAGE_TAG is empty"
  # Read from the cloned hooks repo, so the `rev:` a repo pins fixes the
  # launcher and the image together and they cannot disagree. An override --
  # below, once the repo is known -- replaces it for the inner loop, and says
  # so every run.
  DEFAULT_IMAGE=$FLEET_IMAGE:$IMAGE_TAG
  RELEASE_IMAGE=$DEFAULT_IMAGE
fi

# --------------------------------------------------------------- preconditions

command -v podman >/dev/null 2>&1 || die "podman is not on PATH"
command -v git    >/dev/null 2>&1 || die "git is not on PATH"

# A hook entry that calls a tier would re-enter this script forever.
[ "${SDLC_DEPTH:-0}" -eq 0 ] || die "$ME re-entered itself; a hook entry calls a tier"
SDLC_DEPTH=1
export SDLC_DEPTH

# pre-commit chdirs to the consumer's toplevel, but a human or an agent in the
# inner loop will call this from a subdirectory. Ask git rather than guess.
REPO=$(git rev-parse --show-toplevel 2>/dev/null) \
  || die "not inside a git repository"
cd "$REPO"
PROJECT=$(basename "$REPO")
# Where the repo is on the machine podman runs on. The same path on a laptop;
# in a CI job container driving the runner's socket, `sdlc event` sets it to the
# host path of the workspace, because a nested container mounts host paths.
HOST_REPO=${SDLC_HOST_REPO:-$REPO}

# ------------------------------------------------------------- an image override
#
# The inner loop: run what has merged to main before a release carries it,
# `:main`, or a seat's own local build. Two ways in, the first winning:
#
#   SDLC_IMAGE=<ref> | <tag>     this seat, this run. A bare tag is a tag of
#                                quay.io/crunchtools/sdlc: main, or a release.
#   [tool.sdlc] image = "<tag>"  the repo, on a seat. The same bare tags and
#                                nothing else, and REFUSED in CI and by `sdlc
#                                ci`: a pull request must not choose the image
#                                that judges it. The planner cannot enforce
#                                that, because it runs inside the chosen image.
#
# The image is the judge, so a run that is not on the pinned release says so on
# every invocation, loudly. And a floating tag is pulled when newer: `missing`,
# podman's default, is how a two-week-old reviewer once judged trentina.
CONFIG_FILE=pyproject.toml
[ -f "$CONFIG_FILE" ] || CONFIG_FILE=sdlc.toml
config_image() {       # the `image` key of [tool.sdlc], or nothing
  [ -f "$CONFIG_FILE" ] || return 0
  awk '
    /^[ \t]*\[/ { s = ($0 ~ /^[ \t]*\[tool\.sdlc\][ \t]*(#.*)?$/); next }
    s && /^[ \t]*image[ \t]*=/ {
      v = $0; sub(/^[^=]*=[ \t]*/, "", v)
      if (v ~ /^"[^"]*"/) { sub(/^"/, "", v); sub(/".*$/, "", v) }
      print v; exit
    }' "$CONFIG_FILE"
}
fleet_tag() {          # value where -> the image that tag names, or die
  case "$1" in
    ''|*[!A-Za-z0-9._-]*|[.-]*) die "$2 must be a tag such as main or 0.8.0; got '$1'" ;;
  esac
  printf '%s:%s' "$FLEET_IMAGE" "$1"
}
SDLC_CONFIG_IMAGE=$(config_image)
export SDLC_CONFIG_IMAGE
if [ -n "$SDLC_CONFIG_IMAGE" ]; then
  if [ -n "${CI:-}" ] || [ -n "${GITHUB_ACTIONS:-}" ] || [ "${1:-}" = ci ]; then
    die "[tool.sdlc] image is for a developer's machine. CI and 'sdlc ci' run the pinned release, so a pull request cannot choose the image that judges it. Remove it from $CONFIG_FILE"
  fi
fi
IMAGE=$DEFAULT_IMAGE
IMAGE_FROM=
[ -z "$LAUNCHED_FROM" ] || IMAGE_FROM="the image that printed this launcher"
if [ -n "${SDLC_IMAGE:-}" ]; then
  case "$SDLC_IMAGE" in
    */*) IMAGE=$SDLC_IMAGE ;;
    *)   IMAGE=$(fleet_tag "$SDLC_IMAGE" SDLC_IMAGE) ;;
  esac
  IMAGE_FROM=SDLC_IMAGE
elif [ -n "$SDLC_CONFIG_IMAGE" ]; then
  IMAGE=$(fleet_tag "$SDLC_CONFIG_IMAGE" "[tool.sdlc] image in $CONFIG_FILE")
  IMAGE_FROM="[tool.sdlc] image in $CONFIG_FILE"
fi
PULL_NEWER=
if [ "$IMAGE" != "$DEFAULT_IMAGE" ]; then
  case "$IMAGE" in localhost/*) ;; *) PULL_NEWER=yes ;; esac
fi
# The bootstrap runs the image by the digest whose signature it verified, so
# what it was asked for is a name it resolved: SDLC_VERIFIED_FROM. The banner
# asks about that name, or every run on :latest would call itself unpinned.
ASKED=$IMAGE
if [ -n "$LAUNCHED_FROM" ] && [ "$IMAGE" = "$LAUNCHED_FROM" ] \
   && [ -n "${SDLC_VERIFIED_FROM:-}" ]; then
  ASKED=$SDLC_VERIFIED_FROM
fi
if [ "$ASKED" != "$RELEASE_IMAGE" ]; then
  {
    printf '%s: ************************************************************\n' "$ME"
    printf '%s: NOT THE PINNED RELEASE. This run is judged by\n' "$ME"
    printf '%s:   %s\n' "$ME" "$ASKED"
    [ "$ASKED" = "$IMAGE" ] || printf '%s:   verified as %s\n' "$ME" "$IMAGE"
    printf '%s: set by %s, in place of\n' "$ME" "$IMAGE_FROM"
    printf '%s:   %s\n' "$ME" "$RELEASE_IMAGE"
    printf '%s: ************************************************************\n' "$ME"
  } >&2
fi

# ---------------------------------------------------------- the resource budget
#
# Ported from gates.sh:55-80. A gate must not take the machine away from the
# person running it, and nproc alone is wrong twice: it ignores a cpuset and it
# ignores a cgroup quota, both of which are how this ends up on a CI runner.

_cpus_in_list() {               # "0-3,7,10-11" -> 7
  printf '%s' "$1" | tr ',' '\n' | awk -F- '
    NF==1 && $1!="" { n += 1 }
    NF==2           { n += ($2 - $1) + 1 }
    END { print (n ? n : 0) }'
}

_cgroup_cpu_ceiling() {         # cpu.max from leaf to root, smallest quota wins
  _dir=$(awk -F: '$2=="" {print $3; exit}' /proc/self/cgroup 2>/dev/null) || _dir=
  # Inside a container with its own cgroup namespace -- podman's default, and
  # the GitHub runner on gloval -- the path is "/" or climbs with "..". Both
  # mean "the namespace root", which is /sys/fs/cgroup itself, and the root is
  # exactly where a container's quota lives, so it is read, not skipped.
  # A ".." COMPONENT, not any two dots: `job..scope` is a legal cgroup name.
  case "$_dir" in /|/..|/../*|*/../*|*/..) _dir= ;; esac
  _path="/sys/fs/cgroup${_dir%/}"
  _best=0
  # The walk ends AT /sys/fs/cgroup or anywhere outside it, never by hoping
  # dirname lands there exactly. It used to stop only on an exact match, so
  # "/sys/fs/cgroup/" walked to "/" and then dirname'd "/" forever: every
  # command, `--help` included, hung inside a container before printing a
  # line. That was 30 minutes of a CI job doing nothing.
  while :; do
    if [ -r "$_path/cpu.max" ]; then
      _q=$(awk '{print $1}' "$_path/cpu.max" 2>/dev/null) || _q=max
      _p=$(awk '{print $2}' "$_path/cpu.max" 2>/dev/null) || _p=100000
      if [ "$_q" != "max" ] && [ -n "$_p" ] && [ "$_p" -gt 0 ] 2>/dev/null; then
        _n=$(( (_q + _p - 1) / _p ))
        [ "$_n" -lt 1 ] && _n=1
        if [ "$_best" -eq 0 ] || [ "$_n" -lt "$_best" ]; then _best=$_n; fi
      fi
    fi
    case "$_path" in
      /sys/fs/cgroup/*) _path=$(dirname "$_path") ;;
      *) break ;;
    esac
  done
  printf '%s' "$_best"
}

budget() {
  # The INSTALLED count, which no cpuset or quota changes -- `nproc` alone is
  # already narrowed by our affinity, so comparing the allowance against it can
  # never detect a cpuset. That was the first version of this and it silently
  # found nothing.
  _machine=$(nproc --all 2>/dev/null || getconf _NPROCESSORS_CONF 2>/dev/null \
             || nproc 2>/dev/null || printf 1)
  _all=$(nproc 2>/dev/null || printf 1)
  _allowed=$(_cpus_in_list "$(awk -F': *' '/^Cpus_allowed_list/{print $2}' /proc/self/status 2>/dev/null)")
  [ "${_allowed:-0}" -gt 0 ] 2>/dev/null && [ "$_allowed" -lt "$_all" ] && _all=$_allowed
  _ceil=$(_cgroup_cpu_ceiling)
  [ "${_ceil:-0}" -gt 0 ] 2>/dev/null && [ "$_ceil" -lt "$_all" ] && _all=$_ceil

  # Has something already decided this process's share? One comparison catches
  # a cpuset, a CPU affinity and a cgroup quota alike.
  _capped=no
  [ "${_machine:-0}" -gt 0 ] 2>/dev/null && [ "$_all" -lt "$_machine" ] && _capped=yes

  # Halving is there to keep a gate from taking the machine away from the person
  # running it -- the desktop is not in the gate's cgroup. Two cases have no
  # such person, and halving them is just throwing away half a machine:
  #
  #   - CI. A runner is dedicated to the job; there is no desktop to protect.
  #   - A cpuset or a cgroup quota narrower than the machine. Something has
  #     ALREADY decided this process's share, and halving that again
  #     double-counts the same protection.
  #
  # This is not a tuning preference, it is what made lanes a regression. On a
  # 4-vCPU GitHub runner the budget was 2, two lanes got 1 each, and trentina's
  # `sdlc ci` went from 15m27s to 24m38s: both lanes are CPU-bound, so each took
  # twice as long, and the image chain alone (1457s) came out longer than the
  # whole sequential job had been (927s). Overlap cannot win from there.
  if [ -n "${CI:-}" ] || [ "$_capped" = yes ]; then
    [ "$_all" -lt 1 ] && _all=1
    printf '%s' "$_all"
    return
  fi
  _half=$(( _all / 2 ))
  [ "$_half" -lt 1 ] && _half=1
  printf '%s' "$_half"
}

# The files are arguments only so the tests can hand it a cgroup tree of their own.
_cgroup_memory_ceiling() {      # [proc-cgroup [cgroup-root]] -> memory.max leaf to root, in MB; 0 for none
  _root=${2:-/sys/fs/cgroup}
  _dir=$(awk -F: '$2=="" {print $3; exit}' "${1:-/proc/self/cgroup}" 2>/dev/null) || _dir=
  # The same namespace-root rule, and the same bounded walk, as the CPU ceiling.
  case "$_dir" in /|/..|/../*|*/../*|*/..) _dir= ;; esac
  _path="$_root${_dir%/}"
  _best=0
  while :; do
    if [ -r "$_path/memory.max" ]; then
      _m=$(cat "$_path/memory.max" 2>/dev/null) || _m=max
      case "$_m" in
        ''|*[!0-9]*) ;;
        *) _m=$(( _m / 1048576 ))
           if [ "$_best" -eq 0 ] || [ "$_m" -lt "$_best" ]; then _best=$_m; fi ;;
      esac
    fi
    case "$_path" in
      "$_root"/*) _path=$(dirname "$_path") ;;
      *) break ;;
    esac
  done
  printf '%s' "$_best"
}

# What the gate's containers can really have between them, in MB.
#
# Not what `--memory` says. Rootless podman drops `--memory` without a word when
# the memory controller is not delegated, and an agent seat -- a container
# running rootless podman inside it -- is exactly that. So every lane was "given"
# 8g on a seat whose cgroup holds 4g for everything, CodeQL sized its heap from
# that 8g, and beside an image build the kernel killed it: exit 137, COULD NOT
# RUN (a989, Exedore Max). The ceiling the kernel enforces is the seat's
# memory.max, so that is what is read, smallest from leaf to root.
#
# A quarter of a cgroup ceiling, never under 512 MB, is left for what else lives
# in it: on a seat that is the agent driving this run. MemTotal is taken as it
# is -- the kernel's own reservation is already off it, and a dedicated runner
# has nothing else to keep.
memory_available() {   # [meminfo [proc-cgroup [cgroup-root]]] -> MB
  _total=$(awk '/^MemTotal:/ {print int($2 / 1024); exit}' "${1:-/proc/meminfo}" 2>/dev/null) || _total=
  case "$_total" in ''|*[!0-9]*) _total=0 ;; esac
  _cg=$(_cgroup_memory_ceiling "${2:-}" "${3:-}")
  if [ "${_cg:-0}" -gt 0 ] 2>/dev/null && { [ "$_total" -eq 0 ] || [ "$_cg" -lt "$_total" ]; }; then
    _keep=$(( _cg / 4 ))
    [ "$_keep" -lt 512 ] && _keep=512
    _total=$(( _cg - _keep ))
    [ "$_total" -lt 1 ] && _total=1
  fi
  printf '%s' "$_total"
}

_size_mb() {                    # 8g | 4096m | 4194304k | bytes -> MB
  _v=${1%[kKmMgG]}
  # In base 10: `$(( ))` reads a leading 0 as octal, so 010g was 8g and 08g
  # aborted the script. podman reads them as 10g and 8g.
  while [ "${_v#0}" != "$_v" ] && [ -n "${_v#0}" ]; do _v=${_v#0}; done
  case "$1" in
    *[gG]) printf '%s' $(( _v * 1024 )) ;;
    *[mM]) printf '%s' "$_v" ;;
    *[kK]) printf '%s' $(( _v / 1024 )) ;;
    *)     printf '%s' $(( _v / 1048576 )) ;;
  esac
}

GATE_CPUS=${SDLC_CPUS:-$(budget)}
GATE_MEMORY=${SDLC_MEMORY:-8g}
MEM_AVAILABLE=$(memory_available)

# Validated BEFORE any arithmetic uses them, because `$(( ))` on a non-number
# aborts the script with a shell error rather than our exit 2 (gates.sh:122-134).
case "$GATE_CPUS" in ''|*[!0-9]*) die "SDLC_CPUS must be a whole number" ;; esac
{ [ "$GATE_CPUS" -ge 1 ] && [ "$GATE_CPUS" -le 1024 ]; } \
  || die "SDLC_CPUS must be between 1 and 1024"
case "$GATE_MEMORY" in
  # A unit only at the end: `8g8m` is not a size, and is now also arithmetic.
  '' | *[!0-9kKmMgG]* | [!0-9]* | *[kKmMgG]?*)
    die "SDLC_MEMORY must be a size like 8g or 4096m" ;;
esac
GATE_MEMORY_MB=$(_size_mb "$GATE_MEMORY")
# The default is only a default: on a machine with less, it is what there is.
# A budget someone SET is theirs, and is left alone.
if [ -z "${SDLC_MEMORY:-}" ] && [ "${MEM_AVAILABLE:-0}" -gt 0 ] \
   && [ "$MEM_AVAILABLE" -lt "$GATE_MEMORY_MB" ]; then
  GATE_MEMORY_MB=$MEM_AVAILABLE
  GATE_MEMORY=${MEM_AVAILABLE}m
fi

# On an AppArmor host, no-new-privileges makes AppArmor STACK the container
# profile onto crun's own (Ubuntu 26.04 ships `crun` as an unconfined-flag
# profile): the container runs as `containers-default-<v>//&crun`, which the
# default profile does not name as a signal peer, so a process cannot signal
# its own child (EPERM; systemd as PID 1 never leaves `initializing`). Without
# no-new-privileges the profile is applied, not stacked, and enforced. So where
# podman reports AppArmor the gate containers drop no-new-privileges and keep
# AppArmor. With cap-drop=all a setuid exec gains no capability; in the systemd
# container one can regain SYSTEMD_CAPS, still inside the enforced profile.
# Elsewhere (SELinux) no-new-privileges is always passed. crunchtools/sdlc#181.
NNP=--security-opt=no-new-privileges
[ "$(podman info --format '{{.Host.Security.AppArmorEnabled}}' 2>/dev/null)" = true ] \
  && NNP=

CACHE_VOLUME=${SDLC_CACHE_VOLUME:-crunchtools-hook-cache}

need_volume() {
  [ -n "$1" ] || return 0   # `sarif` runs without the cache volume
  podman volume exists "$1" 2>/dev/null && return 0
  podman volume create "$1" >/dev/null 2>&1 && return 0
  # Two lanes reach this at the same moment on a cold machine and one of them
  # loses the create. Losing that race is not a failure; not having the volume
  # afterwards is.
  podman volume exists "$1" 2>/dev/null || die "cannot create the podman volume $1"
}

# ------------------------------------------------------------------ podman run
#
# `z`, not `Z`: more than one of these can mount the same tree at once, and `Z`
# relabels it exclusively, taking it out from under whichever started first
# (gates.sh:157-161). `--events-backend=none --log-driver=none` keeps a gate out
# of the journal.

run_in_image() {
  _mode=$1; shift          # ro | rw
  _stdin=$1; shift         # stdin | nostdin
  need_volume "$CACHE_VOLUME"

  # The mount convention is Gourmand's and Gatehouse's, unchanged:
  #   -v <repo>:/repo:<mode>,Z -w /repo
  # and the container runs as its own root. Rootless podman maps that to the
  # invoking user, so a file ruff writes is the developer's and the cache volume
  # is writable, with no --user and no --userns=keep-id. Two bugs came from
  # trying to be cleverer than this.
  #
  # No capabilities, and no way to acquire one. A gate runs a repo's own code --
  # conftest, mypy plugins, semgrep rules, a Containerfile's RUN lines -- so the
  # container it runs in is a boundary, not a convenience. `kind_pytest_in_image`
  # has locked its container down this way since it was written; the gate's own
  # containers never did. Nothing here needs a capability: the tools read the
  # tree, write the cache volume and talk to the network, and rootless podman
  # maps the container's root to the invoking user, so file access is the
  # developer's own either way.
  #
  # PYTHONPYCACHEPREFIX is what keeps the shared tree from deciding a verdict.
  # /repo is the developer's worktree, so its `__pycache__` is the laptop's, and
  # bytecode carries the path it was compiled from. pytest's assertion rewriter
  # reads its cached code back as marshalled and cannot fix that path -- the
  # whole point of its cache is the REWRITTEN code -- so a module compiled on
  # the host keeps `/home/<user>/.../x.py` while `__file__` is `/repo/.../x.py`,
  # and any test comparing the two fails here and nowhere else. That was four of
  # the five pushes on trentina#706. /tmp is the tmpfs below, so with the prefix
  # set the container neither reads the tree's bytecode nor writes any back into
  # it -- which matters at commit, where the mount is read-write.
  #
  # ONE deliberate difference: `z`, not `Z`. A tier runs several of these and
  # `Z` relabels the tree EXCLUSIVELY, taking it out from under whichever
  # container started first (gates.sh:157-161). Those two run one at a time and
  # never hit it.
  #
  # The GIT_CONFIG_* trio marks /repo, and only /repo, safe: on a CI runner the checkout belongs
  # to the runner's user, not the container's, and git refuses a repository it
  # does not own (exit 128), as a repo command's env does in sdlc's own runner.
  set -- \
    --events-backend=none run --rm --log-driver=none \
    ${PULL_NEWER:+--pull=newer} \
    --cap-drop=all ${NNP:+"$NNP"} \
    --cpus "$GATE_CPUS" --memory "$GATE_MEMORY" --cpu-shares 256 \
    -v "$HOST_REPO:/repo:$_mode,z" -w /repo \
    ${CACHE_VOLUME:+-v "$CACHE_VOLUME:/cache"} \
    --tmpfs /tmp:rw,exec,size=4g,mode=1777 \
    -e HOME=/tmp \
    -e PYTHONPYCACHEPREFIX=/tmp/pycache \
    -e GIT_CONFIG_COUNT=1 -e GIT_CONFIG_KEY_0=safe.directory -e GIT_CONFIG_VALUE_0=/repo \
    -e SEMGREP_SETTINGS_FILE=/tmp/semgrep.yml \
    -e "SDLC_PROJECT=$PROJECT" \
    ${SDLC_CONFIG_IMAGE:+-e SDLC_CONFIG_IMAGE} \
    -e "SDLC_JOBS=$GATE_CPUS" \
    -e "SDLC_MEMORY=$GATE_MEMORY" \
    ${SDLC_HOST_SARIF:+-v "$SDLC_HOST_SARIF:/sarif:rw,z"} \
    ${SDLC_HOST_SARIF:+-e SDLC_SARIF_DIR=/sarif} \
    -e "SDLC_DEFAULT_BRANCH=$(default_branch 2>/dev/null || :)" \
    ${SDLC_TIER:+-e SDLC_TIER} \
    -e "SDLC_HOST_REPO=$HOST_REPO" \
    ${CACHE_VOLUME:+-e "SDLC_CACHE_VOLUME=$CACHE_VOLUME"} \
    ${SDLC_SKIP:+-e SDLC_SKIP} \
    ${SDLC_ARGS:+-e SDLC_ARGS} \
    ${SDLC_DIFF_BASE:+-e SDLC_DIFF_BASE} \
    ${SDLC_GATEHOUSE_SAMPLES:+-e SDLC_GATEHOUSE_SAMPLES} \
    "$@"

  # Reset HERE, not inherited. A shell function's variables are global, so a
  # caller's earlier `|| _rc=$?` -- t_gatehouse's `git diff --quiet`, which is 1
  # whenever there IS a diff -- survived into this function, and a container
  # that succeeded reported the caller's 1 as its own failure.
  _rc=0
  if [ "$_stdin" = stdin ]; then
    podman "$@" || _rc=$?
  else
    podman "$@" </dev/null || _rc=$?
  fi
  # 125 podman itself failed, 126 not executable, 127 not found. The container
  # never ran, so this is not a finding.
  case "$_rc" in
    125|126|127) die "podman could not run $IMAGE (exit $_rc); nothing was checked" ;;
  esac
  return "$_rc"
}

# --------------------------------------------------------------- host-only work

t_hooks_installed() {
  # Asked of git, not assembled: in a linked worktree `.git` is a file, and
  # core.hooksPath moves the directory somewhere else entirely (gates.sh:178-188).
  _hook=$(git config --get core.hooksPath 2>/dev/null) && _hook="$_hook/pre-push" \
    || _hook=$(git rev-parse --git-path hooks/pre-push) \
    || die "cannot ask git where its hooks live"
  [ -f "$_hook" ] || fail "$_hook is missing -- run: pre-commit install --install-hooks"
  grep -q "pre-commit" "$_hook" 2>/dev/null \
    || fail "$_hook is not pre-commit's -- run: pre-commit install"
  printf 'pre-push hook is installed\n'
}

default_branch() {
  # gates.sh hard-codes origin/main. 10 of the 69 checkouts in this fleet
  # default to master, so ask the remote instead of assuming.
  _ref=$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null) \
    && { printf '%s' "${_ref#refs/remotes/}"; return; }
  for _c in origin/main origin/master; do
    git rev-parse --verify --quiet "$_c" >/dev/null 2>&1 && { printf '%s' "$_c"; return; }
  done
  die "cannot determine the default branch; no origin/HEAD, origin/main or origin/master"
}

# Gatehouse sends the diff to an external model (OpenRouter). Some seats push
# Red Hat repos, which must never leave, so in every tier -- push, commit, or
# `sdlc gatehouse` by hand -- the review runs only when the remote is a
# crunchtools repo on GitHub. This is a cooperative client-side guard against
# accidents, not a security boundary: the scp and ssh forms trust the literal
# host `github.com`, which ~/.ssh/config can point anywhere.
#
# The remote is the host's to find, as the diff is: pre-commit exports
# PRE_COMMIT_REMOTE_NAME and PRE_COMMIT_REMOTE_URL to a pre-push hook, and this
# runs on the host, so both are already in the environment -- nothing is
# plumbed into the image. Otherwise: the current branch's upstream remote, then
# `origin`.
gatehouse_remote_url() {
  if [ -n "${PRE_COMMIT_REMOTE_URL:-}" ]; then
    printf '%s' "$PRE_COMMIT_REMOTE_URL"; return
  fi
  _name=${PRE_COMMIT_REMOTE_NAME:-}
  if [ -z "$_name" ]; then
    _br=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) || _br=
    [ -z "$_br" ] || _name=$(git config --get "branch.$_br.remote" 2>/dev/null) || _name=
    # "." is a branch tracking another local branch, which is no remote.
    case "$_name" in ''|.) _name=origin ;; esac
  fi
  git remote get-url --push "$_name" 2>/dev/null \
    || git remote get-url "$_name" 2>/dev/null \
    || :
}

# The URL as shown to a person: userinfo replaced by ***, anything outside
# printable ASCII (a newline, an escape) replaced by ?, so a hostile URL cannot
# forge a second line or leak a token into the log.
strip_url_creds() {
  printf '%s' "$1" | sed -e 's#^\([A-Za-z][A-Za-z0-9+.-]*://\)[^/]*@#\1***@#' \
                         -e 's#^[^/@:]*@\([^/@:]*:\)#\1#' \
    | LC_ALL=C tr -c '!-~' '?'
}

lc() { printf '%s' "$1" | LC_ALL=C tr '[:upper:]' '[:lower:]'; }

# Is this a crunchtools repo on GitHub? Parsed, not globbed: a URL is rejected
# outright if it holds # ? % a backslash or anything but printable ASCII, since
# each one lets a different parser read a different host. Scheme and host are
# lower-cased and compared exactly. The forms, each with an optional .git and
# one trailing slash, owner case-insensitive, repo one [A-Za-z0-9._-] segment:
#   https://github.com/crunchtools/<repo>    ssh://git@github.com/crunchtools/<repo>
#   git@github.com:crunchtools/<repo>
#   http(s)://trentina[.crunchtools.com][:port]/proxy/git/github/crunchtools/<repo>
# https and ssh may carry one user[:pass]@ and a digits-only :port.
is_crunchtools_github() {
  _u=$1
  case "$_u" in ''|*'#'*|*'?'*|*'%'*|*"\\"*) return 1 ;; esac
  # tr deletes the printable characters; any byte left over (space, tab,
  # newline, control) is a reject. Counted, as $(...) would eat a final newline.
  [ "$(printf '%s' "$_u" | LC_ALL=C tr -d '!-~' | wc -c)" -eq 0 ] || return 1
  case "$_u" in
    *://*)
      _scheme=$(lc "${_u%%://*}"); _rest=${_u#*://}
      case "$_rest" in */*) ;; *) return 1 ;; esac
      _auth=${_rest%%/*}; _path=/${_rest#*/}
      # Userinfo is genuine only as the one @ in the authority, which ends at
      # the first /; a second @ is how a URL smuggles a host past a glob.
      case "$_auth" in *@*) case "${_auth%@*}" in *@*) return 1 ;; esac ;; esac
      _hp=${_auth##*@}; _host=$(lc "${_hp%%:*}")
      case "$_hp" in *:*) case "${_hp#*:}" in ''|*[!0-9]*) return 1 ;; esac ;; esac
      case "$_scheme:$_host" in
        https:github.com|ssh:github.com) _p=${_path#/} ;;
        http:trentina|https:trentina|http:trentina.crunchtools.com|https:trentina.crunchtools.com)
          # Only the gateway's own names: any host can serve this path and
          # take the diff.
          case "$_path" in /proxy/git/github/*) _p=${_path#/proxy/git/github/} ;; *) return 1 ;; esac ;;
        *) return 1 ;;
      esac ;;
    git@*:*)
      _hp=${_u#git@}
      [ "$(lc "${_hp%%:*}")" = github.com ] || return 1
      _p=${_hp#*:} ;;
    *) return 1 ;;
  esac
  case "$_p" in */*) ;; *) return 1 ;; esac
  [ "$(lc "${_p%%/*}")" = crunchtools ] || return 1
  _repo=${_p#*/}; _repo=${_repo%/}; _repo=${_repo%.git}
  case "$_repo" in ''|.|..|*[!A-Za-z0-9._-]*) return 1 ;; esac
  return 0
}

# Returns 0 after printing why when Gatehouse must not run. SDLC_GATEHOUSE_ANY_REMOTE=1
# (exactly 1) is the one override, for a deliberate hand run against another
# remote; it is loud, and no hook sets it.
gatehouse_skipped() {
  if [ "${SDLC_GATEHOUSE_ANY_REMOTE:-}" = 1 ]; then
    printf '%s: GATEHOUSE GUARD OVERRIDDEN: SDLC_GATEHOUSE_ANY_REMOTE=1, so the diff goes to an external model whatever the remote\n' "$ME"
    return 1
  fi
  _url=$(gatehouse_remote_url)
  if [ -z "$_url" ]; then
    printf '%s: GATEHOUSE SKIPPED: no remote URL found (no PRE_COMMIT_REMOTE_URL, upstream or origin), so it cannot be shown to be a crunchtools GitHub repo\n' "$ME"
    return 0
  fi
  is_crunchtools_github "$_url" && return 1
  printf '%s: GATEHOUSE SKIPPED: remote %s is not a crunchtools repo on GitHub, and Gatehouse sends the diff to an external model\n' "$ME" "$(strip_url_creds "$_url")"
  return 0
}

t_gatehouse() {
  gatehouse_skipped && return 0
  _env=${GATEHOUSE_ENV:-$HOME/.config/mcp-env/gatehouse.env}
  [ -f "$_env" ] || die "$_env is missing; Gatehouse has no API key"

  _base=$(default_branch)
  git fetch --quiet origin "${_base#origin/}" \
    || die "cannot reach origin to read ${_base#origin/}; the branch diff is unknown"

  # 0 is no differences, 1 is differences, anything above is git failing -- which
  # is a gate that could not run, not a gate that found something.
  _rc=0
  git diff --quiet "$_base...HEAD" || _rc=$?
  case "$_rc" in
    0) printf 'nothing to review: HEAD matches %s\n' "$_base"; return 0 ;;
    1) ;;
    *) die "git could not compute $_base...HEAD" ;;
  esac

  # A key that is a file stays a file (a968): gatehouse.env names it with
  # OPENROUTER_API_KEY_FILE and carries no value, so the file is mounted
  # read-only at the same path and the key never enters the container's
  # environment. Gatehouse reads the variable itself; the file wins over
  # OPENROUTER_API_KEY. Without the variable, nothing here changes.
  _keymount=
  _keyfile=$(sed -n 's/^OPENROUTER_API_KEY_FILE=//p' "$_env" | sed -n '$p')
  if [ -n "$_keyfile" ]; then
    # It becomes a -v argument, whose fields are split on : and ,.
    case "$_keyfile" in
      /*) ;;
      *) die "$_env: OPENROUTER_API_KEY_FILE must be an absolute path" ;;
    esac
    case "$_keyfile" in
      *:*|*,*) die "$_env: OPENROUTER_API_KEY_FILE cannot hold : or , (it is a mount)" ;;
    esac
    [ -f "$_keyfile" ] && [ -r "$_keyfile" ] \
      || die "$_env names OPENROUTER_API_KEY_FILE=$_keyfile, which is not a readable file"
    _keymount="$_keyfile:$_keyfile:ro,z"
  fi

  step "gatehouse over $_base...HEAD"
  # The diff goes in on stdin so the container needs no git credentials and no
  # network to origin. `sdlc-constitution gatehouse` hands a repo on constitution
  # v2 the image's text plus its README section; a v1 repo keeps Gatehouse's own
  # discovery of its manifest.
  git diff "$_base...HEAD" | run_in_image ro stdin \
    --env-file "$_env" ${_keymount:+-v "$_keymount"} -i --entrypoint sdlc-constitution "$IMAGE" gatehouse
}

# ------------------------------------------------------------------- the record
#
# What the last run of each command found, and how long each check took:
#
#   <git-dir>/sdlc/last-<command>.json     check, exit, seconds, log
#   <git-dir>/sdlc/logs-<command>/*.log    what a buffered check printed
#
# The serial path printed no durations at all, so nothing about this gate could
# be tuned by anyone who had not sat watching it. It is also what an agent needs
# after a rejected push: which check, how long, and where its output went,
# without running the whole tier again to find out.
#
# Inside the git directory rather than in a committed `.sdlc/`, because this is
# one machine's last run and belongs to nobody else. `git rev-parse --git-path`
# is asked rather than assembled: in a linked worktree `.git` is a file.
#
# The record is WRITE-ONLY. Nothing in either half of this tool reads it to
# decide anything, and nothing may start: a verdict comes from running the
# check. An input would make a stale or hand-edited file into a way past a gate,
# and the gate is the only thing here worth having.
#
# Failing to write it is never a failure of the gate. Every function below
# degrades to doing nothing.

# Whole seconds. Every duration printed and recorded is measured with this, in
# both the serial and the lane path.
now_s() { date +%s 2>/dev/null || printf 0; }

# ------------------------------------------------------- what a step leaves up
#
# A step that is interrupted -- a cancelled job, ^C, a `die` -- must not leave a
# service running or workflow commands stopped. What it has open is named here,
# and every trap in this file cleans it up first, so a trap set for $OUT or the
# record never has to be swapped out and back for the length of one step.

SD_LIVE=               # the systemd container a host-systemd step has up
CMD_TOKEN=             # the open ::stop-commands:: token, on Actions

on_exit() {            # command -> run however this shell ends, a signal included
  # A signal exits, so that the EXIT trap is the one place cleanup is written
  # and nothing carries on after it. In a lane, which is a background job, INT
  # is ignored and stays so; TERM and HUP still reach it.
  # shellcheck disable=SC2064  # the command is expanded now, on purpose
  trap "step_cleanup; $1" EXIT
  trap 'exit 2' HUP INT TERM
}

step_cleanup() {       # -> nothing left up by the step that was running
  if [ -n "$SD_LIVE" ]; then
    podman rm -f -v -t 10 "$SD_LIVE" >/dev/null 2>&1 || :
    SD_LIVE=
  fi
  commands_resume
}

commands_stop() {      # -> on Actions, workflow commands stopped until resumed
  [ "${GITHUB_ACTIONS:-}" = true ] || return 0
  CMD_TOKEN=$(tr -dc 'a-f0-9' </dev/urandom 2>/dev/null | head -c 32)
  [ -n "$CMD_TOKEN" ] || die "could not make a token to stop workflow commands"
  printf '::stop-commands::%s\n' "$CMD_TOKEN"
}

commands_resume() {    # -> workflow commands back, if they were stopped
  [ -z "$CMD_TOKEN" ] || printf '::%s::\n' "$CMD_TOKEN"
  CMD_TOKEN=
}

unique_name() {        # prefix -> a container name no other step can hold
  # Not $$ and the second: $$ is the same in every lane, since lanes are
  # subshells, and two lanes start a step in the same second. The loser's
  # `rm -f` would remove the winner's container.
  _un=$(tr -dc 'a-f0-9' </dev/urandom 2>/dev/null | head -c 12) || _un=
  printf '%s-%s-%s-%s' "$1" "$$" "${_k:-0}" "${_un:-$(now_s)}"
}

STATE=                 # <git-dir>/sdlc, or empty when there is nowhere to write
LOGS=                  # the log directory for the running command
PART=                  # the per-check lines, rendered to JSON when the run ends
RECORD_FOR=            # the command being recorded

state_init() {         # command
  STATE=$(git rev-parse --git-path sdlc 2>/dev/null) || STATE=
  [ -n "$STATE" ] || return 0
  # `--git-path` answers relative to the current directory, so the paths this
  # records would only resolve from the top of the worktree. An agent reading
  # the record is as likely to be somewhere else.
  case $STATE in /*) ;; *) STATE="$REPO/$STATE" ;; esac
  LOGS="$STATE/logs-$1"
  mkdir -p "$LOGS" 2>/dev/null || { STATE=; LOGS=; return 0; }
  # One run's worth. A history nobody prunes is a directory that grows until
  # someone notices it, and the question is always about the last run.
  set +f
  rm -f "$LOGS"/*.log 2>/dev/null || true
  set -f
  PART="$STATE/last-$1.json.part"
  : > "$PART" 2>/dev/null || { PART=; return 0; }
  RECORD_FOR=$1
}

check_log() {          # index check -> a path, or nothing when there is no state
  [ -n "$LOGS" ] || return 0
  # A check name reaches a filename here, and `plain()` in the image refuses a
  # tab, a newline and the separator but not a slash. The index keeps two
  # checks that sanitize to the same name from sharing one log.
  printf '%s/%s-%s.log' "$LOGS" "$1" "$(printf '%s' "$2" | tr -c 'A-Za-z0-9._-' '_')"
}

record_check() {       # check rc seconds log
  [ -n "$PART" ] || return 0
  # Appended from the lane subshells as well as from here, so the order is the
  # order checks FINISHED. One short line per check, one write each.
  printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "${4:-}" >> "$PART" 2>/dev/null || true
}

record_finish() {      # worst status
  [ -n "$PART" ] && [ -f "$PART" ] || return 0
  # awk because the escaping has to be done once and correctly: a check name or
  # a path is the only thing here that can carry a quote or a backslash.
  awk -F'\t' -v cmd="$RECORD_FOR" -v worst="$1" \
      -v when="$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || printf unknown)" '
    function esc(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); return s }
    BEGIN {
      printf "{\n  \"command\": \"%s\",\n  \"finished\": \"%s\",\n", esc(cmd), esc(when)
      printf "  \"exit\": %s,\n  \"checks\": [\n", worst
    }
    {
      if (n++) printf ",\n"
      printf "    {\"check\": \"%s\", \"exit\": %s, \"seconds\": %s, \"log\": ", \
             esc($1), $2, $3
      if ($4 == "") printf "null}"; else printf "\"%s\"}", esc($4)
    }
    END { printf "\n  ]\n}\n" }
  ' "$PART" > "$STATE/last-$RECORD_FOR.json" 2>/dev/null || true
  rm -f "$PART" 2>/dev/null || true
}

# --------------------------------------------------------------------- the plan
#
# Which checks run is decided by the repo's [tool.sdlc.commit], [tool.sdlc.push]
# and [tool.sdlc.ci] blocks, and this shell cannot read TOML. So it asks the
# image for a plan -- one line per step, `check TAB lane TAB mode TAB payload` --
# and carries it out. The lane is handled under "the lanes" below. The modes:
#
#   image-ro | image-rw   `sdlc <payload>` in the image, the tree ro or rw
#   local                 a check this file answers itself
#   host                  a podman argv, words joined by the unit separator
#   host-up               seconds, then a host argv: a run still going when
#                         they are up passes (see run_host)
#   host-systemd          seconds, then argv groups split by the step
#                         separator (0x1a): a service booted with systemd as PID 1,
#                         a readiness probe, steps exec'd in order (run_systemd)
#
# A host line that does not start with `podman build` or `podman run` is
# refused: the host contract is held here, by the launcher, not trusted to
# anything a repo's config says. The argv is SPLIT on the separator, never
# `eval`ed, so nothing in it is ever read as shell -- no expansion, no command
# substitution -- before or after that check.

TAB=$(printf '\t')
US=$(printf '\037')
SS=$(printf '\032')   # between a host-systemd step's argv groups

check_image_word() {   # run-args -> dies unless the word after `--` is an image
  # The planner validates every image reference; this holds the same line on
  # the host, because the host is what a bad one would harm. Only the word
  # after a `--` is judged: before it podman reads options, after the image it
  # passes arguments to the container.
  _ciafter=
  for _ciw in "$@"; do
    if [ "$_ciafter" = yes ]; then
      case "$_ciw" in
        ''|-*|*[!A-Za-z0-9._/:@-]*)
          die "a host step names '$_ciw' as its image, which is not an image reference" ;;
      esac
      return 0
    fi
    [ "$_ciw" = -- ] && _ciafter=yes
  done
  [ "$_ciafter" = yes ] && die "a host step ends with '--' and names no image"
  return 0
}

pid1_of() {            # run-args -> what the container would start as PID 1
  # The image's entrypoint if it has one; else the run's first argument, which
  # replaces CMD; else the CMD. Empty when podman cannot say, and then the run
  # goes ahead and is judged as any other.
  _pafter=
  _pimg=
  _parg=
  for _pw in "$@"; do
    if [ -n "$_pimg" ]; then _parg=$_pw; break; fi
    if [ "$_pafter" = yes ]; then _pimg=$_pw; continue; fi
    [ "$_pw" = -- ] && _pafter=yes
  done
  _pep=$(podman image inspect --format '{{range .Config.Entrypoint}}{{println .}}{{end}}' \
         "$_pimg" 2>/dev/null | head -1)
  if [ -n "$_pep" ]; then printf '%s' "$_pep"; return 0; fi
  if [ -n "$_parg" ]; then printf '%s' "$_parg"; return 0; fi
  podman image inspect --format '{{range .Config.Cmd}}{{println .}}{{end}}' \
    "$_pimg" 2>/dev/null | head -1
}

run_up() {             # seconds run-args -> the smoke verdict
  # A `podman run` that may be a service. It starts detached, and its STATE is
  # asked once a second for up to <seconds>: still running at the end passes,
  # and so does exiting 0; any other exit, or the OOM killer, is a finding.
  # Asked of podman, never inferred from a clock or from podman run's own
  # status, because 255 is both podman's timeout kill and a program's crash,
  # and a clock started before `podman run` counts creation as uptime.
  #
  # Not --rm: the state is read after the container stops. Removed here, by
  # name, however it ended. A k8s-file log so its output can be shown, which
  # --log-driver=none would discard.
  _upsecs=$1; shift
  case " $* " in *" -- "*) ;; *) die "a run given time to stay up must name its image after '--'" ;; esac
  check_image_word "$@"
  # A systemd PID 1 (ubi-init, bootc) needs capabilities and a cgroup mount
  # this run withholds on purpose, so it dies whatever the image is like. That
  # is not judged: 4 is SKIPPED, printed as such, and never a pass. The build
  # and the scan are separate checks and still run.
  _pid1=$(pid1_of "$@")
  case "$_pid1" in
    /sbin/init|/usr/sbin/init|/lib/systemd/systemd|/usr/lib/systemd/systemd|init|systemd)
      printf '%s: SKIPPED: the image starts %s as PID 1, and systemd PID 1 needs privileges smoke cannot grant\n' \
        "$ME" "$_pid1" >&2
      return 4 ;;
  esac
  _cname=$(unique_name sdlc-smoke)
  _uprc=0
  podman --events-backend=none run -d --name "$_cname" --log-driver=k8s-file \
    --cap-drop=all ${NNP:+"$NNP"} \
    --cpus "$GATE_CPUS" --memory "$GATE_MEMORY" --cpu-shares 256 \
    "$@" </dev/null >/dev/null || _uprc=$?
  case "$_uprc" in
    0) ;;
    # 125 is podman itself: the container never existed, nothing was judged.
    125) podman rm -f -v "$_cname" >/dev/null 2>&1 || :
         printf '%s: podman could not create the container (exit 125); nothing was judged\n' "$ME" >&2
         return 2 ;;
    # 126/127 is the image: an entrypoint that is missing or cannot execute,
    # which is exactly what a smoke run exists to catch.
    *) podman logs "$_cname" 2>&1 || :
       podman rm -f -v "$_cname" >/dev/null 2>&1 || :
       printf '%s: the image could not start its entrypoint (exit %s)\n' "$ME" "$_uprc" >&2
       return 1 ;;
  esac
  _upi=0
  while [ "$_upi" -lt "$_upsecs" ]; do
    _uprun=$(podman inspect --format '{{.State.Running}}' "$_cname" 2>/dev/null) || _uprun=gone
    [ "$_uprun" = true ] || break
    sleep 1
    _upi=$((_upi + 1))
  done
  _upstate=$(podman inspect --format '{{.State.Running}} {{.State.ExitCode}} {{.State.OOMKilled}}' \
             "$_cname" 2>/dev/null) || _upstate=
  podman logs "$_cname" 2>&1 || :
  podman rm -f -v "$_cname" >/dev/null 2>&1 || :
  # Exit 0 is a pass whatever OOMKilled says: nested rootless podman reports
  # it true even for `true`, and for an image that exits 1 on its own. It
  # counts only beside 137, the SIGKILL a real OOM kill ends in.
  case "$_upstate" in
    'true '*)      printf 'still running after %ss: the image starts and stays up\n' "$_upsecs"; return 0 ;;
    'false 0 '*)   return 0 ;;
    'false 137 true') printf '%s: the container was killed for memory\n' "$ME" >&2; return 1 ;;
    'false '*)     printf '%s: the container exited %s within %ss of starting\n' "$ME" \
                     "$(printf '%s' "$_upstate" | cut -d' ' -f2)" "$_upsecs" >&2; return 1 ;;
    *)             printf '%s: podman could not report the container state; nothing was judged\n' "$ME" >&2
                   return 2 ;;
  esac
}

# What systemd as PID 1 needs back, and nothing more. The run is otherwise as
# locked down as any host step: no network unless the plan says, and
# no-new-privileges, which systemd's own setuid()/setgid() into a unit's User=
# does not need -- only a setuid binary would.
#   SETUID SETGID   start a unit as its User=/Group= (postgres, a service user)
#   SETPCAP         set each unit's capability bounding set as it starts it
#   CHOWN FOWNER    create and hand over RuntimeDirectory=, tmpfiles.d and a
#                   data directory to the user that owns it
#   DAC_OVERRIDE    root reaching into those directories once they are owned
#   KILL            stop and restart a unit that runs as another user
#   NET_BIND_SERVICE  a unit that listens below 1024 (nginx on 80) fails to
#                   start without it, even with no network to reach it from
# Not podman's other defaults: FSETID, SETFCAP, SYS_CHROOT (a unit's
# RootDirectory=, which needs mounts this run does not have anyway).
SYSTEMD_CAPS=CHOWN,DAC_OVERRIDE,FOWNER,KILL,NET_BIND_SERVICE,SETGID,SETPCAP,SETUID
# The longest a booted service may live, enforced by conmon rather than by this
# script: a gate killed outright runs no cleanup, and --rm then removes it.
SYSTEMD_LIFETIME=3600
# How long the setup steps and the test may take together once the service is
# ready. A hung step is a finding at this, not a container held for conmon's
# hour. Settable so the test can reach it without waiting.
SYSTEMD_STEPS=${SDLC_SYSTEMD_STEPS:-1800}
case "$SYSTEMD_STEPS" in ''|*[!0-9]*) die "SDLC_SYSTEMD_STEPS must be a whole number" ;; esac

systemd_watch() {      # container seconds -> _sdwd, a watchdog that removes it then
  # Removing the container is what ends an exec hung inside it. One-second
  # sleeps so that killing the watchdog leaves nothing behind for long.
  ( _w=0
    while [ "$_w" -lt "$2" ]; do sleep 1; _w=$((_w + 1)); done
    podman rm -f -v -t 0 "$1" ) </dev/null >/dev/null 2>&1 &
  _sdwd=$!
}

systemd_diag() {       # container -> what systemd says went wrong, best effort
  printf '\n== systemd: failed units\n' >&2
  podman exec "$1" systemctl --failed --no-legend --no-pager >&2 2>&1 </dev/null || :
  printf '== container log (tail)\n' >&2
  podman logs --tail 50 "$1" >&2 2>&1 || :
}

run_systemd() {        # timeout payload -> the step's verdict
  # A `command` run against a service: the image boots systemd as PID 1,
  # detached; the readiness probe is exec'd every two seconds until it exits 0
  # or <timeout> is up; then each step is exec'd in order and the first that
  # fails ends the check. The container is removed however that ended. The
  # payload is argv groups split by SS, each one's words split by US, and
  # nothing in any of them is read as shell:
  #   1  podman run ... -- IMAGE      held to `podman run` and an image word
  #   2  exec options                 only `-w DIR` and `-e NAME=VALUE`
  #   3  the readiness probe
  #   4+ the steps, the test last
  _sdsecs=$1
  _ifs=$IFS
  IFS=$SS
  # shellcheck disable=SC2086  # splitting on the separator is the point
  set -- $2
  IFS=$_ifs
  [ "$#" -ge 4 ] || die "a host-systemd step needs a run, exec options, a probe and a step"
  _sdrun=$1 _sdopts=$2 _sdready=$3
  shift 3
  _sdsteps=$(printf '%s\n' "$@")   # one group per line; US splits the words
  _ifs=$IFS
  IFS=$US
  # shellcheck disable=SC2086
  set -- $_sdrun
  IFS=$_ifs
  [ "${1:-}" = podman ] && [ "${2:-}" = run ] \
    || die "a host-systemd step must start with podman run; refused: ${1:-<empty>} ${2:-}"
  shift 2
  case " $* " in *" -- "*) ;; *) die "a host-systemd run must name its image after '--'" ;; esac
  check_image_word "$@"
  # Before the image, only the two options the planner writes: the checkout
  # read-only at /repo, and no network. After it, nothing: systemd is PID 1.
  _sdimg=
  _sdafter=
  _sdprev=
  for _w in "$@"; do
    if [ "$_sdafter" = yes ]; then
      [ -z "$_sdimg" ] || die "a host-systemd run passes nothing after its image: systemd is PID 1"
      _sdimg=$_w
      continue
    fi
    case "$_sdprev:$_w" in
      :--) _sdafter=yes ;;
      :-v|:--network) _sdprev=$_w ;;
      "-v:$HOST_REPO:/repo:ro,z"|--network:none) _sdprev= ;;
      *) die "a host-systemd run may only mount the checkout read-only and drop the network; refused: $_w" ;;
    esac
  done
  # The exec options, checked word by word: a forged --privileged or --user
  # stops here.
  _ifs=$IFS
  IFS=$US
  # shellcheck disable=SC2086
  set -- $_sdopts
  IFS=$_ifs
  while [ "$#" -gt 0 ]; do
    case "$1:${2:-}" in
      -w:/*) ;;
      -e:[A-Za-z_]*=*) case "${2%%=*}" in *[!A-Za-z0-9_]*) die "a host-systemd exec option sets '${2%%=*}', which is not a variable name" ;; esac ;;
      *) die "a host-systemd exec option may only be -w or -e; refused: $1" ;;
    esac
    shift 2
  done
  _sdname=$(unique_name sdlc-systemd)
  _sdrc=0
  _ifs=$IFS
  IFS=$US
  # shellcheck disable=SC2086
  set -- $_sdrun
  IFS=$_ifs
  shift 2
  # Named to the traps before it exists: a signal during the start still
  # removes it.
  SD_LIVE=$_sdname
  podman --events-backend=none run -d --rm --name "$_sdname" --log-driver=k8s-file \
    --systemd=always --timeout "$SYSTEMD_LIFETIME" \
    --cap-drop=all --cap-add="$SYSTEMD_CAPS" ${NNP:+"$NNP"} \
    --cpus "$GATE_CPUS" --memory "$GATE_MEMORY" --cpu-shares 256 \
    "$@" </dev/null >/dev/null || _sdrc=$?
  case "$_sdrc" in
    0) systemd_steps "$_sdname" "$_sdsecs" "$_sdopts" "$_sdready" "$_sdsteps" || _sdrc=$? ;;
    125) printf '%s: podman could not create the container (exit 125); nothing was judged\n' "$ME" >&2
         _sdrc=2 ;;
    # Any other start status. A detached run returns before the container's own
    # process can exit, so its status is never the service's or a test's: it is
    # podman failing to start PID 1 (126 not executable, 127 not found, or some
    # other podman error). No step ran and nothing produced a verdict, so it is a
    # 2, as the header's contract says. A service that starts and then dies or
    # never becomes ready is judged below, by systemd_steps.
    *)   printf '%s: %s could not start systemd (exit %s); nothing was judged\n' "$ME" "$_sdimg" "$_sdrc" >&2
         _sdrc=2 ;;
  esac
  step_cleanup
  return "$_sdrc"
}

systemd_exec() {       # container options-group argv-group -> the exec's status
  _ifs=$IFS
  IFS=$US
  # shellcheck disable=SC2086  # the words were checked by run_systemd
  set -- $2 "$1" $3
  IFS=$_ifs
  podman --events-backend=none exec "$@" </dev/null
}

systemd_steps() {      # container timeout options probe steps -> 0, 1 or 2
  # The probe's own output is dropped: a hundred "connection refused" lines
  # say less than the one line below.
  # A probe that hangs rather than fails is ended by the watchdog, a little
  # after the loop would have given up on it.
  _sdt0=$(now_s)
  _sdi=0
  systemd_watch "$1" $(( $2 + 5 ))
  until systemd_exec "$1" "$3" "$4" >/dev/null 2>&1; do
    _sdi=$(( $(now_s) - _sdt0 ))
    if [ "$_sdi" -ge "$2" ]; then
      kill "$_sdwd" 2>/dev/null || :
      printf '%s: not ready after %ss: %s\n' "$ME" "$2" "$(printf '%s' "$4" | tr "$US" ' ')" >&2
      systemd_diag "$1"
      return 1
    fi
    _sdup=$(podman inspect --format '{{.State.Running}}' "$1" 2>/dev/null) || _sdup=gone
    if [ "$_sdup" != true ]; then
      kill "$_sdwd" 2>/dev/null || :
      printf '%s: the container stopped before it was ready\n' "$ME" >&2
      podman logs --tail 50 "$1" >&2 2>&1 || :
      return 1
    fi
    sleep 2
  done
  kill "$_sdwd" 2>/dev/null || :
  _sdi=$(( $(now_s) - _sdt0 ))
  printf 'ready after %ss\n' "$_sdi"
  _sdt0=$(now_s)
  systemd_watch "$1" "$SYSTEMD_STEPS"
  _ifs=$IFS
  IFS='
'
  for _sdstep in $5; do
    IFS=$_ifs
    printf '\n== exec %s\n' "$(printf '%s' "$_sdstep" | tr "$US" ' ')"
    _sdx=0
    systemd_exec "$1" "$3" "$_sdstep" || _sdx=$?
    [ "$_sdx" -eq 0 ] && continue
    IFS=$_ifs
    kill "$_sdwd" 2>/dev/null || :
    # The watchdog removed the container: the step hung, and that is a finding.
    if [ "$(( $(now_s) - _sdt0 ))" -ge "$SYSTEMD_STEPS" ]; then
      printf '%s: the steps did not finish within %ss; the container was removed\n' \
        "$ME" "$SYSTEMD_STEPS" >&2
      return 1
    fi
    case "$_sdx" in
      1) systemd_diag "$1"; return 1 ;;
      *) printf '%s: the step exited %s; nothing was judged\n' "$ME" "$_sdx" >&2
         systemd_diag "$1"; return 2 ;;
    esac
  done
  IFS=$_ifs
  kill "$_sdwd" 2>/dev/null || :
  return 0
}

run_host() {           # argv [seconds] -> the step's verdict
  # With seconds, the step is a `podman run` that may be a service: run_up
  # judges it by its state.
  _up=${2:-}
  _ifs=$IFS
  IFS=$US
  # shellcheck disable=SC2086  # splitting on the separator is the point
  set -- $1
  IFS=$_ifs
  [ "${1:-}" = podman ] || die "a host step may only run podman; refused: ${1:-<empty>}"
  _sub=${2:-}
  shift 2
  # `@sdlc-image` is this gate's own image, which only this script knows: a
  # check that runs the gate image as a host step (container-scan) names it so.
  # Replaced as a whole word only, after the split, so it is never shell.
  for _w in "$@"; do
    shift
    [ "$_w" = @sdlc-image ] && _w=$IMAGE
    set -- "$@" "$_w"
  done
  if [ -n "$_up" ]; then
    [ "$_sub" = run ] || die "only a podman run can be given a time to stay up"
    run_up "$_up" "$@"
    return
  fi
  # The budget is applied here so it is defined once, whatever the step.
  case "$_sub" in
    build) set -- build --cpu-period 100000 --cpu-quota "$(( GATE_CPUS * 100000 ))" \
                        --memory "$GATE_MEMORY" "$@" ;;
    run)   check_image_word "$@"
           set -- --events-backend=none run --log-driver=none \
                        --cap-drop=all ${NNP:+"$NNP"} \
                        --cpus "$GATE_CPUS" --memory "$GATE_MEMORY" --cpu-shares 256 "$@" ;;
    *)     die "a host step may only build or run; refused: podman $_sub" ;;
  esac
  # Not `_rc`: shell variables are global, and run_serial reads its own after
  # this returns, so a status set here would survive into the caller.
  _hrc=0
  podman "$@" </dev/null || _hrc=$?
  # A failed build is a finding: the code does not produce an image. A run
  # that podman could not start (125-127) never ran, so it is a 2, and so is a
  # pytest status above 1 (interrupted, usage error, internal error, no tests).
  case "$_sub:$_hrc" in
    *:0) return 0 ;;
    build:*) return 1 ;;
    run:1) return 1 ;;
    *) printf '%s: podman %s exited %s; nothing was judged\n' "$ME" "$_sub" "$_hrc" >&2; return 2 ;;
  esac
}

run_step() {           # mode payload -> the step's exit status
  _rs=0
  # A host step's output is the repo's code talking -- a build's RUN, a test, a
  # service's log. On Actions it must not be able to issue a workflow command
  # (set an output, add a path, mask nothing). The image's own steps stop them
  # themselves.
  case "$1" in host*) commands_stop ;; esac
  _run_step "$@" || _rs=$?
  commands_resume
  # Only a push may defer to CI. Anything else that reports 3 could not run.
  if [ "$_rs" -eq 3 ] && [ "${SDLC_TIER:-}" != push ]; then return 2; fi
  # Two statuses mean "not gating", and each comes from one place only:
  #   4  SKIPPED, not judged: run_up for a systemd PID 1, and
  #      containerfile-lint when hadolint cannot parse the Containerfile
  #   5  found something, ADVISORY: an advisory smoke run's finding
  # Anything else exiting 4 or 5 -- any tool in any other check -- found
  # something, as it always has.
  case "$_rs:$1:$2" in
    4:host-up:*|4:host-up-advisory:*|4:image-ro:containerfile-lint) ;;
    1:host-up-advisory:*) return 5 ;;
    4:*|5:*) return 1 ;;
  esac
  return "$_rs"
}

advisory() {           # check seconds -> the footer of an advisory finding
  printf '\n== %s FOUND SOMETHING, ADVISORY: not gating, after %ss\n' "$1" "$2"
  printf '%s:   To make it gate: gate = true in [tool.sdlc.ci.%s]\n' "$ME" "$1"
}

deferred() {           # check -> the warning a deferral prints, every time
  printf '\n%s: %s COULD NOT RUN -- DEFERRED TO CI.\n' "$ME" "$1" >&2
  printf '%s:   This push is not blocked, and nothing was judged here.\n' "$ME" >&2
  printf '%s:   The "sdlc ci" job is the verdict on this commit.\n' "$ME" >&2
}

_run_step() {
  case "$1" in
    image-ro) run_in_image ro nostdin "$IMAGE" "$2" ;;
    image-rw) run_in_image rw nostdin "$IMAGE" "$2" ;;
    local)
      case "$2" in
        hooks-installed) ( t_hooks_installed ) ;;
        gatehouse)       ( t_gatehouse ) ;;
        *) die "the image asked for an unknown local check: $2" ;;
      esac ;;
    host) run_host "$2" ;;
    host-systemd)
      _secs=${2%%"$US"*}
      case "$_secs" in ''|*[!0-9]*) die "a host-systemd step must start with a number of seconds" ;; esac
      run_systemd "$_secs" "${2#*"$US"}" ;;
    host-up|host-up-advisory)
      _secs=${2%%"$US"*}
      case "$_secs" in ''|*[!0-9]*) die "a host-up step must start with a number of seconds" ;; esac
      run_host "${2#*"$US"}" "$_secs" ;;
    *) die "the image asked for an unknown step mode: $1" ;;
  esac
}

_close_serial() {      # the open check is finished: footer and record
  [ -n "${_scur:-}" ] || return 0
  # Only a PASS prints here. A failure has already said so, at the moment it
  # happened, rather than when the next check starts.
  [ "$_scur_rc" -eq 0 ] && printf '\n== %s passed in %ss\n' "$_scur" "$_scur_took"
  [ "$_scur_rc" -eq 4 ] && printf '\n== %s SKIPPED, not judged, after %ss\n' "$_scur" "$_scur_took"
  [ "$_scur_rc" -eq 5 ] && advisory "$_scur" "$_scur_took"
  record_check "$_scur" "$_scur_rc" "$_scur_took" ""
  _scur=
}

run_serial() {         # the plan -> its worst step status
  _worst=0
  _failed=
  _scur=
  _scur_rc=0
  _scur_took=0
  _sidx=0
  _ifs=$IFS
  IFS='
'
  for _line in $1; do
    IFS=$_ifs
    _check=${_line%%"$TAB"*}
    _rest=${_line#*"$TAB"}
    _rest=${_rest#*"$TAB"}          # the lane; one lane, so nothing to decide
    _mode=${_rest%%"$TAB"*}
    _payload=${_rest#*"$TAB"}
    # One failed step ends that check; the next check still runs.
    case " $_failed " in *" $_check "*) continue ;; esac
    # A check's steps are contiguous, so a new name closes the previous block.
    # The timing is per CHECK, not per step: `pytest-in-image` is a deps step
    # and then the run, and what anyone wants to know is what pytest cost.
    if [ "$_check" != "$_scur" ]; then
      _close_serial
      _sidx=$((_sidx + 1))
      _scur=$_check
      _scur_rc=0
      _scur_took=0
    fi
    _t0=$(now_s)
    _rc=0
    run_step "$_mode" "$_payload" || _rc=$?
    _scur_took=$(( _scur_took + $(now_s) - _t0 ))
    if [ "$_rc" -eq 3 ]; then
      _failed="$_failed $_check"
      _scur_rc=3
      deferred "$_check"
    elif [ "$_rc" -eq 4 ] || [ "$_rc" -eq 5 ]; then
      _scur_rc=$_rc
    elif [ "$_rc" -ne 0 ]; then
      _failed="$_failed $_check"
      _scur_rc=$_rc
      printf '\n%s: %s %s after %ss\n' "$ME" "$_check" \
        "$([ "$_rc" -eq 2 ] && echo 'COULD NOT RUN' || echo 'FAILED')" "$_scur_took" >&2
      # A later 1 must not mask an earlier 2.
      if [ "$_rc" -eq 2 ] || [ "$_worst" -eq 2 ]; then _worst=2; else _worst=1; fi
    fi
  done
  IFS=$_ifs
  _close_serial
  return "$_worst"
}

# ------------------------------------------------------------------- the lanes
#
# The plan's second field is a lane. Steps of one lane run in sequence, in plan
# order; lanes run at the same time. Which steps share a lane is the image's
# decision (see "the lanes" in `sdlc`), so no check name appears in this file --
# a repo with one lane never reaches any of this and runs through run_serial
# exactly as it did before lanes existed.
#
# Two things change when there is more than one lane:
#
#   - The CPU budget is DIVIDED between them. The budget is for the whole gate,
#     not for each container: two lanes at half the budget take the same share
#     of the machine that one lane at the whole budget took, so a laptop running
#     `sdlc ci` is no worse off than before.
#   - Every lane's output is buffered to a file per CHECK and printed whole, in
#     plan order, as each check finishes. Two lanes writing to one terminal
#     produce a log nobody can read. The cost is that the `== <step>` markers
#     inside a block all arrive at once, so each block ends with how long its
#     check took -- which is the number people were reading off those markers.

OUT=                   # the lane scratch directory, while lanes are running

# How long the printer waits with NO CHECK FINISHING before it stops waiting on
# the order. What it measures is silence, not death, and two things cause it:
# a lane killed outright -- SIGKILL, the OOM killer, a cancelled CI job -- which
# runs no EXIT trap and so never reports at all; or a single check that honestly
# takes longer than this. The first is the one worth guarding, because without
# the guard the printer polls for a marker that is never coming. The second is
# why the default is an hour and why tripping it is cosmetic: the order is
# abandoned, the exit status is not, because the reap below is the authority.
# Settable so the test can reach the boundary without waiting an hour for it.
STALL_MAX=${SDLC_LANE_STALL:-3600}
case "$STALL_MAX" in ''|*[!0-9]*) die "SDLC_LANE_STALL must be a whole number" ;; esac

_lanes_running() {     # 0 while any lane has not yet written its done marker
  _j=0
  while [ "$_j" -lt "$NLANES" ]; do
    _j=$((_j + 1))
    if [ ! -f "$OUT/lane-done.$_j" ]; then return 0; fi
  done
  return 1
}

_close_check() {       # the open check's block is complete
  if [ -n "${_cur:-}" ]; then
    # One footer per CHECK, carrying the time every one of its steps took. It
    # used to be written per STEP, so `pytest-in-image` -- a `pytest-deps` step
    # and then the run -- ended with two, the first of them "passed in 0s".
    if [ "$_cur_rc" -eq 0 ]; then
      printf '\n== %s passed in %ss\n' "$_cur_name" "$_cur_took" >> "$OUT/out.$_cur"
    elif [ "$_cur_rc" -eq 4 ]; then
      printf '\n== %s SKIPPED, not judged, after %ss\n' "$_cur_name" "$_cur_took" >> "$OUT/out.$_cur"
    elif [ "$_cur_rc" -eq 5 ]; then
      advisory "$_cur_name" "$_cur_took" >> "$OUT/out.$_cur"
    elif [ "$_cur_rc" -eq 3 ]; then
      deferred "$_cur_name" 2>> "$OUT/out.$_cur"
    else
      printf '\n%s: %s %s after %ss\n' "$ME" "$_cur_name" \
        "$([ "$_cur_rc" -eq 2 ] && echo 'COULD NOT RUN' || echo 'FAILED')" \
        "$_cur_took" >> "$OUT/out.$_cur"
    fi
    printf '%s\n' "$_cur_rc" > "$OUT/rc.$_cur"
    # Kept where the record can point at it. The scratch directory goes away
    # when the command ends; this is what someone reads afterwards.
    _log=$(check_log "$_cur" "$_cur_name")
    if [ -n "$_log" ]; then
      cat "$OUT/out.$_cur" > "$_log" 2>/dev/null || _log=
    fi
    record_check "$_cur_name" "$_cur_rc" "$_cur_took" "$_log"
    _cur=
  fi
}

run_lane() {           # lane-index steps-file lane-cpus [lane-memory] -> the lane's worst
  _k=$1
  GATE_CPUS=$3
  GATE_MEMORY=${4:-$GATE_MEMORY}
  _worst=0
  _failed=
  _cur=
  _cur_rc=0
  _cur_took=0
  _cur_name=
  # However this subshell ends -- a step's `die` exits it where it stands -- the
  # check it was on must get a verdict file and the lane must get its done
  # marker, or the printer waits for a block that is never coming.
  # shellcheck disable=SC2016  # expanded when the trap runs
  on_exit 'printf "2\n" > "$OUT/rc.${_cur:-0}"; printf "2\n" > "$OUT/lane-done.$_k"'

  # `index TAB check TAB mode TAB payload`: the lane is gone, this file is one,
  # and the index into the print order was resolved when the file was written
  # rather than by an awk per step.
  while IFS= read -r _line; do
    _i=${_line%%"$TAB"*}
    _rest=${_line#*"$TAB"}
    _check=${_rest%%"$TAB"*}
    _rest=${_rest#*"$TAB"}
    _mode=${_rest%%"$TAB"*}
    _payload=${_rest#*"$TAB"}
    case " $_failed " in *" $_check "*) continue ;; esac
    # A check's steps are contiguous within its lane, so a different index means
    # the previous block is finished and can be printed.
    if [ "$_i" != "${_cur:-}" ]; then
      _close_check
      _cur=$_i
      _cur_rc=0
      _cur_took=0
      _cur_name=$_check
    fi
    _t0=$(now_s)
    _rc=0
    run_step "$_mode" "$_payload" >> "$OUT/out.$_i" 2>&1 || _rc=$?
    _cur_took=$(( _cur_took + $(now_s) - _t0 ))
    if [ "$_rc" -eq 3 ]; then
      _failed="$_failed $_check"
      _cur_rc=3
    elif [ "$_rc" -eq 4 ] || [ "$_rc" -eq 5 ]; then
      _cur_rc=$_rc
    elif [ "$_rc" -ne 0 ]; then
      _failed="$_failed $_check"
      _cur_rc=$_rc
      # A later 1 must not mask an earlier 2, in this lane or any other.
      if [ "$_rc" -eq 2 ] || [ "$_worst" -eq 2 ]; then _worst=2; else _worst=1; fi
    fi
  done < "$2"

  _close_check
  # The trap stays armed through this: it writes the same marker, and its only
  # reader asks whether the file exists. Clearing it first would leave a window
  # where a failed write means no marker at all, and the printer waiting on one.
  printf '%s\n' "$_worst" > "$OUT/lane-done.$_k"
  return "$_worst"
}

lane_has_container() { # plan lane -> 0 when any of its steps runs a container
  printf '%s\n' "$1" | awk -F"$TAB" -v l="$2" '
    $2 == l && $3 != "local" { found = 1 }
    END { exit found ? 0 : 1 }'
}

run_split() {          # the plan -> the worst status, one lane streaming
  # The case where exactly one lane runs containers and the others only ask this
  # script questions -- today that is a push, with the reviewer beside the rest.
  #
  # run_lanes buffers EVERY lane to a file and prints each block when it is
  # finished, because two lanes writing one terminal produce a log nobody can
  # read. That is the right trade when both lanes are working. It is the wrong
  # one here: the lane that is working is the whole of a push, and buffering it
  # would mean watching nothing for the length of the test suite. Someone
  # waiting on a silent terminal for three minutes concludes it has hung.
  #
  # So the lane with the containers runs in the FOREGROUND, through the ordinary
  # sequential path -- same output, live, as a repo with one lane has always had
  # -- and the others run beside it, buffered, and are printed whole after it.
  OUT=$(mktemp -d) || die "cannot create a scratch directory for the lane logs"
  # shellcheck disable=SC2016  # expanded when the trap runs
  on_exit 'rm -rf "$OUT"; record_finish 2; unpin_hook_index'

  printf '%s\n' "$1" | cut -f1 | awk '!seen[$0]++' > "$OUT/order"
  printf '%s\n' "$1" | cut -f2 | awk '!seen[$0]++' > "$OUT/lanes"

  # Once, here, rather than from whichever lane gets there first.
  need_volume "$CACHE_VOLUME"

  _spfg=
  _spk=0
  _sppids=
  _spidx=
  while IFS= read -r _splane; do
    if lane_has_container "$1" "$_splane"; then
      _spfg=$_splane
      continue
    fi
    _spk=$((_spk + 1))
    # The same global numbering run_lanes uses, so an index names the same check
    # in both paths.
    printf '%s\n' "$1" | awk -F"$TAB" -v OFS="$TAB" -v l="$_splane" '
      !($1 in idx) { idx[$1] = ++n }
      $2 == l      { print idx[$1], $1, $3, $4 }' > "$OUT/steps.$_spk"
    printf '%s: beside the rest: %s(output follows)\n' "$ME" \
      "$(cut -f2 "$OUT/steps.$_spk" | awk '!seen[$0]++' | tr '\n' ' ')"
    _spidx="$_spidx $(cut -f1 "$OUT/steps.$_spk" | awk '!seen[$0]++' | tr '\n' ' ')"
    run_lane "$_spk" "$OUT/steps.$_spk" 1 &
    _sppids="$_sppids $!"
  done < "$OUT/lanes"

  _spworst=0
  _spplan=$(printf '%s\n' "$1" | awk -F"$TAB" -v l="$_spfg" '$2 == l')
  if [ -n "$_spplan" ]; then
    run_serial "$_spplan" || _spworst=$?
  fi

  # Reaped BEFORE the blocks below are printed: the status is the answer and is
  # never guessed from what a file happened to contain, and once every lane has
  # stopped nothing is still writing.
  for _spp in $_sppids; do
    _sprc=0
    wait "$_spp" || _sprc=$?
    case "$_sprc" in
      0) ;;
      2) _spworst=2 ;;
      *) [ "$_spworst" -eq 2 ] || _spworst=1 ;;
    esac
  done

  for _spi in $_spidx; do
    if [ -f "$OUT/out.$_spi" ]; then
      cat "$OUT/out.$_spi"
    else
      printf '\n%s: %s NEVER RAN: its lane stopped before reaching it\n' "$ME" \
        "$(awk -v n="$_spi" 'NR == n {print; exit}' "$OUT/order")" >&2
    fi
  done

  rm -rf "$OUT"
  trap - EXIT HUP INT TERM
  return "$_spworst"
}

run_lanes() {          # the plan -> the worst status of every lane
  OUT=$(mktemp -d) || die "cannot create a scratch directory for the lane logs"
  # shellcheck disable=SC2016  # expanded when the trap runs
  on_exit 'rm -rf "$OUT"; record_finish 2; unpin_hook_index'

  # The checks in plan order, first appearance: the order blocks are printed in.
  printf '%s\n' "$1" | cut -f1 | awk '!seen[$0]++' > "$OUT/order"
  printf '%s\n' "$1" | cut -f2 | awk '!seen[$0]++' > "$OUT/lanes"
  NCHECKS=$(awk 'END {print NR}' "$OUT/order")
  NLANES=$(awk 'END {print NR}' "$OUT/lanes")

  # Divided between the lanes that actually run something on a CPU. A lane whose
  # every step is `local` -- a question this script answers itself, or a reviewer
  # that is one API call and then waiting -- takes a single CPU and is left out
  # of the division, so putting one beside the others costs the others nothing.
  # Without that, adding a lane that does no computing would have halved the
  # budget of the lane that does, which is exactly how lanes were measured as a
  # regression (see the budget, above).
  #
  # Floor of one, so a budget smaller than the lane count does overshoot it by
  # a CPU or two. The alternative is running the lanes one after another on a
  # single-CPU budget, which is the thing this exists to stop doing.
  _oncpu=0
  while IFS= read -r _lane; do
    lane_has_container "$1" "$_lane" && _oncpu=$((_oncpu + 1))
  done < "$OUT/lanes"
  [ "$_oncpu" -lt 1 ] && _oncpu=1
  _lane_cpus=$(( GATE_CPUS / _oncpu ))
  [ "$_lane_cpus" -lt 1 ] && _lane_cpus=1
  # Memory is divided the same way, but never floored past what there is:
  # run_plan only sends a plan here when every lane's share is worth running.
  _lane_mem=$(lane_memory "$_oncpu" "${MEM_AVAILABLE:-0}" "$GATE_MEMORY_MB")

  # Once, here, rather than from whichever lane gets there first.
  need_volume "$CACHE_VOLUME"

  printf '%s: %s lanes at the same time, %s CPU(s) and %sm each\n' "$ME" "$NLANES" "$_lane_cpus" "$_lane_mem"
  _k=0
  _pids=
  while IFS= read -r _lane; do
    _k=$((_k + 1))
    # Number each check by first appearance in the WHOLE plan -- the order the
    # blocks print in -- and keep this lane's steps, index first.
    printf '%s\n' "$1" | awk -F"$TAB" -v OFS="$TAB" -v l="$_lane" '
      !($1 in idx) { idx[$1] = ++n }
      $2 == l      { print idx[$1], $1, $3, $4 }' > "$OUT/steps.$_k"
    printf '%s:   lane %s: %s\n' "$ME" "$_lane" \
      "$(cut -f2 "$OUT/steps.$_k" | awk '!seen[$0]++' | tr '\n' ' ')"
    if lane_has_container "$1" "$_lane"; then _cpus=$_lane_cpus; else _cpus=1; fi
    run_lane "$_k" "$OUT/steps.$_k" "$_cpus" "${_lane_mem}m" &
    _pids="$_pids $!"
  done < "$OUT/lanes"

  # Print each block whole, in plan order, as soon as it is finished. A lane
  # that finishes early is HELD BACK, never dropped and never cut into another
  # lane's output; the lanes themselves keep running while this waits.
  _i=1
  _stall=0
  while [ "$_i" -le "$NCHECKS" ]; do
    if [ -f "$OUT/rc.$_i" ]; then
      if [ -f "$OUT/out.$_i" ]; then cat "$OUT/out.$_i"; fi
      _i=$((_i + 1))
      _stall=0
      continue
    fi
    _lanes_running || break
    # Nothing has finished for STALL_MAX seconds. Either a lane was killed and
    # will never report, or a check is honestly taking that long. Either way,
    # stop waiting on the order and fall through to the reap.
    if [ "$_stall" -ge "$STALL_MAX" ]; then
      printf '%s: no check has finished for %ss.\n' "$ME" "$STALL_MAX"
      printf '%s: waiting for every lane to stop, then printing what is left,\n' "$ME"
      printf '%s: which may not be in plan order. Raise SDLC_LANE_STALL if a\n' "$ME"
      printf '%s: check here really does take that long.\n' "$ME"
      break
    fi
    _stall=$((_stall + 1))
    sleep 1
  done

  # Reaped BEFORE the remaining blocks are printed, for two reasons: the status
  # is the answer and is never guessed from what a file happened to contain,
  # and once every lane has stopped nothing is still writing, so the blocks
  # below are whole and still in plan order.
  _worst=0
  for _p in $_pids; do
    _rc=0
    wait "$_p" || _rc=$?
    case "$_rc" in
      0) ;;
      2) _worst=2 ;;
      *) [ "$_worst" -eq 2 ] || _worst=1 ;;
    esac
  done

  # Whatever the loop above did not reach: a lane that stopped where it stood
  # leaves the checks behind it with no block at all. Say so rather than print
  # nothing, which reads exactly like a check that passed.
  while [ "$_i" -le "$NCHECKS" ]; do
    if [ -f "$OUT/out.$_i" ]; then
      cat "$OUT/out.$_i"
    else
      printf '\n%s: %s NEVER RAN: its lane stopped before reaching it\n' "$ME" \
        "$(awk -v n="$_i" 'NR == n {print; exit}' "$OUT/order")" >&2
    fi
    _i=$((_i + 1))
  done

  rm -rf "$OUT"
  trap - EXIT HUP INT TERM
  return "$_worst"
}

# The smallest share of memory worth a lane, in MB. CodeQL is the check that
# sets it: the image hands its evaluator three quarters of SDLC_MEMORY and CodeQL
# rounds anything under 2048 up to 2048, so below 2048 / (3/4) the share is a
# fiction the evaluator ignores. 3072 is that with room for the JVM around it.
# Under it, the lanes take turns: slower, and a run that finishes.
LANE_MEMORY_MIN=3072

lane_memory() {        # lanes available-MB budget-MB -> MB per lane, or 0 to take turns
  _lm=$(( $2 / $1 ))
  [ "$2" -gt 0 ] || _lm=$3                       # unknown: as before
  [ "$_lm" -gt "$3" ] && _lm=$3
  # A budget someone set below the minimum is the floor they asked for.
  _floor=$LANE_MEMORY_MIN
  [ "$3" -lt "$_floor" ] && _floor=$3
  if [ "$_lm" -lt "$_floor" ]; then printf 0; else printf '%s' "$_lm"; fi
}

# `git commit -a` writes its blobs, records them ONLY in the index it is
# building -- .git/index.lock, exported to the hook as GIT_INDEX_FILE -- and then
# runs this. gc and prune judge reachability from refs and .git/index, never a
# lock file, so for as long as the gate runs those blobs are garbage: a
# `git gc --prune=now` from any other process deletes them, and the commit dies
# "invalid object ... Error building trees" (a1001, #94). A ref to the hook's
# tree makes them reachable until the gate is done.
#
# A shared ref, not refs/worktree/: gc run from a linked worktree does not walk
# another worktree's refs/worktree/. One name is enough because this cannot gate
# a linked worktree at all, so two hooks never hold it at once. A run killed
# before it unpins leaves a ref the next one overwrites.
HOOK_PIN=refs/sdlc/hook-index

pin_hook_index() {
  [ -n "${GIT_INDEX_FILE:-}" ] || return 0
  _tree=$(git write-tree 2>/dev/null) || return 0
  git update-ref "$HOOK_PIN" "$_tree" 2>/dev/null || :
}

unpin_hook_index() {
  [ -n "${GIT_INDEX_FILE:-}" ] || return 0
  git update-ref -d "$HOOK_PIN" 2>/dev/null || :
}

run_plan() {           # commit | push | ci | <check>
  pin_hook_index
  on_exit 'unpin_hook_index'
  # The image asks this to decide whether CodeQL may defer to CI.
  SDLC_TIER=$1
  export SDLC_TIER
  _plan=$(run_in_image ro nostdin "$IMAGE" plan "$1") \
    || die "the image could not plan '$1'; nothing was checked"
  if [ -z "$_plan" ]; then
    # `sarif` on a repo that runs neither CodeQL nor semgrep: nothing to
    # upload is an answer, not a gate that could not run. Any other target
    # planning nothing still is one.
    if [ "$1" = sarif ]; then
      printf '%s: no SARIF-producing check runs in this repo; nothing to do\n' "$ME"
      return 0
    fi
    die "the image planned nothing for '$1'"
  fi

  state_init "$1"
  # However this ends -- a step's `die`, a signal -- the record is rendered from
  # whatever was finished. 2 because the only way out through here is a gate
  # that could not run; every ordinary ending goes through the call below.
  on_exit 'record_finish 2; unpin_hook_index'

  _n=$(printf '%s\n' "$_plan" | awk -F"$TAB" '!seen[$2]++ {n++} END {print n + 0}')
  # How many of those lanes run a container, which decides which executor can
  # keep the terminal live. Exactly one means everything else is waiting on
  # something that is not a CPU, so that one can stream.
  _oncpu=$(printf '%s\n' "$_plan" \
    | awk -F"$TAB" '$3 != "local" && !seen[$2]++ {n++} END {print n + 0}')
  # Its own name: shell variables are global, and run_serial's loop sets `_rc`
  # for every step. A deferred step's 3 survived into here and became the
  # exit status of a push that run_serial had passed.
  _plan_rc=0
  if [ "${_n:-1}" -le 1 ]; then
    run_serial "$_plan" || _plan_rc=$?
  elif [ "${_oncpu:-0}" -eq 1 ]; then
    run_split "$_plan" || _plan_rc=$?
  # Two or more, because lanes with no container between them (_oncpu 0) have
  # nothing to divide memory between, and lane_memory would divide by it.
  elif [ "$_oncpu" -ge 2 ] \
       && [ "$(lane_memory "$_oncpu" "${MEM_AVAILABLE:-0}" "$GATE_MEMORY_MB")" -eq 0 ]; then
    # Two containers that cannot both fit are not faster side by side: the
    # kernel kills one, and a killed CodeQL is a gate that could not run.
    printf '%s: %s lanes do not fit in the %sm this machine has; running them in turn\n' \
      "$ME" "$_oncpu" "${MEM_AVAILABLE:-0}"
    run_serial "$_plan" || _plan_rc=$?
  else
    run_lanes "$_plan" || _plan_rc=$?
  fi

  trap - EXIT HUP INT TERM
  record_finish "$_plan_rc"
  unpin_hook_index
  return "$_plan_rc"
}

# ---------------------------------------------------------------------- dispatch

# The one writable path the check job's uploader reads is for `sarif` alone.
# `sdlc ci` runs the repo's own code (pytest, conftest) in this same image, so
# every other target drops it, whoever exported it; run_in_image mounts it only
# while it is still set.
[ "${1:-}" = sarif ] || SDLC_HOST_SARIF=
# Nor does `sarif` get the cache volume: every other target writes it, with the
# repo's own code among them, so nothing on it is trusted next to that
# directory, and the scanners need none of it (CodeQL builds under /tmp).
if [ "${1:-}" = sarif ]; then
  CACHE_VOLUME=
fi

case "${1:---help}" in
  -h|--help|help)
    # Asked of git rather than written as `.git/sdlc`: in a linked worktree the
    # git directory is somewhere else entirely.
    STATE_HINT=$(git rev-parse --git-path sdlc 2>/dev/null) || STATE_HINT=
    [ -n "$STATE_HINT" ] || STATE_HINT='<git-dir>/sdlc'
    cat <<EOF
usage: $ME commit | push | ci | sarif | <check> | tiers | stacks | list | versions | codeql-baseline

  commit            the pre-commit hook: seconds, offline, free
  push              the pre-push hook: every verdict, no container builds
  ci                what CI runs: push's checks except the two reviewers,
                    plus the repo's own
  sarif             ci's CodeQL and semgrep, writing SARIF to the directory
                    SDLC_HOST_SARIF names, for the check job to upload
  <check>           one check by name -- the inner loop
  <check> -- <args> one check, with arguments for the tool itself, as:
                      $ME pytest -- tests/test_x.py::test_y -n0
  tiers             what each command runs in this repo
  stacks            which stacks this repo has: python, container, ...
  list              the built-in checks and the kinds
  versions          the exact tool versions the image carries
  codeql-baseline   accept every current CodeQL finding into the baseline

Configure each command in pyproject.toml, or in sdlc.toml in a repo without
one: [tool.sdlc.commit], [tool.sdlc.push], [tool.sdlc.ci]. Skip one check
once: SDLC_SKIP=name.
Exit 2 means a check COULD NOT RUN and is never to be worked around.
A push prints DEFERRED TO CI, and goes through, only when CodeQL itself broke
and the repo's \`sdlc ci\` job will judge the same commit.

Working a change, in the order that costs least:

  $ME commit && $ME push    every verdict, before spending a CI cycle on
                              a finding you could have read in two minutes
  $ME <check> -- <args>      reproduce one failure without rerunning the tier
  $STATE_HINT/last-push.json
                              what the last run cost, per check, and where
                              each buffered check's output went

Two things mislead people here. The Python running your tests is the image's,
not this machine's, so a result from a host 'pytest' says nothing about this
gate. And on a review finding CI triage is the authority, not this record,
which is only what happened on this machine last time.
Image: $IMAGE
EOF
    ;;
  tiers|stacks|list|versions) run_in_image ro nostdin "$IMAGE" "$1" ;;
  codeql-baseline)     run_in_image rw nostdin "$IMAGE" "$1" ;;
  *)
    _target=$1
    shift
    # Arguments for the check itself, after `--`. Without this, `sdlc pytest
    # tests/x.py` ran the WHOLE suite: the dispatcher passed "$1" to run_plan
    # and dropped everything after it, silently, so the one thing an agent
    # reaches for after a rejected push -- rerun just that test -- quietly did
    # the most expensive possible thing instead.
    #
    # Joined with the unit separator and handed over in the environment, like
    # SDLC_SKIP. It is NOT a plan field: the plan is the image telling this
    # script what to run, and `plain()` guards it so a repo's config can never
    # forge a line into this shell's argv. This goes the other way and lands in
    # a Python argv list, with no shell between here and the tool.
    case "$_target" in
      commit|push|ci|sarif)
        # A tier is several checks; arguments for "the check" have no meaning.
        # Cleared rather than refused when it merely arrives in the
        # environment, so an exported SDLC_ARGS cannot reach a tier's pytest.
        [ $# -eq 0 ] || die "$_target runs several checks; '--' arguments belong to a single check"
        SDLC_ARGS=
        ;;
      *)
        if [ $# -gt 0 ]; then
          [ "$1" = -- ] || die "unexpected argument '$1'; arguments for a check go after '--', as: $ME $_target -- <args>"
          shift
          [ $# -gt 0 ] || die "'--' with nothing after it; give the check's arguments, or drop it"
          SDLC_ARGS=
          for _a in "$@"; do
            # The one character that could not survive the round trip, refused
            # for the same reason the plan refuses it.
            case $_a in *"$US"*) die "an argument contains a control separator, which is refused" ;; esac
            SDLC_ARGS="${SDLC_ARGS:+$SDLC_ARGS$US}$_a"
          done
          export SDLC_ARGS
        fi
        ;;
    esac
    SDLC_DEPTH=0 run_plan "$_target"
    ;;
esac
