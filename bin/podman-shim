#!/bin/sh
# `podman` inside the sdlc image: there is no engine here, only the runner's
# socket, so every call goes to podman-remote on CONTAINER_HOST. The flags a
# local podman takes and the remote client refuses are dropped, in both the
# `--events-backend=VALUE` and the `--events-backend VALUE` form.
set -eu
url=${CONTAINER_HOST:-unix:///var/run/docker.sock}
first=1
skip=0
for arg in "$@"; do
  if [ "$first" = 1 ]; then set --; first=0; fi
  if [ "$skip" = 1 ]; then skip=0; continue; fi
  case $arg in
    --remote|--events-backend=*) ;;
    --events-backend) skip=1 ;;
    *) set -- "$@" "$arg" ;;
  esac
done
exec podman-remote --url "$url" "$@"
