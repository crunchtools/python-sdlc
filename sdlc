# Baked tool versions, read from the image rather than restated here. The
# Containerfile sets them as both ARGs and OCI labels; these env vars are how
# the running container sees them.
BAKED = {
    "gourmand": os.environ.get("SDLC_GOURMAND_VERSION", "unknown"),
    "gatehouse": os.environ.get("SDLC_GATEHOUSE_VERSION", "unknown"),
    "ruff": os.environ.get("SDLC_RUFF_VERSION", "unknown"),
    "semgrep": os.environ.get("SDLC_SEMGREP_VERSION", "unknown"),
    "pip-audit": os.environ.get("SDLC_PIP_AUDIT_VERSION", "unknown"),
    "codeql": os.environ.get("SDLC_CODEQL_BUNDLE", "unknown"),
    "uv": os.environ.get("SDLC_UV_VERSION", "unknown"),
}


VERSION_PROBE = {
    "gourmand": ["gourmand", "--version"],
    "ruff": ["ruff", "--version"],
    "semgrep": ["semgrep", "--version"],
    "pip-audit": ["pip-audit", "--version"],
    "codeql": ["codeql", "version", "--format=terse"],
    "uv": ["uv", "--version"],
    # gatehouse has no --version flag; its usage line is all it offers.
    "gatehouse": None,
}


def self_reported(name: str) -> str:
    """What the installed binary calls itself.

    Printed beside the pinned tag because they answer different questions and a
    consuming repo needs both. The pin is what CI must name; the self-reported
    version is what the tool actually is.

    They legitimately differ for a wrapper image: `crunchtools/gourmand:1.0.0`
    is that packaging repo's own first release, and the binary inside it is
    upstream mattdm/gourmand v0.16.5. Neither number is wrong -- but knowing
    only the tag tells you nothing about which upstream you are running, and
    knowing only the binary version tells you nothing you can pin.
    """
    probe = VERSION_PROBE.get(name)
    if probe is None:
        return "-"
    try:
        proc = subprocess.run(probe, check=False, capture_output=True, text=True, timeout=30)
    except OSError, subprocess.SubprocessError:
        return "(cannot probe)"
    out = (proc.stdout or proc.stderr or "").strip().splitlines()
    return out[0] if out else "(no output)"


# The exit-code contract, named rather than written as literals at each site.
CLEAN = 0
FOUND = 1
CANNOT_RUN = 2
DEFERRED = 3


class CannotRunError(Exception):
    """Raised for anything that is not the tool's own verdict. Becomes exit CANNOT_RUN."""


class DeferredError(Exception):
    """Could not run, and CI will judge the same commit. Becomes exit DEFERRED."""


def cannot(msg: str) -> NoReturn:
    raise CannotRunError(msg)


def step(msg: str) -> None:
    print(f"\n== {msg}", flush=True)


# --------------------------------------------------------------- repo settings


def pyproject() -> dict:
    """The repo's pyproject.toml, or {} when it has none.

    A repo with NO pyproject.toml is not an error here. `constitution`,
    `gourmand` and `gatehouse` are language-agnostic, and this image's own repo
    has none of its own policy to state. The Python-specific checks assert the
    project separately, through `need_project()`.
    """
    path = REPO / "pyproject.toml"
    if not path.is_file():
        return {}
    try:
        return tomllib.loads(path.read_text(encoding="utf-8"))
    except (OSError, tomllib.TOMLDecodeError) as exc:
        cannot(f"cannot read {path}: {exc}")


# ------------------------------------------------------------ the three commands
#
# One rule for all three config blocks, so what you read is what runs:
#
#   [tool.sdlc.commit]   `sdlc commit`, the pre-commit hook
#   [tool.sdlc.push]     `sdlc push`, the pre-push hook
#   [tool.sdlc.ci]       `sdlc ci`, the CI job named `sdlc ci`
#
# Each command runs its defaults. A block's `checks` ADDS to them and its `skip`
# removes from them. A check that needs settings has its own table,
# `[tool.sdlc.<command>.<check>]`, and a check the image does not have built in
# must say what `kind` it is. `sdlc tiers` prints exactly what will run.

COMMANDS = ("commit", "push", "ci")

DEFAULTS = {
    # Seconds, offline, free: what rewrites your code, the structural review
    # that is cheap enough to sit beside it, plus the one check that notices the
    # push hook was never installed.
    #
    # Gourmand runs AFTER the two ruff steps, so it judges the formatted tree
    # rather than the one you typed. It is here because its findings are
    # deterministic -- the same tree gives the same answer, with no model and no
    # network -- so paying for them at push, where each rejection costs a
    # six-to-eight minute cycle, was paying the wrong price. Measured at 1.7s on
    # this repo and 3.2s on trentina, warm, in full mode. It stays in push too:
    # a commit can be made with --no-verify, and push is the tier that renders
    # the verdicts.
    "commit": ["ruff-check", "ruff-format", "gourmand", "hooks-installed"],
    # Everything that renders a verdict, once, over origin/<default>...HEAD.
    # Never a container build: that is minutes, and a push you wait minutes for
    # is a push people stop making.
    "push": [
        "mypy",
        "pytest",
        "gourmand",
        "gatehouse",
        "semgrep",
        "pip-audit",
        "constitution",
        "codeql",
    ],
}

# CI runs push's checks except these two, which it gets from their own
# workflows: Gatehouse's posts PR comments and must never be a blocking check,
# and the constitution requires Gourmand's CI job to be the shared reusable one.
# Running them again here would pay twice and make the reviewer blocking.
CI_EXCLUDES = ("gourmand", "gatehouse")

# Built-in checks that are a question about the developer's clone or need its
# git credentials, so bin/sdlc answers them on the host.
LOCAL_CHECKS = ("hooks-installed", "gatehouse")

# Built-in checks that write the tree. ruff rewrites your source, which is the
# point; gourmand writes .gourmand-cache/ and fails on a read-only mount.
WRITES_TREE = ("ruff-check", "ruff-format", "gourmand")

# Words that are commands of this script, so no check may be named one.
RESERVED = (*COMMANDS, "plan", "tiers", "list", "versions", "pytest-deps", "codeql-baseline")


def sdlc_config() -> dict:
    """`[tool.sdlc]`, checked for shape before anything trusts it."""
    cfg = pyproject().get("tool", {}).get("sdlc", {}) or {}
    stray = sorted(set(cfg) - set(COMMANDS) - {"project"})
    if stray:
        cannot(
            f"[tool.sdlc] has {', '.join(stray)}; the only keys are "
            f"[tool.sdlc.commit], [tool.sdlc.push], [tool.sdlc.ci] and `project`"
        )
    project_dir()  # validated here, so a bad path is caught on the next commit
    # The WHOLE config is checked whichever command runs, so a typo in the ci
    # block is found on the next commit rather than in CI.
    for command in COMMANDS:
        for check in resolve(cfg, command):
            kind_of(cfg, check)
    return cfg


def block(cfg: dict, command: str) -> dict:
    value = cfg.get(command, {})
    if not isinstance(value, dict):
        cannot(f"[tool.sdlc.{command}] must be a table")
    return value


def names(value: object, where: str) -> list[str]:
    if value is None:
        return []
    if not isinstance(value, list) or not all(isinstance(v, str) for v in value):
        cannot(f"{where} must be a list of check names")
    return list(value)


def skipped() -> set[str]:
    """`SDLC_SKIP=gatehouse,codeql` -- the escape hatch for one false positive.

    The push tier is one pre-commit hook now, so pre-commit's own `SKIP=` would
    skip all of it or none of it. A finding skipped here still has to be
    answered on the pull request.
    """
    return {s.strip() for s in os.environ.get("SDLC_SKIP", "").split(",") if s.strip()}


def resolve(cfg: dict, command: str) -> list[str]:
    """The checks `command` runs in this repo, in order."""
    if command == "ci":
        base = [c for c in resolve(cfg, "push") if c not in CI_EXCLUDES]
    else:
        base = list(DEFAULTS[command])
    own = block(cfg, command)
    drop = set(names(own.get("skip"), f"[tool.sdlc.{command}] skip"))
    if command == "ci":
        # XII: "CI runs push's checks except Gourmand and Gatehouse". Those two
        # are CI_EXCLUDES, decided by this image and not by a repo. Skipping any
        # other verdict HERE leaves it on the one tier nothing enforces: pre-push
        # runs on a developer's machine and `--no-verify` is one flag, while the
        # required `sdlc ci` still reports green. 24 of the 33 converted repos
        # skipped `codeql` exactly this way, each with a comment claiming the
        # CodeQL Action covered it; the Action was a required check in one of
        # them, advisory in 21, and absent from pull requests entirely in two.
        #
        # A check the repo does not want in CI at all belongs out of
        # [tool.sdlc.push] too, where the choice is visible in one place instead
        # of being a difference between two tiers nobody reads side by side.
        verdicts = sorted(drop & (set(DEFAULTS["push"]) - set(CI_EXCLUDES)))
        if verdicts:
            cannot(
                f"[tool.sdlc.ci] skip names {', '.join(verdicts)}, which the push "
                f"tier renders a verdict with. CI may not skip a verdict "
                f"(constitution XII): only {' and '.join(CI_EXCLUDES)} run through "
                f"their own workflows, and this image decides that, not a repo. "
                f"Skip a check the repo added itself, or take it out of "
                f"[tool.sdlc.push] as well."
            )
    else:
        drop |= skipped()
    out = [c for c in base if c not in drop]
    for name in names(own.get("checks"), f"[tool.sdlc.{command}] checks"):
        if name not in out:
            out.append(name)
    return out


def check_settings(cfg: dict, name: str) -> dict:
    """A check's own table, wherever it is written. Names are unique."""
    found = [
        (command, tbl)
        for command in COMMANDS
        for key, tbl in block(cfg, command).items()
        if key == name and isinstance(tbl, dict)
    ]
    if len(found) > 1:
        cannot(f"{name} has a settings table in more than one block; check names are unique")
    return found[0][1] if found else {}


def kind_of(cfg: dict, name: str) -> str | None:
    """None for a built-in check; the kind for a repo's own."""
    settings = check_settings(cfg, name)
    if name in BUILTINS:
        if "kind" in settings:
            cannot(f"{name} is built in; its table cannot set a kind")
        return None
    if name in RESERVED:
        cannot(f"{name} is a command of this tool and cannot be a check name")
    kind = settings.get("kind")
    if kind is not None and not isinstance(kind, str):
        cannot(f"{name}: kind must be a name, one of {', '.join(KINDS)}")
    if kind is None:
        cannot(
            f"{name} is not a built-in check, so it needs a table "
            f"[tool.sdlc.<command>.{name}] that says what kind it is "
            f"(one of: {', '.join(KINDS)})"
        )
    if kind not in KINDS:
        cannot(f"{name} has kind {kind!r}; the kinds are {', '.join(KINDS)}")
    return kind


# -------------------------------------------------------------------- the plan
#
# The host half (bin/sdlc) is POSIX shell and cannot read TOML, so it asks this
# script what to do and then does it. One line per step, four fields split by a
# tab:
#
#     <check> TAB <lane> TAB <mode> TAB <payload>
#
# where lane is the group the step runs in -- see "the lanes" below -- and mode
# is:
#     image-ro / image-rw   run `sdlc <payload>` in this image, tree ro or rw
#     local                 bin/sdlc's own check named <payload>
#     host                  <payload> is a podman argv, its words joined by
#                           the ASCII unit separator (0x1f)
#
# bin/sdlc refuses a host line that does not start with `podman`, so the host
# contract is held by the launcher rather than trusted to the config. It splits
# the argv on the separator and never `eval`s it, and no field may contain a
# tab, a newline or the separator: a config value carrying one could otherwise
# forge a second plan line, which is how a repo's TOML would reach the host's
# shell.

UNIT_SEPARATOR = "\x1f"
FORBIDDEN_IN_PLAN = ("\t", "\n", "\r", UNIT_SEPARATOR)


def plain(value: str, where: str) -> str:
    if any(c in value for c in FORBIDDEN_IN_PLAN):
        cannot(f"{where} contains a tab, a newline or a control separator, which is refused")
    return value


def host_step(name: str, argv: list[str]) -> tuple[str, str, str]:
    return (name, "host", UNIT_SEPARATOR.join(plain(a, name) for a in argv))


def plan_lines(cfg: dict, check: str) -> list[tuple[str, str, str]]:
    kind = kind_of(cfg, check)
    if kind is not None:
        return KINDS[kind](check, check_settings(cfg, check))
    if check in LOCAL_CHECKS:
        return [(check, "local", check)]
    return [(check, "image-rw" if check in WRITES_TREE else "image-ro", check)]


# ------------------------------------------------------------------- the lanes
#
# `sdlc ci` used to run every check one after another, so trentina's image build
# -- which depends on none of mypy, pytest, semgrep or pip-audit -- waited for
# all four. The job took the sum of its checks instead of the length of its
# longest chain: 5m09s on a self-hosted runner, 16m05s on a GitHub-hosted one.
#
# So each plan line carries a lane. Steps of one lane run in sequence, in plan
# order; lanes run at the same time. The decision is made HERE, in the image,
# because this is the half that knows what each check does -- bin/sdlc only
# carries it out, and no check name appears in that file.
#
# Two rules, and neither names a repo:
#
#   - An `image-build` check and every `pytest-in-image` check that runs the
#     image it tags are ONE lane. The build has to finish before the tests
#     start, and two builds writing one tag must not race, so a shared tag is a
#     shared lane.
#   - Everything else goes in MAIN_LANE, in plan order. That is where `uv sync`
#     happens: mypy, pytest and pip-audit each sync the project venv in the
#     shared cache volume, and one lane makes those sequential. uv does lock the
#     target environment (uv 0.13, "Cache safety"), but a gate should not bet
#     its venv on a lock it did not take.
#
# And one refusal: a command that REWRITES THE TREE gets no lanes at all. ruff
# rewrites your source and gourmand writes its cache, and a build context or an
# in-image mount reading those files while they change is a check judging a tree
# that no longer exists. `sdlc commit` is ruff, so commit is always sequential,
# which is what "seconds, offline, free" wanted anyway.
#
# A repo with no image-build check therefore gets one lane, and one lane is the
# launcher's sequential path -- the same run, the same output, as before lanes
# existed. `sdlc push` has no image chain either, so push is unchanged too.

MAIN_LANE = "main"
REVIEW_LANE = "review"

# Checks that run beside anything, including a command that rewrites the tree.
#
# The one-lane rule above protects readers of the TREE. Gatehouse does not read
# the tree: its input is `git diff origin/<default>...HEAD`, committed objects
# that bin/sdlc computes on the host before the container starts and pipes in on
# stdin. So ruff can be rewriting your source while Gatehouse reviews the diff
# and neither notices the other.
#
# It is also the only check whose time is not CPU -- it is one API call and then
# waiting -- which is why it is worth moving. On push it was 35 seconds of a
# six-to-eight minute tier spent with the CPUs idle. The launcher gives a lane
# with no containers in it a single CPU and divides the budget between the rest,
# so the main lane keeps the whole budget it had and this costs nothing to
# overlap. That is the difference from the lanes that were measured as a
# regression: those were two CPU-bound lanes splitting one budget.
TREE_INDEPENDENT = ("gatehouse",)


def lane_of(cfg: dict, checks: list[str]) -> dict[str, str]:
    """check -> lane, for one command's resolved check list.

    An image chain is keyed by the image reference, not by position: a
    `pytest-in-image` may be listed before the `image-build` that makes what it
    runs, and two builds may legitimately produce two different tags.
    """
    # Nothing runs beside a check that rewrites the tree -- except the ones that
    # do not read it.
    if any(check in WRITES_TREE for check in checks):
        return {c: REVIEW_LANE if c in TREE_INDEPENDENT else MAIN_LANE for c in checks}
    lanes: dict[str, str] = {}
    by_tag: dict[str, str] = {}
    for check in checks:
        if kind_of(cfg, check) != "image-build":
            continue
        tag = str(check_settings(cfg, check).get("tag", default_image_tag()))
        lanes[check] = by_tag.setdefault(tag, check)
    for check in checks:
        if kind_of(cfg, check) != "pytest-in-image":
            continue
        image = str(check_settings(cfg, check).get("image", default_image_tag()))
        # No build of that image in this command: the repo is testing something
        # already built, so it owes nothing to another lane and gets its own.
        lanes[check] = by_tag.get(image, check)
    for check in checks:
        if check in TREE_INDEPENDENT:
            lanes[check] = REVIEW_LANE
    return {check: lanes.get(check, MAIN_LANE) for check in checks}


def t_plan(target: str) -> int:
    cfg = sdlc_config()
    checks = resolve(cfg, target) if target in COMMANDS else [target]
    for check in checks:
        if check not in BUILTINS and kind_of(cfg, check) is None:
            cannot(f"unknown check: {check}")
    lanes = lane_of(cfg, checks)
    for check in checks:
        lane = plain(lanes[check], "a lane name")
        for name, mode, payload in plan_lines(cfg, check):
            plain(name, "a check name")
            if mode != "host":
                plain(payload, name)
            print(f"{name}\t{lane}\t{mode}\t{payload}")
    return CLEAN


def t_tiers() -> int:
    cfg = sdlc_config()
    for command in COMMANDS:
        checks = resolve(cfg, command)
        lanes = lane_of(cfg, checks)
        parallel = len(set(lanes.values())) > 1
        print(f"sdlc {command}:")
        for check in checks:
            kind = kind_of(cfg, check)
            note = f"  ({kind})" if kind else ""
            if parallel:
                note += f"  [lane {lanes[check]}]"
            print(f"  {check}{note}")
        if parallel:
            print(f"  {len(set(lanes.values()))} lanes, run at the same time")
    if skipped():
        print(f"\nSDLC_SKIP is skipping: {', '.join(sorted(skipped()))}")
    return CLEAN


# ------------------------------------------------------------------- the kinds
#
# A repo's own checks are named kinds with parameters, never shell. A repo that
# needs something these cannot express gets a new kind HERE, so the config
# stays something a person can read.


def project_name() -> str:
    return os.environ.get("SDLC_PROJECT", REPO.name)


def default_image_tag() -> str:
    return f"localhost/{project_name()}:sdlc"


def token(value: object) -> str:
    """Resolve `@project.version`, `@git.sha` and `@now`; pass anything else."""
    text = str(value)
    if not text.startswith("@"):
        return text
    if text == "@project.version":
        version = pyproject().get("project", {}).get("version")
        if not version:
            cannot("@project.version: pyproject.toml has no [project] version")
        return str(version)
    if text == "@git.sha":
        try:
            proc = subprocess.run(
                ["git", "-c", "safe.directory=*", "rev-parse", "HEAD"],
                cwd=REPO,
                capture_output=True,
                text=True,
                check=False,
            )
        except OSError as exc:
            cannot(f"@git.sha: cannot run git: {exc}")
        if proc.returncode != 0 or not proc.stdout.strip():
            cannot("@git.sha: git could not read HEAD")
        return proc.stdout.strip()
    if text == "@now":
        return datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
    cannot(f"unknown value {text}; known: @project.version, @git.sha, @now")


def in_repo(name: str, key: str, value: object) -> str:
    """A repo-relative path that stays inside the repo, or a refusal.

    A setting that names a path is repo-controlled, and these paths reach a
    host bind mount or a build context. `../../.config` or `/` would hand the
    host's files to the repo's own code, so anything absolute or outside the
    tree is refused.
    """
    text = str(value)
    target = (REPO / text).resolve()
    if Path(text).is_absolute() or not target.is_relative_to(REPO.resolve()):
        cannot(f"{name}: {key} {text!r} is outside the repository")
    if not target.exists():
        cannot(f"{name}: {key} {text!r} does not exist")
    return str(target.relative_to(REPO.resolve())) or "."


def table(settings: dict, key: str) -> dict:
    value = settings.get(key, {})
    if not isinstance(value, dict):
        cannot(f"{key} must be a table")
    return value


def kind_image_build(name: str, settings: dict) -> list[tuple[str, str, str]]:
    """Build the repo's image and leave it at a known tag.

    The tag is what `pytest-in-image` runs and what a CI publish step picks up,
    so the image that is published is the image that was tested.
    """
    containerfile = in_repo(name, "containerfile", settings.get("containerfile", "Containerfile"))
    context = in_repo(name, "context", settings.get("context", "."))
    argv = ["podman", "build", "-f", containerfile]
    for key, value in table(settings, "build_args").items():
        argv += ["--build-arg", f"{key}={token(value)}"]
    for key, value in table(settings, "labels").items():
        argv += ["--label", f"{key}={token(value)}"]
    argv += ["-t", str(settings.get("tag", default_image_tag())), context]
    return [host_step(name, argv)]


def kind_pytest_in_image(name: str, settings: dict) -> list[tuple[str, str, str]]:
    """Run tests INSIDE the built image, locked down the way production runs it.

    For tests that only mean something there: that a native library loads in a
    slim runtime, that the server starts and answers. pytest is not added to the
    image -- it is installed once into the cache volume, at the versions the
    repo's own uv.lock pins, and put on PYTHONPATH.
    """
    tests = names(settings.get("tests"), f"{name}.tests")
    if not tests:
        cannot(f"{name}: tests is required -- the paths to run inside the image")
    host = os.environ.get("SDLC_HOST_REPO")
    volume = os.environ.get("SDLC_CACHE_VOLUME")
    if not host or not volume:
        cannot(f"{name}: run through bin/sdlc, which supplies the host paths")
    argv = [
        "podman",
        "run",
        "--rm",
        "--read-only",
        "--tmpfs",
        "/tmp:rw,exec,size=2g,mode=1777",
        "--cap-drop=all",
        "--security-opt",
        "no-new-privileges",
        "-v",
        f"{volume}:/sdlc-cache:ro",
        "-e",
        f"PYTHONPATH=/sdlc-cache/pytest/{project_name()}",
        "-e",
        "HOME=/tmp",
        # The same reason as bin/sdlc's run_in_image: this mounts the repo's
        # test files, so without a prefix pytest reads bytecode the host
        # compiled and judges paths that do not exist in here.
        "-e",
        "PYTHONPYCACHEPREFIX=/tmp/pycache",
        "-w",
        "/repo",
        "--entrypoint",
        "python",
    ]
    if not settings.get("network", False):
        argv += ["--network", "none"]
    for mount in names(settings.get("mounts", ["tests"]), f"{name}.mounts"):
        rel = in_repo(name, "mount", mount)
        argv += ["-v", f"{host}/{rel}:/repo/{rel}:ro,z"]
    for key, value in table(settings, "env").items():
        argv += ["-e", f"{key}={token(value)}"]
    argv += [str(settings.get("image", default_image_tag()))]
    argv += ["-m", "pytest", "-p", "no:cacheprovider"]
    argv += names(settings.get("args", ["-q", "-rfE"]), f"{name}.args")
    argv += tests
    return [(name, "image-ro", "pytest-deps"), host_step(name, argv)]


