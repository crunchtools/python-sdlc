def t_pytest(s: dict) -> int:
    need_project()
    need_lock_dep("pytest")
    env = project_env()
    for key, value in table(s, "env").items():
        env[str(key)] = token(value)
    sync_project(env)
    jobs = os.environ.get("SDLC_JOBS", "0")
    args = names(s.get("args", ["-q", "-rfE"]), "pytest.args")
    extra = passthrough()
    step("pytest" + ("".join(f" {a}" for a in extra) if extra else ""))
    cmd = [
        "uv",
        "run",
        "--locked",
        "--all-extras",
        "pytest",
        # The worktree is read-only and cacheprovider writes into the rootdir.
        "-p",
        "no:cacheprovider",
        *args,
    ]
    if jobs != "0" and "pytest-xdist" in (project_dir() / "uv.lock").read_text(encoding="utf-8"):
        cmd += ["-n", jobs]
    # LAST, after the config's args and after `-n`, so what the caller asked
    # for on the command line wins: `-- -n0` turns off the parallelism this
    # just added, which is how you read a traceback.
    cmd += extra
    return run(cmd, env=env, cwd=project_dir())[0]


GOURMAND_SIDECARS = (
    "gourmand-exceptions.toml",
    "gourmand-patterns.toml",
    "gourmand-audit-ledger.toml",
)
"""Files gourmand resolves RELATIVE TO gourmand.toml, so each one needs it to exist."""


def gourmand_orphan(root: Path) -> str | None:
    """The sidecar file that would be ignored for want of a gourmand.toml, if there is one."""
    if (root / "gourmand.toml").is_file():
        return None
    return next((name for name in GOURMAND_SIDECARS if (root / name).is_file()), None)


def t_gourmand(s: dict) -> int:
    # With no gourmand.toml, a sidecar file is found on disk, never parsed, and nothing is
    # said about it: the gate goes red listing violations you already justified, which reads
    # exactly like a wrong justification, so the natural response is to rewrite the
    # justification. That cost an evening on this repository before the cause was spotted,
    # and 26 repositories carry an exceptions file. A 2, not a warning: a check that cannot
    # do what it was configured to do must not report as though it did, and a warning
    # scrolls past on a long run with the violation list underneath it.
    orphan = gourmand_orphan(REPO)
    if orphan:
        cannot(
            f"found {orphan} but no gourmand.toml beside it, so no entry in it would be "
            f"loaded. Add a gourmand.toml (an empty [output] table is enough) or remove "
            f"{orphan}"
        )
    step("gourmand check --full")
    return run(["gourmand", "check", "--full", "."])[0]


def t_gatehouse(s: dict) -> int:
    """Review the branch. The diff arrives on stdin, computed by the host.

    It is the host's job because the diff needs origin fetched, which needs the
    developer's git credentials and network -- neither of which belongs in this
    container.
    """
    diff = sys.stdin.buffer.read()
    if not diff.strip():
        print("nothing to review: the diff is empty")
        return 0
    samples = os.environ.get("SDLC_GATEHOUSE_SAMPLES")
    cmd = ["gatehouse", "--stdin"]
    if samples:
        cmd += ["--samples", samples]
    step(f"gatehouse --stdin ({len(diff)} bytes)")
    return run(cmd, stdin=diff)[0]


