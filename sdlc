def sdlc_config() -> dict:
    """`[tool.sdlc]`, checked for shape before anything trusts it."""
    cfg = config_document().get("tool", {}).get("sdlc", {}) or {}
    stray = sorted(
        set(cfg)
        - set(COMMANDS)
        # `images` is the image job's [[tool.sdlc.images]]: sdlc_jobs checks it.
        - {"project", "stacks", "skip-stacks", "image", "images", "publish", "repo-kinds"}
    )
    if stray:
        cannot(
            f"[tool.sdlc] has {', '.join(stray)}; the only keys are "
            f"[tool.sdlc.commit], [tool.sdlc.push], [tool.sdlc.ci], `project`, "
            f"`stacks`, `skip-stacks`, `image`, `publish` and `repo-kinds`"
        )
    if "publish" in cfg and cfg["publish"] not in PUBLISH_TARGETS:
        cannot(f'[tool.sdlc] publish must be "pypi", not {cfg["publish"]!r}')
    config_image(cfg)
    project_dir()  # validated here, so a bad path is caught on the next commit
    stacks = active_stacks(cfg)
    # The WHOLE config is checked whichever command runs, so a typo in the ci
    # block is found on the next commit rather than in CI.
    for command in COMMANDS:
        for check in resolve(cfg, command, stacks):
            kind_of(cfg, check)
    return cfg


# `[tool.sdlc] image = "main"` runs a tag of the fleet image instead of the
# pinned release. bin/sdlc chooses the image before this script exists, so it
# reads the key itself -- with awk, as one `image = "<tag>"` line under
# [tool.sdlc] -- and passes what it read as SDLC_CONFIG_IMAGE. TOML has other
# ways to write the same key, and a launcher that missed one would run the
# pinned release while the repo believed it ran main, so the two readings must
# agree or nothing runs.
IMAGE_TAG_RE = re.compile(r"[A-Za-z0-9_][A-Za-z0-9._-]{0,127}")


def config_image(cfg: dict) -> None:
    # A table is the image job's settings (`[tool.sdlc.image]`, which
    # scripts/convert_repo.py writes), and sdlc_jobs/image.py reads it.
    # bin/sdlc's awk reads only a line directly under [tool.sdlc], so it never
    # takes the table for a tag.
    if isinstance(cfg.get("image"), dict):
        if os.environ.get("SDLC_CONFIG_IMAGE"):
            cannot("bin/sdlc read a [tool.sdlc] image tag; TOML has a [tool.sdlc.image] table")
        return
    if "image" not in cfg:
        seen = os.environ.get("SDLC_CONFIG_IMAGE")
        if "SDLC_HOST_REPO" in os.environ and seen:
            cannot(f"bin/sdlc read [tool.sdlc] image = {seen!r} where TOML has none")
        return
    tag = cfg["image"]
    if not isinstance(tag, str) or not IMAGE_TAG_RE.fullmatch(tag):
        cannot(f"[tool.sdlc] image must be a tag such as main or 0.8.0; got {tag!r}")
    # Deprecated: the key is the image job's table now, and TOML holds one or the
    # other. SDLC_IMAGE=<tag> chooses the same image on a seat and needs no file.
    print(
        f"sdlc: [tool.sdlc] image = {tag!r} is deprecated; export SDLC_IMAGE={tag} instead. "
        f"The key is now the image job's [tool.sdlc.image] table.",
        file=sys.stderr,
    )
    if "SDLC_HOST_REPO" in os.environ and os.environ.get("SDLC_CONFIG_IMAGE") != tag:
        cannot(
            f"[tool.sdlc] image is {tag!r} but bin/sdlc could not read it, so it "
            f"would have run the pinned release. Write it on its own line directly "
            f'under [tool.sdlc]: image = "{tag}"'
        )


def block(cfg: dict, command: str) -> dict:
    value = cfg.get(command, {})
    if not isinstance(value, dict):
        cannot(f"[tool.sdlc.{command}] must be a table")
    return value


def names(value: object, where: str) -> list[str]:
    if value is None:
        return []
    if not isinstance(value, list) or not all(isinstance(v, str) for v in value):
        cannot(f"{where} must be a list of check names")
    return list(value)


def skipped() -> set[str]:
    """`SDLC_SKIP=gatehouse,codeql` -- the escape hatch for one false positive.

    The push tier is one pre-commit hook now, so pre-commit's own `SKIP=` would
    skip all of it or none of it. A finding skipped here still has to be
    answered on the pull request.
    """
    return {s.strip() for s in os.environ.get("SDLC_SKIP", "").split(",") if s.strip()}


def resolve(cfg: dict, command: str, stacks: tuple[str, ...] = COMPAT_STACKS) -> list[str]:
    """The checks `command` runs in this repo, in order.

    `stacks` defaults to the python stack alone, which is what every repo ran
    before stacks existed; the planner passes `active_stacks(cfg)`.
    """
    if command == "ci":
        base = [c for c in resolve(cfg, "push", stacks) if c not in CI_EXCLUDES]
        base += [c for c in CI_DEFAULTS if in_stacks(c, stacks)]
    else:
        base = [c for c in DEFAULTS[command] if in_stacks(c, stacks)]
    own = block(cfg, command)
    drop = set(names(own.get("skip"), f"[tool.sdlc.{command}] skip"))
    if command == "ci":
        # XII: "CI runs push's checks except Gourmand and Gatehouse". Those two
        # are CI_EXCLUDES, decided by this image and not by a repo. Skipping any
        # other verdict HERE leaves it on the one tier nothing enforces: pre-push
        # runs on a developer's machine and `--no-verify` is one flag, while the
        # required `sdlc ci` still reports green. 24 of the 33 converted repos
        # skipped `codeql` exactly this way, each with a comment claiming the
        # CodeQL Action covered it; the Action was a required check in one of
        # them, advisory in 21, and absent from pull requests entirely in two.
        #
        # A check the repo does not want in CI at all belongs out of
        # [tool.sdlc.push] too, where the choice is visible in one place instead
        # of being a difference between two tiers nobody reads side by side.
        verdicts = sorted(drop & (set(DEFAULTS["push"]) - set(CI_EXCLUDES)))
        if verdicts:
            cannot(
                f"[tool.sdlc.ci] skip names {', '.join(verdicts)}, which the push "
                f"tier renders a verdict with. CI may not skip a verdict "
                f"(constitution XII): only {' and '.join(CI_EXCLUDES)} run through "
                f"their own workflows, and this image decides that, not a repo. "
                f"Skip a check the repo added itself, or take it out of "
                f"[tool.sdlc.push] as well."
            )
    else:
        drop |= skipped()
    out = [c for c in base if c not in drop]
    for name in names(own.get("checks"), f"[tool.sdlc.{command}] checks"):
        if name not in out:
            out.append(name)
    return out


def push_skips(cfg: dict, stacks: tuple[str, ...] = COMPAT_STACKS) -> list[str]:
    """The push verdicts ci does not run because [tool.sdlc.push] skips them.

    That skip is the only way a repo takes a verdict out of ci, and a verdict
    that is not run is otherwise just absent: a green `sdlc ci` read the same
    whether the repo ran lint or opted out of it (#50).
    """
    drop = set(names(block(cfg, "push").get("skip"), "[tool.sdlc.push] skip"))
    ci = resolve(cfg, "ci", stacks)
    return [
        c
        for c in DEFAULTS["push"]
        if c in drop and c not in CI_EXCLUDES and c not in ci and in_stacks(c, stacks)
    ]


def push_skip_line(cfg: dict, stacks: tuple[str, ...] = COMPAT_STACKS) -> str | None:
    gone = push_skips(cfg, stacks)
    return f"sdlc ci: not run, skipped in [tool.sdlc.push]: {', '.join(gone)}" if gone else None


def check_settings(cfg: dict, name: str) -> dict:
    """A check's own table, wherever it is written. Names are unique."""
    found = [
        (command, tbl)
        for command in COMMANDS
        for key, tbl in block(cfg, command).items()
        if key == name and isinstance(tbl, dict)
    ]
    if len(found) > 1:
        cannot(f"{name} has a settings table in more than one block; check names are unique")
    return found[0][1] if found else {}


def kind_of(cfg: dict, name: str) -> str | None:
    """None for a built-in check; the kind for a repo's own."""
    settings = check_settings(cfg, name)
    if name in BUILTINS:
        if "kind" in settings:
            cannot(f"{name} is built in; its table cannot set a kind")
        return None
    if name in RESERVED:
        cannot(f"{name} is a command of this tool and cannot be a check name")
    kind = settings.get("kind")
    if kind is not None and not isinstance(kind, str):
        cannot(f"{name}: kind must be a name, one of {', '.join(KINDS)}")
    if kind is None:
        cannot(
            f"{name} is not a built-in check, so it needs a table "
            f"[tool.sdlc.<command>.{name}] that says what kind it is "
            f"(one of: {', '.join(KINDS)})"
        )
    if kind not in KINDS:
        cannot(f"{name} has kind {kind!r}; the kinds are {', '.join(KINDS)}")
    return kind


# -------------------------------------------------------------------- the plan
#
# The host half (bin/sdlc) is POSIX shell and cannot read TOML, so it asks this
# script what to do and then does it. One line per step, four fields split by a
# tab:
#
#     <check> TAB <lane> TAB <mode> TAB <payload>
#
# where lane is the group the step runs in -- see "the lanes" below -- and mode
# is:
#     image-ro / image-rw   run `sdlc <payload>` in this image, tree ro or rw
#     local                 bin/sdlc's own check named <payload>
#     host                  <payload> is a podman argv, its words joined by
#                           the ASCII unit separator (0x1f)
#     host-up               the same, after a first word that is a number of
#                           seconds: a `podman run` that is still running when
#                           they are up is a pass (container-smoke)
#     host-up-advisory      host-up whose finding is printed as ADVISORY and
#                           does not fail the command (container-smoke without
#                           `gate = true`)
#     host-systemd          seconds, then argv GROUPS split by the step
#                           separator 0x1a: a `podman run` of an image with
#                           systemd as PID 1, the `podman exec` options, the
#                           readiness probe polled for up to <seconds>, and the
#                           steps exec'd in order (`command` with systemd)
#
# bin/sdlc refuses a host line that does not start with `podman`, so the host
# contract is held by the launcher rather than trusted to the config. It splits
# the argv on the separator and never `eval`s it, and no field may contain a
# tab, a newline or the separator: a config value carrying one could otherwise
# forge a second plan line, which is how a repo's TOML would reach the host's
# shell.

UNIT_SEPARATOR = "\x1f"
# Between the argv groups of one host-systemd step. Refused in any value, as the
# unit separator is, so a config word cannot start a group of its own. Not the
# ASCII record separator (0x1e): Python's splitlines() breaks a line there, and
# the image job reads this plan with it.
STEP_SEPARATOR = "\x1a"
# Modes whose payload is a separator-joined argv, already checked word by word.
HOST_MODES = ("host", "host-up", "host-up-advisory", "host-systemd")
FORBIDDEN_IN_PLAN = ("\t", "\n", "\r", UNIT_SEPARATOR, STEP_SEPARATOR)


def plain(value: str, where: str) -> str:
    if any(c in value for c in FORBIDDEN_IN_PLAN):
        cannot(f"{where} contains a tab, a newline or a control separator, which is refused")
    return value


def host_step(name: str, argv: list[str]) -> tuple[str, str, str]:
    return (name, "host", UNIT_SEPARATOR.join(plain(a, name) for a in argv))


def plan_lines(cfg: dict, check: str) -> list[tuple[str, str, str]]:
    kind = kind_of(cfg, check)
    if kind is not None:
        return KINDS[kind](check, check_settings(cfg, check))
    if check in HOST_CHECKS:
        return HOST_CHECKS[check](cfg, check, check_settings(cfg, check))
    if check in LOCAL_CHECKS:
        return [(check, "local", check)]
    return [(check, "image-rw" if check in WRITES_TREE else "image-ro", check)]


# ------------------------------------------------------------------- the lanes
#
# `sdlc ci` used to run every check one after another, so trentina's image build
# -- which depends on none of mypy, pytest, semgrep or pip-audit -- waited for
# all four. The job took the sum of its checks instead of the length of its
# longest chain: 5m09s on a self-hosted runner, 16m05s on a GitHub-hosted one.
#
# So each plan line carries a lane. Steps of one lane run in sequence, in plan
# order; lanes run at the same time. The decision is made HERE, in the image,
# because this is the half that knows what each check does -- bin/sdlc only
# carries it out, and no check name appears in that file.
#
# Two rules, and neither names a repo:
#
#   - An `image-build` check and every `pytest-in-image` check that runs the
#     image it tags are ONE lane. The build has to finish before the tests
#     start, and two builds writing one tag must not race, so a shared tag is a
#     shared lane.
#   - Everything else goes in MAIN_LANE, in plan order. That is where `uv sync`
#     happens: mypy, pytest and pip-audit each sync the project venv in the
#     shared cache volume, and one lane makes those sequential. uv does lock the
#     target environment (uv 0.13, "Cache safety"), but a gate should not bet
#     its venv on a lock it did not take.
#
# And one refusal: a command that REWRITES THE TREE gets no lanes at all. ruff
# rewrites your source and gourmand writes its cache, and a build context or an
# in-image mount reading those files while they change is a check judging a tree
# that no longer exists. `sdlc commit` is ruff, so commit is always sequential,
# which is what "seconds, offline, free" wanted anyway.
#
# A repo with no image-build check therefore gets one lane, and one lane is the
# launcher's sequential path -- the same run, the same output, as before lanes
# existed. `sdlc push` has no image chain either, so push is unchanged too.

MAIN_LANE = "main"
REVIEW_LANE = "review"

# Checks that run beside anything, including a command that rewrites the tree.
#
# The one-lane rule above protects readers of the TREE. Gatehouse does not read
# the tree: its input is `git diff origin/<default>...HEAD`, committed objects
# that bin/sdlc computes on the host before the container starts and pipes in on
# stdin. So ruff can be rewriting your source while Gatehouse reviews the diff
# and neither notices the other.
#
# It is also the only check whose time is not CPU -- it is one API call and then
# waiting -- which is why it is worth moving. On push it was 35 seconds of a
# six-to-eight minute tier spent with the CPUs idle. The launcher gives a lane
# with no containers in it a single CPU and divides the budget between the rest,
# so the main lane keeps the whole budget it had and this costs nothing to
# overlap. That is the difference from the lanes that were measured as a
# regression: those were two CPU-bound lanes splitting one budget.
TREE_INDEPENDENT = ("gatehouse",)


def lane_of(cfg: dict, checks: list[str]) -> dict[str, str]:
    """check -> lane, for one command's resolved check list.

    An image chain is keyed by the image reference, not by position: a
    `pytest-in-image` may be listed before the `image-build` that makes what it
    runs, and two builds may legitimately produce two different tags.
    """
    # Nothing runs beside a check that rewrites the tree -- except the ones that
    # do not read it.
    if any(check in WRITES_TREE for check in checks):
        return {c: REVIEW_LANE if c in TREE_INDEPENDENT else MAIN_LANE for c in checks}
    lanes: dict[str, str] = {}
    by_tag: dict[str, str] = {}
    for check in checks:
        tag = builds_image(cfg, check)
        if tag is not None:
            lanes[check] = by_tag.setdefault(tag, check)
    for check in checks:
        image = runs_image(cfg, check)
        if image is None:
            continue
        # No build of that image in this command: the repo is testing something
        # already built, so it owes nothing to another lane and gets its own.
        lanes[check] = by_tag.get(image, check)
    for check in checks:
        if check in TREE_INDEPENDENT:
            lanes[check] = REVIEW_LANE
    return {check: lanes.get(check, MAIN_LANE) for check in checks}


def builds_image(cfg: dict, check: str) -> str | None:
    """The tag this check builds, or None when it builds nothing."""
    if check == "container-build" or kind_of(cfg, check) == "image-build":
        return str(check_settings(cfg, check).get("tag", default_image_tag()))
    return None


def runs_image(cfg: dict, check: str) -> str | None:
    """The image this check runs or reads, or None when it uses none."""
    if check in ("container-smoke", "container-scan", "bootc-lint"):
        return container_image(cfg, check_settings(cfg, check))
    kind = kind_of(cfg, check)
    if kind == "pytest-in-image":
        return str(check_settings(cfg, check).get("image", default_image_tag()))
    if kind == "command" and "image" in check_settings(cfg, check):
        return str(check_settings(cfg, check)["image"])
    return None


def builds_first(cfg: dict, checks: list[str]) -> list[str]:
    """`checks` in run order: a build before every check that runs what it tags.

    lane_of puts a build and its consumers in one lane, and a lane runs in plan
    order, so `checks = ["py311", "build-py311"]` would run py311 against an
    image that does not exist yet (podman exit 125). Each consumer pulls the
    not-yet-placed builds of its image in ahead of itself; every other check
    keeps the place the repo gave it.
    """
    builders: dict[str, list[str]] = {}
    for check in checks:
        tag = builds_image(cfg, check)
        if tag is not None:
            builders.setdefault(tag, []).append(check)
    out: list[str] = []
    for check in checks:
        image = runs_image(cfg, check)
        for build in builders.get(image, []) if image is not None else []:
            if build not in out:
                out.append(build)
        if check not in out:
            out.append(check)
    return out


def t_plan(target: str) -> int:
    cfg = sdlc_config()
    stacks = active_stacks(cfg)
    if target == SARIF_TARGET:
        # ci's own answer, narrowed: the same skips, repo-added checks and lanes
        # apply, and a repo that runs neither check plans nothing (an empty
        # plan, which the launcher treats as nothing to upload).
        checks = [c for c in resolve(cfg, "ci", stacks) if c in SARIF_CHECKS]
    else:
        checks = resolve(cfg, target, stacks) if target in COMMANDS else [target]
    for check in checks:
        if check not in BUILTINS and kind_of(cfg, check) is None:
            cannot(f"unknown check: {check}")
    sarif_dir = sarif_dir_from_env() if target == SARIF_TARGET else None
    if sarif_dir is not None:
        # What the check job expects back: a planned check that leaves no SARIF
        # is a scan that did not report, not a clean one.
        try:
            (sarif_dir / SARIF_PLANNED).write_text("".join(f"{c}\n" for c in checks))
        except OSError as exc:
            cannot(f"cannot list the planned checks in {sarif_dir}: {exc}")
    # stderr, because stdout is the plan the launcher parses.
    line = push_skip_line(cfg, stacks) if target == "ci" else None
    if line:
        print(line, file=sys.stderr)
    lanes = lane_of(cfg, checks)
    for check in builds_first(cfg, checks):
        lane = plain(lanes[check], "a lane name")
        for name, mode, payload in plan_lines(cfg, check):
            plain(name, "a check name")
            if mode not in HOST_MODES:
                plain(payload, name)
            print(f"{name}\t{lane}\t{mode}\t{payload}")
    return CLEAN


def t_tiers() -> int:
    cfg = sdlc_config()
    stacks = active_stacks(cfg)
    for command in COMMANDS:
        checks = resolve(cfg, command, stacks)
        lanes = lane_of(cfg, checks)
        parallel = len(set(lanes.values())) > 1
        print(f"sdlc {command}:")
        for check in builds_first(cfg, checks):
            kind = kind_of(cfg, check)
            note = f"  ({kind})" if kind else ""
            if parallel:
                note += f"  [lane {lanes[check]}]"
            print(f"  {check}{note}")
        if parallel:
            print(f"  {len(set(lanes.values()))} lanes, run at the same time")
        line = push_skip_line(cfg, stacks) if command == "ci" else None
        if line:
            print(f"  {line}")
    if skipped():
        print(f"\nSDLC_SKIP is skipping: {', '.join(sorted(skipped()))}")
    return CLEAN


# ------------------------------------------------------------------- the kinds
#
# A repo's own checks are named kinds with parameters, never shell. A repo that
# needs something these cannot express gets a new kind HERE, so the config
# stays something a person can read. `command` is the one that runs a repo's
# own program, and it takes an argv list: what reaches the process is exactly
# the words in the config, with no shell to read them on the way.


def project_name() -> str:
    return os.environ.get("SDLC_PROJECT", REPO.name)


def default_image_tag() -> str:
    return f"localhost/{project_name()}:sdlc"


def token(value: object) -> str:
    """Resolve `@project.version`, `@git.sha` and `@now`; pass anything else."""
    text = str(value)
    if not text.startswith("@"):
        return text
    if text == "@project.version":
        version = pyproject().get("project", {}).get("version")
        if not version:
            cannot("@project.version: pyproject.toml has no [project] version")
        return str(version)
    if text == "@git.sha":
        try:
            proc = subprocess.run(
                ["git", "-c", "safe.directory=*", "rev-parse", "HEAD"],
                cwd=REPO,
                capture_output=True,
                text=True,
                check=False,
            )
        except OSError as exc:
            cannot(f"@git.sha: cannot run git: {exc}")
        if proc.returncode != 0 or not proc.stdout.strip():
            cannot("@git.sha: git could not read HEAD")
        return proc.stdout.strip()
    if text == "@now":
        return datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
    cannot(f"unknown value {text}; known: @project.version, @git.sha, @now")


# An image reference, and nothing that could be read as anything else. These
# values are repo-controlled and land in a HOST podman argv: one beginning with
# `-` is an option (`--privileged`), one with a comma rewrites the
# `--mount type=image,source=...` it is spliced into, and whitespace or a
# newline is two words. So every image and tag any check uses -- built in or a
# kind, set or defaulted -- must match this, and bin/sdlc checks again.
#
# The distribution grammar, narrowed: an optional registry host and port, a
# lowercase path, an optional tag and an optional sha256 digest.
_IMAGE_PATH = r"[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*"
IMAGE_REF_RE = re.compile(
    r"(?:[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[0-9]+)?/)?"
    rf"{_IMAGE_PATH}(?:/{_IMAGE_PATH})*"
    r"(?::[A-Za-z0-9_][A-Za-z0-9._-]{0,127})?"
    r"(?:@sha256:[0-9a-f]{64})?"
)


def image_ref(name: str, key: str, value: object) -> str:
    """`value` as an image reference, or a refusal."""
    text = str(value)
    if not isinstance(value, str) or not IMAGE_REF_RE.fullmatch(text):
        cannot(
            f"{name}: {key} {text!r} is not an image reference such as "
            f"localhost/name:tag or quay.io/org/name:1.0"
        )
    return text


def in_repo(name: str, key: str, value: object) -> str:
    """A repo-relative path that stays inside the repo, or a refusal.

    A setting that names a path is repo-controlled, and these paths reach a
    host bind mount or a build context. `../../.config` or `/` would hand the
    host's files to the repo's own code, so anything absolute or outside the
    tree is refused.
    """
    text = str(value)
    target = (REPO / text).resolve()
    if Path(text).is_absolute() or not target.is_relative_to(REPO.resolve()):
        cannot(f"{name}: {key} {text!r} is outside the repository")
    if not target.exists():
        cannot(f"{name}: {key} {text!r} does not exist")
    rel = str(target.relative_to(REPO.resolve())) or "."
    # A path is a positional word in a podman argv, so one podman would read as
    # an option is refused like any other path it should not be given.
    if rel.startswith("-"):
        cannot(f"{name}: {key} {text!r} begins with '-', which podman would read as an option")
    return rel


def table(settings: dict, key: str) -> dict:
    value = settings.get(key, {})
    if not isinstance(value, dict):
        cannot(f"{key} must be a table")
    return value


def kind_image_build(name: str, settings: dict) -> list[tuple[str, str, str]]:
    """Build the repo's image and leave it at a known tag.

    The tag is what `pytest-in-image` runs and what a CI publish step picks up,
    so the image that is published is the image that was tested.
    """
    containerfile = in_repo(name, "containerfile", settings.get("containerfile", "Containerfile"))
    context = in_repo(name, "context", settings.get("context", "."))
    argv = ["podman", "build", "-f", containerfile]
    for key, value in table(settings, "build_args").items():
        argv += ["--build-arg", f"{key}={token(value)}"]
    for key, value in table(settings, "labels").items():
        argv += ["--label", f"{key}={token(value)}"]
    argv += ["-t", image_ref(name, "tag", settings.get("tag", default_image_tag())), context]
    return [host_step(name, argv)]


def kind_pytest_in_image(name: str, settings: dict) -> list[tuple[str, str, str]]:
    """Run tests INSIDE the built image, locked down the way production runs it.

    For tests that only mean something there: that a native library loads in a
    slim runtime, that the server starts and answers. pytest is not added to the
    image -- it is installed once into the cache volume, at the versions the
    repo's own uv.lock pins, and put on PYTHONPATH.
    """
    tests = names(settings.get("tests"), f"{name}.tests")
    if not tests:
        cannot(f"{name}: tests is required -- the paths to run inside the image")
    host = os.environ.get("SDLC_HOST_REPO")
    volume = os.environ.get("SDLC_CACHE_VOLUME")
    if not host or not volume:
        cannot(f"{name}: run through bin/sdlc, which supplies the host paths")
    argv = [
        "podman",
        "run",
        "--rm",
        "--read-only",
        "--tmpfs",
        "/tmp:rw,exec,size=2g,mode=1777",
        "--cap-drop=all",
        "--security-opt",
        "no-new-privileges",
        "-v",
        f"{volume}:/sdlc-cache:ro",
        "-e",
        f"PYTHONPATH=/sdlc-cache/pytest/{project_name()}",
        "-e",
        "HOME=/tmp",
        # The same reason as bin/sdlc's run_in_image: this mounts the repo's
        # test files, so without a prefix pytest reads bytecode the host
        # compiled and judges paths that do not exist in here.
        "-e",
        "PYTHONPYCACHEPREFIX=/tmp/pycache",
        "-w",
        "/repo",
        "--entrypoint",
        "python",
    ]
    if not settings.get("network", False):
        argv += ["--network", "none"]
    for mount in names(settings.get("mounts", ["tests"]), f"{name}.mounts"):
        rel = in_repo(name, "mount", mount)
        argv += ["-v", f"{host}/{rel}:/repo/{rel}:ro,z"]
    for key, value in table(settings, "env").items():
        argv += ["-e", f"{key}={token(value)}"]
    argv += [image_ref(name, "image", settings.get("image", default_image_tag()))]
    argv += ["-m", "pytest", "-p", "no:cacheprovider"]
    argv += names(settings.get("args", ["-q", "-rfE"]), f"{name}.args")
    argv += tests
    return [(name, "image-ro", "pytest-deps"), host_step(name, argv)]


ENV_NAME = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
# systemd's readiness when a repo names none: `running` means every unit
# started. A probe of the repo's own (an HTTP endpoint answering) replaces it.
SYSTEMD_READY = ["systemctl", "is-system-running"]
SYSTEMD_TIMEOUT = 180
SYSTEMD_TIMEOUT_MAX = 1800
# Keys that mean something only with `systemd = true`.
SYSTEMD_ONLY = ("setup", "ready", "timeout")


def command_argv(value: object, where: str) -> list[str]:
    """One argv list: words, the first a program name and not a podman option."""
    if not isinstance(value, list) or not all(isinstance(v, str) for v in value):
        cannot(f'{where} must be a list of words, e.g. ["node", "--test"], never a shell string')
    if not value:
        cannot(f'{where} is required -- the command as a list, e.g. ["node", "--test"]')
    # The entrypoint is a podman option's value, and an exec'd command follows a
    # container name: one that podman would read as an option, or as the
    # JSON-array form of --entrypoint, is refused.
    if not value[0] or value[0].startswith(("-", "[")):
        cannot(f"{where}: argv[0] {value[0]!r} is not a program name")
    return list(value)


def flag(name: str, settings: dict, key: str) -> bool:
    value = settings.get(key, False)
    if not isinstance(value, bool):
        cannot(f"{name}: {key} must be true or false")
    return value


def command_context(name: str, settings: dict) -> tuple[str, str, dict[str, str], bool]:
    """What every `command` shares: host repo, workdir in the container, env, network."""
    network = flag(name, settings, "network")
    host = os.environ.get("SDLC_HOST_REPO")
    if not host:
        cannot(f"{name}: run through bin/sdlc, which supplies the host paths")
    workdir = in_repo(name, "workdir", settings.get("workdir", "."))
    env = {
        # Test runners that watch by default stop when they see CI.
        "CI": "true",
        "HOME": "/tmp",
        "PYTHONPYCACHEPREFIX": "/tmp/pycache",
        # The checkout belongs to the host's user, not the container's, and git
        # refuses a repository it does not own.
        "GIT_CONFIG_COUNT": "1",
        "GIT_CONFIG_KEY_0": "safe.directory",
        "GIT_CONFIG_VALUE_0": "*",
    }
    for key, value in table(settings, "env").items():
        if not ENV_NAME.fullmatch(str(key)):
            cannot(f"{name}: env {key!r} is not a variable name")
        env[str(key)] = token(value)
    return host, "/repo" if workdir == "." else f"/repo/{workdir}", env, network


def kind_command(name: str, settings: dict) -> list[tuple[str, str, str]]:
    """Run one argv in a nested container, with the repo mounted read-only at /repo.

    For a repo's own test that no built-in runs: a node test file, a lint
    script the repo keeps, the suite on a Python the gate image does not ship.
    It is an ARGV LIST, never a shell string: argv[0] is the entrypoint, the
    rest are its arguments, and nothing between this config and the process
    parses them. A script the repo keeps is run by naming it, so the code that
    runs is a file a reviewer sees, as `npm test` and pytest's are.

    `image` defaults to this gate's own image (node, bash, git, gawk). Any
    other is pulled, or built here first by an `image-build` check with that
    tag, which shares its lane. No network unless `network = true`, and the
    launcher drops every capability. The tree is read-only, so a tool that
    writes is pointed at /tmp, which is a tmpfs.

    `systemd = true` is the same command against a running service: see
    `systemd_steps`.
    """
    argv = command_argv(settings.get("argv"), f"{name}.argv")
    if flag(name, settings, "systemd"):
        return systemd_steps(name, settings, argv)
    for key in SYSTEMD_ONLY:
        if key in settings:
            cannot(f"{name}: {key} needs systemd = true")
    host, workdir, env, network = command_context(name, settings)
    image = GATE_IMAGE
    if "image" in settings:
        image = image_ref(name, "image", settings["image"])
    out = [
        "podman",
        "run",
        "--rm",
        "-v",
        f"{host}:/repo:ro,z",
        "-w",
        workdir,
        "--tmpfs",
        "/tmp:rw,exec,size=4g,mode=1777",
    ]
    if not network:
        out += ["--network", "none"]
    for key, value in env.items():
        out += ["-e", f"{key}={value}"]
    out += ["--entrypoint", argv[0], "--", image, *argv[1:]]
    return [host_step(name, out)]


def systemd_steps(name: str, settings: dict, argv: list[str]) -> list[tuple[str, str, str]]:
    """`command` against a running service: the image boots systemd as PID 1.

    For a test that needs the whole service up -- a database, the API, the
    units the image ships. The launcher starts `image` detached with systemd
    as PID 1, polls `ready` (an argv, exec'd until it exits 0) for up to
    `timeout` seconds, then execs each `setup` argv in order and `argv` last,
    and removes the container however that ended. Each is an exec into the one
    container, so a step sees what the one before it left: rows a seed import
    wrote, a unit a step restarted.

    Every word is an argv, as for `command`: a step that needs a loop or a pipe
    is a script in the repo, named by a step. The repo is read-only at /repo,
    the steps run in `workdir` with `env`, and there is no network but the
    container's own loopback unless `network = true`. The capabilities systemd
    needs are the launcher's to grant (bin/sdlc's SYSTEMD_CAPS), never the
    config's. The image is required: the gate's own does not boot systemd.
    """
    host, workdir, env, network = command_context(name, settings)
    if "image" not in settings:
        cannot(f"{name}: systemd = true needs image, the one that boots systemd")
    image = image_ref(name, "image", settings["image"])
    setup = settings.get("setup", [])
    if not isinstance(setup, list):
        cannot(f"{name}: setup must be a list of argv lists")
    steps = [command_argv(step, f"{name}.setup[{i}]") for i, step in enumerate(setup)]
    ready = SYSTEMD_READY
    if "ready" in settings:
        ready = command_argv(settings["ready"], f"{name}.ready")
    timeout = settings.get("timeout", SYSTEMD_TIMEOUT)
    if (
        not isinstance(timeout, int)
        or isinstance(timeout, bool)
        or not 1 <= timeout <= SYSTEMD_TIMEOUT_MAX
    ):
        cannot(f"{name}: timeout must be a whole number of seconds from 1 to {SYSTEMD_TIMEOUT_MAX}")
    run = ["podman", "run", "-v", f"{host}:/repo:ro,z"]
    if not network:
        run += ["--network", "none"]
    run += ["--", image]
    # The options every exec gets. `-w` and `-e` only: bin/sdlc refuses any
    # other word here, so this group cannot carry a privilege.
    options = ["-w", workdir]
    for key, value in env.items():
        options += ["-e", f"{key}={value}"]
    groups = [run, options, ready, *steps, argv]
    payload = STEP_SEPARATOR.join(
        UNIT_SEPARATOR.join(plain(word, name) for word in group) for group in groups
    )
    return [(name, "host-systemd", f"{timeout}{UNIT_SEPARATOR}{payload}")]


KINDS = {
    "image-build": kind_image_build,
    "pytest-in-image": kind_pytest_in_image,
    "command": kind_command,
}


# ---------------------------------------------------------- the container stack
#
# Three of its four checks are host steps, because they need podman and this
# container has none: build the repo's image, run it, and scan what was built.
# They are built-in CHECKS rather than kinds a repo writes, so a repo with a
# Containerfile gets them by having one. Their tables take the settings the
# matching kind takes. The fourth, `containerfile-lint`, reads the tree and runs
# here.

HADOLINT_CONFIGS = (".hadolint.yaml", ".hadolint.yml")
HADOLINT_THRESHOLDS = ("error", "warning", "info", "style", "ignore", "none")
GRYPE_SEVERITIES = ("negligible", "low", "medium", "high", "critical")
SMOKE_SECONDS = 10
SMOKE_SECONDS_MAX = 600


def container_image(cfg: dict, settings: dict) -> str:
    """What smoke and scan judge: their own `image`, or what container-build tags."""
    built = check_settings(cfg, "container-build").get("tag", default_image_tag())
    if "image" in settings:
        return image_ref("container-smoke/scan", "image", settings["image"])
    return image_ref("container-build", "tag", built)


def check_container_build(cfg: dict, name: str, s: dict) -> list[tuple[str, str, str]]:
    """`podman build` of the root Containerfile, at the tag smoke and scan read."""
    if "containerfile" not in s and containerfile() is None:
        cannot(
            f"{name}: there is no Containerfile or Dockerfile at the repo root; "
            f"name one with containerfile in its [tool.sdlc.ci.{name}] table"
        )
    return kind_image_build(name, {"containerfile": containerfile(), **s})


def check_container_smoke(cfg: dict, name: str, s: dict) -> list[tuple[str, str, str]]:
    """Start the built image and see that it either finishes cleanly or stays up.

    One rule covers both shapes the fleet builds. A CLI image runs and exits:
    0 is a pass, anything else is a finding. A service never exits: still
    running when `seconds` is up is a pass. What fails is the image that dies on
    start, which is the failure a green build hides -- a missing shared library,
    an entrypoint that is not there, a config it cannot read.

    No network by default, and the launcher drops every capability, so an image
    that needs either says so here rather than being judged on a host that
    happens to provide it.
    """
    seconds = s.get("seconds", SMOKE_SECONDS)
    if (
        not isinstance(seconds, int)
        or isinstance(seconds, bool)
        or not 1 <= seconds <= SMOKE_SECONDS_MAX
    ):
        cannot(f"{name}: seconds must be a whole number from 1 to {SMOKE_SECONDS_MAX}")
    # No --rm: bin/sdlc reads the stopped container's state, then removes it.
    argv = ["podman", "run", "--pull=never"]
    if not s.get("network", False):
        argv += ["--network", "none"]
    for key, value in table(s, "env").items():
        argv += ["-e", f"{key}={token(value)}"]
    # `--` before the image: nothing after it is a podman option, whatever it
    # says, and bin/sdlc checks the word that follows it.
    argv += ["--", container_image(cfg, s), *names(s.get("args"), f"{name}.args")]
    payload = UNIT_SEPARATOR.join([str(seconds), *(plain(a, name) for a in argv)])
    # Advisory unless the repo says `gate = true`: the fleet's images need env,
    # args, network or capabilities written down before a smoke run can judge
    # them, and a wave that turned them all red would teach SDLC_SKIP. A
    # finding is printed and marked ADVISORY, never a pass.
    gate = s.get("gate", False)
    if not isinstance(gate, bool):
        cannot(f"{name}: gate must be true or false")
    return [(name, "host-up" if gate else "host-up-advisory", payload)]


# The gate's own image in a host argv. bin/sdlc replaces this word with the
# image it is running, so a plan never has to be told which one that is.
GATE_IMAGE = "@sdlc-image"


def check_container_scan(cfg: dict, name: str, s: dict) -> list[tuple[str, str, str]]:
    """Scan the built image's filesystem with grype, in this image.

    podman mounts the built image read-only at /scan -- no export, no daemon,
    no registry -- and `sdlc scan-rootfs` scans that. The repo is mounted too,
    read-only, so its own `.grype.yaml` ignore rules apply: what a repo has
    accepted is the repo's to say, in a file a reviewer sees.

    The default fails on a Critical that has a fix, which is the line the
    fleet's scheduled CVE check pages on. A finding with no fix is reported and
    does not fail: nothing the repo can do in this pull request changes it.
    """
    host = os.environ.get("SDLC_HOST_REPO")
    volume = os.environ.get("SDLC_CACHE_VOLUME")
    if not host or not volume:
        cannot(f"{name}: run through bin/sdlc, which supplies the host paths")
    fail_on = str(s.get("fail_on", "critical"))
    if fail_on not in GRYPE_SEVERITIES:
        cannot(f"{name}: fail_on must be one of {', '.join(GRYPE_SEVERITIES)}")
    only_fixed = s.get("only_fixed", True)
    if not isinstance(only_fixed, bool):
        cannot(f"{name}: only_fixed must be true or false")
    image = container_image(cfg, s)
    argv = [
        "podman",
        "run",
        "--rm",
        "--pull=never",
        "--mount",
        f"type=image,source={image},destination=/scan,rw=false",
        "-v",
        f"{volume}:/cache",
        "-v",
        f"{host}:/repo:ro,z",
        "-w",
        "/repo",
        "--tmpfs",
        "/tmp:rw,exec,size=2g,mode=1777",
        "-e",
        "HOME=/tmp",
        "-e",
        f"SDLC_PROJECT={project_name()}",
        "-e",
        f"SDLC_SCAN_FAIL_ON={fail_on}",
        "-e",
        f"SDLC_SCAN_ONLY_FIXED={'1' if only_fixed else '0'}",
        "--",
        GATE_IMAGE,
        "scan-rootfs",
    ]
    return [host_step(name, argv)]


# -------------------------------------------------------------- the bootc stack
#
# A bootc image is a host, not an app, so the check that judges it is bootc's
# own: `bootc container lint`, the static analysis its authors wrote to run as
# a `RUN` at the end of a build. It runs here against the image container-build
# produced, which is the same bytes and the same verdict, and the fleet's bootc
# repos already gate on exactly `podman run --rm "$IMAGE" bootc container lint`.
#
# Measured, not assumed: it needs nothing the launcher withholds. Under the
# launcher's `--cap-drop=all --security-opt=no-new-privileges`, with no network,
# it runs to the same verdict as unrestricted (quay.io/centos-bootc/
# centos-bootc:stream10), because it only reads the image's own filesystem. So
# run_host stays exactly as it is and this check asks for no capability.
#
# `--entrypoint bootc`, not a trailing `bootc`: a bootc base's ENTRYPOINT is
# not the CLI and a repo may set its own, so the binary is named explicitly.
# What a lint run says is in its exit status: 0 passes -- warnings included, as
# they are in a build -- and 1 is a failed lint, which is a finding. A podman
# that never started the container is 125-127, which the launcher maps to 2.
LINT_NAME_RE = re.compile(r"[a-z0-9][a-z0-9-]*")


def check_bootc_lint(cfg: dict, name: str, s: dict) -> list[tuple[str, str, str]]:
    """`bootc container lint` inside the image container-build built.

    Settings: `fatal_warnings` makes a warning fail too (default false: a
    stock bootc base itself warns, about /var/roothome/buildinfo, so a default
    of true would fail every repo on a file it did not write); `skip` lists lint
    names to leave out, discovered with `bootc container lint --list`; `image`
    judges an image other than the one container-build tags.
    """
    fatal = s.get("fatal_warnings", False)
    if not isinstance(fatal, bool):
        cannot(f"{name}: fatal_warnings must be true or false")
    skips = names(s.get("skip"), f"{name}.skip")
    for lint in skips:
        # A lint name is a word bootc reads as an argument, so one that is
        # not a plain name never reaches the argv.
        if not LINT_NAME_RE.fullmatch(lint):
            cannot(f"{name}: skip {lint!r} is not a lint name (see `bootc container lint --list`)")
    argv = ["podman", "run", "--rm", "--pull=never", "--network", "none"]
    # `--` before the image, as in smoke: nothing after it is a podman option,
    # and bin/sdlc checks the word that follows it.
    argv += ["--entrypoint", "bootc", "--", container_image(cfg, s), "container", "lint"]
    if fatal:
        argv.append("--fatal-warnings")
    for lint in skips:
        argv += ["--skip", lint]
    return [host_step(name, argv)]


HOST_CHECKS = {
    "container-build": check_container_build,
    "bootc-lint": check_bootc_lint,
    "container-smoke": check_container_smoke,
    "container-scan": check_container_scan,
}


# What the fleet does on purpose, so hadolint is told not to call it a defect.
# DL3007: base tags float, because the Container Image profile rebuilds every
# week to pick up errata through them. DL3041: dnf installs are not pinned to a
# package version, for the same reason. SC1072: ShellCheck's "fix any mentioned
# problems" on an exec-form RUN ["python3", "-c", ...], which it misreads as
# shell -- the form a stage with no /bin/sh has to use.
HADOLINT_FLEET_IGNORES = ("DL3007", "DL3041", "SC1072")
# hadolint's parse failure (DL1000) prints as file:line:column, which no rule
# finding does. A Containerfile hadolint cannot read is not judged by it.
HADOLINT_PARSE_FAILURE = re.compile(r"^\S+:\d+:\d+ ", re.M)


def t_containerfile_lint(s: dict) -> int:
    """hadolint over the Containerfiles, with the repo's own `.hadolint.yaml`.

    By default that is the root Containerfile and every `[[tool.sdlc.images]]`
    one, so each image the image job publishes is linted; `containerfiles` names
    them instead.

    Without a config the threshold is `error` and the fleet's deliberate
    choices (HADOLINT_FLEET_IGNORES) are not reported: a warning such as
    DL3002, a root last USER, is printed and does not fail, because a gate that
    fails on taste is a gate people skip. A repo with a config file sets its
    own rules there and gets none of these defaults, and `threshold` in this
    check's table beats both.
    """
    files = names(s.get("containerfiles"), "containerfile-lint.containerfiles")
    if not files:
        files = [*filter(None, [containerfile()]), *image_containerfiles()]
        if not files:
            cannot("there is no Containerfile or Dockerfile at the repo root to lint")
    files = [in_repo("containerfile-lint", "containerfiles", f) for f in files]
    cmd = ["hadolint", "--no-color"]
    threshold = s.get("threshold")
    if not any((REPO / c).is_file() for c in HADOLINT_CONFIGS):
        threshold = threshold or "error"
        for rule in HADOLINT_FLEET_IGNORES:
            cmd += ["--ignore", rule]
    if threshold is not None:
        if threshold not in HADOLINT_THRESHOLDS:
            cannot(f"containerfile-lint: threshold must be one of {', '.join(HADOLINT_THRESHOLDS)}")
        cmd += ["--failure-threshold", str(threshold)]
    step(f"hadolint {' '.join(files)}")
    rc, out = run([*cmd, *files], tee=True)
    # hadolint has two answers: 0 clean, 1 found something at the threshold.
    # Anything else is the tool, not the Containerfile.
    if rc not in (CLEAN, FOUND):
        cannot(f"hadolint could not run (exit {rc})")
    if rc == FOUND and HADOLINT_PARSE_FAILURE.search(out):
        # A heredoc RUN, for one, which hadolint cannot parse though podman
        # builds it. The build is the judge of that; this check says so.
        print(
            "ADVISORY: hadolint could not parse this Containerfile, so it is not "
            "judged here; container-build still builds it"
        )
        return SKIPPED
    return rc


GRYPE_DB = CACHE / "grype"
SCAN_ROOT = Path("/scan")


def t_scan_rootfs() -> int:
    """The in-image half of container-scan: grype over the image podman mounted.

    grype answers 0 clean, 2 above `--fail-on`, 1 when it could not scan --
    which is the reverse of this file's 1 and 2, so it is translated here and
    nowhere else. Its vulnerability database lives in the cache volume and is
    refreshed when stale; one lock keeps two gates from rewriting it at once.
    """
    if not SCAN_ROOT.is_dir():
        cannot("nothing is mounted at /scan; container-scan runs this, not a person")
    fail_on = os.environ.get("SDLC_SCAN_FAIL_ON", "critical")
    if fail_on not in GRYPE_SEVERITIES:
        cannot(f"SDLC_SCAN_FAIL_ON is {fail_on!r}; it must be one of {', '.join(GRYPE_SEVERITIES)}")
    cmd = [
        "grype",
        f"dir:{SCAN_ROOT}",
        "--name",
        project_name(),
        "--fail-on",
        fail_on,
        "-o",
        "table",
    ]
    if os.environ.get("SDLC_SCAN_ONLY_FIXED", "1") == "1":
        cmd.append("--only-fixed")
    env = dict(os.environ)
    env.update({"GRYPE_DB_CACHE_DIR": str(GRYPE_DB), "GRYPE_CHECK_FOR_APP_UPDATE": "false"})
    step(f"grype, failing on a {'fixable ' if '--only-fixed' in cmd else ''}{fail_on} or worse")
    # Only the cache is guarded here. A grype that cannot start is run()'s to
    # report, in its own words.
    try:
        GRYPE_DB.mkdir(parents=True, exist_ok=True)
        lock = (GRYPE_DB / ".lock").open("w")
        fcntl.flock(lock, fcntl.LOCK_EX)
    except OSError as exc:
        cannot(f"cannot use grype's database cache at {GRYPE_DB}: {exc}")
    with lock:
        rc = run(cmd, env=env)[0]
    if rc == 0:
        return CLEAN
    if rc == 2:  # noqa: PLR2004 -- grype's own "above the threshold"
        return FOUND
    cannot(
        f"grype could not scan the image (exit {rc}). Its vulnerability database is "
        f"downloaded on first use, so a refused network is the usual cause."
    )


# --------------------------------------------------------------- the node stack
#
# Three checks -- npm-lint, npm-test, npm-audit -- over a repo with a
# package.json at its root. Each runs the repo's OWN scripts: the stack does not
# bring an opinion about eslint or vitest, it runs `npm run lint` and `npm test`
# the way the repo's CI does, so a verdict here is the verdict there.
#
# WHERE node_modules LIVES, AND WHO CAN TOUCH IT. The repo is mounted
# read-only, and `npm ci` writing node_modules into a developer's tree is the
# wrong side effect for a gate anyway: it is gigabytes of the host
# architecture's binaries. So each repo gets a WORKSPACE: a copy of its source
# (what git tracks, plus what it does not ignore) at /node/tree, synced over on
# every run, and npm's download cache beside it at /node/npm. `npm ci` runs
# on every run; node_install says why.
#
# /node is a podman volume of the repo's OWN, `sdlc-node-<owner>-<repo>-<hash>`, and
# these checks run as host steps that mount that volume and nothing else of the
# gate's -- not the shared cache volume every other check uses. That is the
# point. An install runs the dependencies' lifecycle scripts and a test runs the
# repo's code, both with a writable workspace; in a shared volume, repo A's
# postinstall could rewrite repo B's node_modules, and B's next green run would
# be A's code. The volume is keyed on the origin remote's owner/repo, not the
# directory name, so two different repos called `app` are not one workspace.
#
# Each check is two steps. `npm-install` syncs the tree and runs `npm ci`, with
# the network. Then npm-lint and npm-test run with NO network -- what they need
# is installed -- and npm-audit with it, because the registry is what it asks.
#
# Two consequences, both deliberate. Tests run at /node/tree, not /repo, so
# one that reads `.git` or a path outside its package sees the workspace (no
# .git) -- the same constraint a CI checkout with a shallow clone puts on it.
# And the three checks share the workspace and the one install step, which is
# safe because they all run in MAIN_LANE, one after the other.
#
# LIFECYCLE SCRIPTS RUN. `npm ci` is not given --ignore-scripts. Skipping them
# would break the dependencies that need a postinstall step (esbuild's check,
# native addons) and make this gate disagree with the repo's CI, which runs
# them. The trust it extends is no wider than the check's own: `npm test` then
# executes those same dependencies. The container is still the boundary --
# no capabilities, the tree read-only, and no volume but the repo's own.
#
# NO LOCKFILE, NO CHECK. `npm ci` needs package-lock.json and refuses without
# one; `npm install` would resolve whatever is newest today and bless a tree
# the repo never pinned. The honest answer is 2, as need_lock_dep gives a
# Python repo with no uv.lock.
#
# The commit tier gets none of these on purpose. It is "seconds, offline, free",
# and an install is none of the three; a repo that wants lint at commit has
# its own hook.
#
# MONOREPOS. `packages` (default ["."]) in a check's own table lists the
# repo-relative directories that are npm packages, each with its own lockfile.
# Every one is installed, and the check's script runs in each that defines it.
# A root script that fans out (`npm run lint --prefix frontend`) wants the
# fanned-out packages installed, so either list them and drop the root, or
# list the root and the packages it calls. Listing both runs the script twice.

NPM_AUDIT_LEVELS = ("info", "low", "moderate", "high", "critical")
NPM_AUDIT_TIMEOUT = 120
# The pauses BETWEEN attempts, as PIP_AUDIT_BACKOFF: the registry's audit
# endpoint is the one network call in this check, and a blip there must not
# read as either a pass or a finding.
NPM_AUDIT_BACKOFF = (10, 30)


def node_packages(name: str, s: dict) -> list[str]:
    """The `packages` setting as repo-relative directories that hold a package.json."""
    raw = names(s.get("packages", ["."]), f"{name}.packages")
    if not raw:
        cannot(f"{name}: packages is empty; list at least one directory, or omit it for '.'")
    found: list[str] = []
    for item in raw:
        rel = in_repo(name, "packages", item)
        if not (REPO / rel / "package.json").is_file():
            nested = package_dirs() if rel == "." else []
            if nested:
                cannot(
                    f"{name}: there is no package.json at the repo root, but there is in "
                    f"{', '.join(nested)}. Say which are this repo's packages, in each node "
                    f"check's table: [tool.sdlc.push.{name}] packages = "
                    f'{json.dumps(nested)}; or [tool.sdlc] skip-stacks = ["node"] if none is'
                )
            cannot(f"{name}: packages entry {item!r} has no package.json")
        if rel not in found:
            found.append(rel)
    return found


def npm_scripts(rel: str) -> dict:
    try:
        data = json.loads((REPO / rel / "package.json").read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        cannot(f"cannot read {rel}/package.json: {exc}")
    scripts = data.get("scripts") if isinstance(data, dict) else None
    return scripts if isinstance(scripts, dict) else {}


NODE_WORK_ENV = "SDLC_NODE_WORK"
NODE_WORK = "/node"
NODE_VOLUME_PREFIX = "sdlc-node-"
_VOLUME_WORD = re.compile(r"[^a-z0-9_.-]+")


def node_work() -> Path:
    """The repo's own workspace volume, which only the node host steps mount."""
    work = os.environ.get(NODE_WORK_ENV)
    if not work:
        cannot(
            "the node checks run through bin/sdlc, which mounts the repo's own "
            "workspace volume; there is none here"
        )
    return Path(work)


def node_volume() -> str:
    """`sdlc-node-<owner>-<repo>` from the origin remote; a hash of the host path without one.

    The owner is in the name because a basename is not an identity: two repos
    that share a name would otherwise share one workspace -- the cross-repo
    write this volume exists to prevent.
    """
    url = ""
    try:
        proc = subprocess.run(
            ["git", "-c", "safe.directory=*", "remote", "get-url", "origin"],
            cwd=REPO,
            capture_output=True,
            text=True,
            check=False,
        )
        url = proc.stdout.strip() if proc.returncode == 0 else ""
    except OSError:
        pass
    parts = [p for p in re.split(r"[/:]", url.removesuffix(".git").rstrip("/")) if p]
    if len(parts) >= 2:  # noqa: PLR2004 -- owner and repo
        # Readable, then exact: the words alone are lossy (`alice-bob/app` and
        # `alice/bob-app` read the same), so a hash of the pair itself ends it.
        pair = f"{parts[-2]}/{parts[-1]}".lower()
        word = _VOLUME_WORD.sub("-", pair.replace("/", "-")).strip("-.") or "repo"
        key = f"{word}-{hashlib.sha256(pair.encode()).hexdigest()[:12]}"
    else:
        host = os.environ.get("SDLC_HOST_REPO", str(REPO))
        key = "local-" + hashlib.sha256(host.encode()).hexdigest()[:16]
    return NODE_VOLUME_PREFIX + key


def node_step(name: str, s: dict, command: list[str], *, network: bool) -> tuple[str, str, str]:
    """A host step running `sdlc <command>` in this image over the repo's own volume."""
    host = os.environ.get("SDLC_HOST_REPO")
    if not host:
        cannot(f"{name}: run through bin/sdlc, which supplies the host paths")
    argv = [
        "podman",
        "run",
        "--rm",
        "--pull=never",
        "-v",
        f"{host}:/repo:ro,z",
        "-w",
        "/repo",
        "-v",
        f"{node_volume()}:{NODE_WORK}",
        "--tmpfs",
        "/tmp:rw,exec,size=4g,mode=1777",
        "-e",
        "HOME=/tmp",
        "-e",
        f"{NODE_WORK_ENV}={NODE_WORK}",
        "-e",
        f"SDLC_PROJECT={project_name()}",
        # By name: podman copies the launcher's value when it has one, so
        # `sdlc npm-test -- --grep x` reaches the script without its
        # separator-joined words ever being written into a plan line.
        "-e",
        "SDLC_ARGS",
    ]
    if not network:
        argv += ["--network", "none"]
    return host_step(name, [*argv, "--", GATE_IMAGE, *command])


def check_node(cfg: dict, name: str, s: dict) -> list[tuple[str, str, str]]:
    """Install with the network, then judge: lint and test offline, the audit online."""
    node_packages(name, s)  # refused at plan time, not halfway through a tier
    return [
        node_step(name, s, ["npm-install", name], network=True),
        node_step(name, s, [name], network=name == "npm-audit"),
    ]


def t_npm_install(check: str | None) -> int:
    """The install step of a node check: sync the workspace and `npm ci` what changed."""
    if check not in ("npm-lint", "npm-test", "npm-audit"):
        cannot("npm-install takes the node check it installs for")
    node_install(check, node_packages(check, check_settings(sdlc_config(), check)))
    return CLEAN


HOST_CHECKS.update({"npm-lint": check_node, "npm-test": check_node, "npm-audit": check_node})


def node_env() -> dict[str, str]:
    env = dict(os.environ)
    env.update(
        {
            # HOME is where npm wants its logs and config, and the tree is read-only.
            "HOME": "/tmp",
            "npm_config_cache": str(node_work() / "npm"),
            "npm_config_update_notifier": "false",
            "npm_config_fund": "false",
        }
    )
    return env


def node_source_files() -> list[str]:
    """Repo-relative files to copy: tracked, plus untracked-but-not-ignored.

    Untracked files count because a gate that ignores the file you just created
    and have not yet `git add`ed judges a tree you are not about to push.
    `.gitignore` keeps node_modules, build output and secrets out without this
    code having to know their names.
    """
    try:
        proc = subprocess.run(
            [
                "git",
                "-c",
                "safe.directory=*",
                "ls-files",
                "-z",
                "--cached",
                "--others",
                "--exclude-standard",
            ],
            cwd=REPO,
            capture_output=True,
            check=False,
        )
    except OSError as exc:
        cannot(f"cannot run git to list the source: {exc}")
    if proc.returncode != 0:
        cannot(f"git ls-files failed ({proc.stderr.decode(errors='replace').strip()})")
    listed = proc.stdout.decode("utf-8", "surrogateescape").split("\0")
    return sorted({p for p in listed if p})


def node_copy(tree: Path) -> set[str]:
    """Copy the source into `tree`, replacing what differs. Returns what it holds."""
    wanted = set()
    for rel in node_source_files():
        src = REPO / rel
        parts = Path(rel).parts
        # A tracked file that is deleted in the worktree, or a submodule; and
        # nothing that is an installed tree of any kind.
        if not (src.is_file() or src.is_symlink()) or "node_modules" in parts or ".git" in parts:
            continue
        wanted.add(rel)
        dst = tree / rel
        dst.parent.mkdir(parents=True, exist_ok=True)
        try:
            a, b = src.lstat(), dst.lstat()
            if a.st_size == b.st_size and a.st_mtime_ns == b.st_mtime_ns:
                continue
        except FileNotFoundError:
            pass
        if dst.is_symlink() or dst.exists():
            dst.unlink()
        shutil.copy2(src, dst, follow_symlinks=False)
    return wanted


def node_sync(tree: Path, packages: list[str]) -> None:
    """Make `tree` the repo's source plus the node_modules of `packages`, and nothing else.

    A listed package's node_modules is left for its `npm ci` to reset. Any
    other is removed: no install resets it, and Node's resolution walks up
    into it, so one planted by an earlier run would survive into this one.
    """
    try:
        tree.mkdir(parents=True, exist_ok=True)
        wanted = node_copy(tree)
        dirs: list[Path] = []
        for here, subdirs, files in os.walk(tree):
            # A symlink to a directory is listed among the directories, but it
            # is a source entry like a file: kept when wanted, unlinked when
            # stale, never descended into or offered to rmdir.
            links = [d for d in subdirs if Path(here, d).is_symlink()]
            if (
                "node_modules" in subdirs
                and "node_modules" not in links
                and str(Path(here).relative_to(tree)) not in packages
            ):
                shutil.rmtree(Path(here, "node_modules"))
            subdirs[:] = [d for d in subdirs if d != "node_modules" and d not in links]
            dirs += [Path(here, d) for d in subdirs]
            for f in itertools.chain(files, links):
                path = Path(here, f)
                if str(path.relative_to(tree)) not in wanted:
                    path.unlink()
        for d in sorted(dirs, reverse=True):
            # Every directory is offered for removal; one that still holds a
            # wanted file refuses with ENOTEMPTY (EEXIST on some filesystems)
            # and stays. Any other refusal is the workspace itself failing,
            # and is raised to the 2 below.
            try:
                d.rmdir()
            except OSError as exc:
                if exc.errno not in (errno.ENOTEMPTY, errno.EEXIST):
                    raise
    except OSError as exc:
        cannot(f"cannot prepare the node workspace in {tree}: {exc}")


def need_lockfiles(name: str, packages: list[str]) -> None:
    for rel in packages:
        if not (REPO / rel / "package-lock.json").is_file():
            cannot(
                f"{name}: {rel}/package-lock.json is missing; npm ci needs a lockfile "
                f"(npm install --package-lock-only), and installing without one would "
                f"test whatever is newest today rather than what the repo pinned"
            )


def node_install(name: str, packages: list[str]) -> Path:
    """Sync the workspace and `npm ci` every package, every time. Returns the tree.

    Every time, because an installed node_modules cannot be trusted from one
    run to the next. The last run executed the code it checked -- lifecycle
    scripts, tests -- with this workspace writable, so a branch nobody has
    reviewed could rewrite a dependency in place, and a later run that skipped
    the install would execute it. A stamp saying "already installed" would sit
    in the same writable volume and be forged as easily. `npm ci` removes
    node_modules before it installs, and what it installs from npm's cache is
    checked against the lockfile's integrity hashes, so each run starts from
    what the lockfile names and nothing a previous run left. The cache makes
    that a local copy, not a download.
    """
    need_lockfiles(name, packages)
    tree = node_work() / "tree"
    node_sync(tree, packages)
    env = node_env()
    for rel in packages:
        step(f"npm ci ({rel})")
        rc, _ = run(["npm", "ci", "--no-audit", "--no-fund"], env=env, cwd=tree / rel)
        if rc != 0:
            cannot(
                f"npm ci failed in {rel} (exit {rc}). A lockfile out of step with "
                f"package.json is the usual cause, then the registry being unreachable"
            )
    return tree


def node_installed(name: str, packages: list[str]) -> Path:
    """The tree the install step just prepared. A check step never installs.

    It runs with no network, so an install here could only fail; and the
    install step before it in the plan is what keeps the tree honest.
    """
    need_lockfiles(name, packages)
    tree = node_work() / "tree"
    missing = [rel for rel in packages if not (tree / rel / "package.json").is_file()]
    if missing:
        cannot(
            f"{name}: the workspace has no {', '.join(missing)}; its npm-install step "
            f"did not run. Run the check through bin/sdlc, which plans both steps"
        )
    return tree


def npm_script_check(name: str, s: dict, script: str, extra: list[str]) -> int:
    """Run `npm run <script>` in every listed package that defines it."""
    packages = node_packages(name, s)
    with_script = [p for p in packages if script in npm_scripts(p)]
    if not with_script:
        cannot(
            f"{name}: none of {', '.join(packages)} defines a {script!r} script in its "
            f"package.json, so there is nothing to run. Add one, or skip {name} in "
            f"[tool.sdlc.push]; a check that ran nothing must not report a pass"
        )
    tree = node_installed(name, packages)
    env = node_env()
    if script == "test":
        # Test runners that watch by default (CRA, vitest without `run`) stop
        # watching when they see CI; there is no terminal here to quit one.
        env["CI"] = "true"
    worst = CLEAN
    for rel in with_script:
        step(f"npm run {script} ({rel})" + "".join(f" {a}" for a in extra))
        cmd = ["npm", "run", script]
        if extra:
            cmd += ["--", *extra]
        rc, _ = run(cmd, env=env, cwd=tree / rel)
        # npm reports the script's own status, and a repo's scripts do not know
        # this tool's exit contract: eslint's 2 means it crashed, a test runner
        # may say anything. Non-zero is the repo's check failing, so it is a
        # finding; "could not run at all" (126/127) was already raised by run().
        if rc != 0:
            worst = FOUND
    return worst


def t_npm_lint(s: dict) -> int:
    return npm_script_check("npm-lint", s, "lint", [])


def t_npm_test(s: dict) -> int:
    return npm_script_check("npm-test", s, "test", passthrough())


def npm_audit_report(text: str) -> tuple[dict | None, str]:
    """The `vulnerabilities` table of an `npm audit --json` output, or (None, why not)."""
    try:
        data = json.loads(text)
    except ValueError:
        return None, f"npm audit printed no JSON: {text.strip()[:300] or '(nothing)'}"
    if not isinstance(data, dict):
        return None, "npm audit's JSON was not an object"
    err = data.get("error")
    if isinstance(err, dict):
        return None, f"{err.get('code', 'error')}: {err.get('summary') or err.get('detail')}"
    if err:
        return None, str(err)
    vulns = data.get("vulnerabilities")
    if not isinstance(vulns, dict):
        return None, "npm audit's JSON has no vulnerabilities report"
    return vulns, ""


def npm_audit_line(pkg: str, info: dict) -> str:
    # `via` holds advisories (dicts) for the package itself and names (str) for
    # packages it is vulnerable through; titles are what a person acts on.
    via = info.get("via", [])
    titles = sorted({v["title"] for v in via if isinstance(v, dict) and "title" in v})
    fix = info.get("fixAvailable")
    if isinstance(fix, dict):
        how = f"fix: {fix.get('name')}@{fix.get('version')}" + (
            " (breaking)" if fix.get("isSemVerMajor") else ""
        )
    else:
        how = "fix: npm audit fix" if fix else "no fix available"
    return f"  {info.get('severity'):<9} {pkg} {info.get('range', '')}  [{how}]" + "".join(
        f"\n            {t}" for t in titles
    )


def classify_npm_audit(text: str, level: str) -> tuple[str, str]:
    """(verdict, detail) for one `npm audit --json` output.

    The verdict is "clean", "found" or "error". "error" is anything that is not
    an answer: output that is not JSON, or JSON carrying npm's `error` object,
    which is how a refused network, a 5xx from the audit endpoint and a missing
    lockfile all arrive -- exit 1, the same status as a finding. A report with
    no `vulnerabilities` key is not accepted as clean either: only a report
    that says what it audited can clear it.

    Severity is read from the report rather than trusted to npm's exit status,
    so the threshold is this tool's setting and one place decides.
    """
    vulns, why = npm_audit_report(text)
    if vulns is None:
        return "error", why
    floor = NPM_AUDIT_LEVELS.index(level)
    hits = [
        (NPM_AUDIT_LEVELS.index(info["severity"]), pkg, info)
        for pkg, info in vulns.items()
        if isinstance(info, dict)
        and info.get("severity") in NPM_AUDIT_LEVELS
        and NPM_AUDIT_LEVELS.index(info["severity"]) >= floor
    ]
    if not hits:
        return "clean", ""
    ordered = sorted(hits, key=lambda h: (-h[0], h[1]))
    return "found", "\n".join(npm_audit_line(pkg, info) for _, pkg, info in ordered)


def npm_audit_once(rel: str, tree: Path, level: str, omit_dev: bool) -> tuple[str, str]:
    cmd = ["npm", "audit", "--json", f"--audit-level={level}"]
    if omit_dev:
        cmd += ["--omit=dev"]
    try:
        proc = subprocess.run(
            cmd,
            cwd=tree / rel,
            env=node_env(),
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            timeout=NPM_AUDIT_TIMEOUT,
            check=False,
        )
    except subprocess.TimeoutExpired:
        return "error", f"npm audit timed out after {NPM_AUDIT_TIMEOUT}s"
    except OSError as exc:
        cannot(f"cannot start npm: {exc}")
    if proc.returncode in (126, 127):
        cannot(f"npm could not be invoked (exit {proc.returncode})")
    return classify_npm_audit(proc.stdout, level)


def t_npm_audit(s: dict) -> int:
    """Audit each package's locked dependencies against the registry, and GATE on it.

    The same promise t_pip_audit makes: the verdict is the tool's, a network
    failure is retried and then a 2, never a 1 that reads as a finding or a 0
    that reads as a pass. `level` is the lowest severity that fails (npm's own
    names, default "high"); `omit_dev` (default false) leaves devDependencies
    out. The default audits everything, as pip-audit audits the whole locked
    environment: a dev dependency runs on the machine that builds the release.
    """
    level = str(s.get("level", "high"))
    if level not in NPM_AUDIT_LEVELS:
        cannot(f"npm-audit: level {level!r} is not one of {', '.join(NPM_AUDIT_LEVELS)}")
    omit_dev = s.get("omit_dev", False)
    if not isinstance(omit_dev, bool):
        cannot("npm-audit: omit_dev must be true or false")
    packages = node_packages("npm-audit", s)
    tree = node_installed("npm-audit", packages)
    attempts = len(NPM_AUDIT_BACKOFF) + 1
    worst = CLEAN
    for rel in packages:
        for attempt in range(1, attempts + 1):
            step(
                f"npm audit --audit-level={level} ({rel}"
                + (f", attempt {attempt} of {attempts}" if attempt > 1 else "")
                + ")"
            )
            verdict, detail = npm_audit_once(rel, tree, level, omit_dev)
            if verdict != "error":
                break
            if attempt == attempts:
                cannot(
                    f"npm audit could not run in {rel}: {detail}, on all {attempts} "
                    f"attempts. The audit never completed, so this is neither a pass "
                    f"nor a finding."
                )
            delay = NPM_AUDIT_BACKOFF[attempt - 1]
            print(f"\nnpm audit: {detail}; retrying in {delay}s.", flush=True)
            time.sleep(delay)
        if verdict == "found":
            print(f"\nvulnerabilities at or above {level} in {rel}:\n{detail}", flush=True)
            worst = FOUND
    return worst


# --------------------------------------------------------------- the docs stack
#
# Two verdicts over the repo's Markdown. Neither is a fixer, so neither runs at
# commit; both run at push and in ci. Both read the same set of files, so a
# page one of them judges is a page the other judges.

# Where Markdown is never the repo's own: vendored and installed trees. Hidden
# directories are NOT excluded wholesale -- `.github/` and `.claude/skills/` are
# docs a reviewer reads -- except the VCS directory, which markdownlint-cli2
# would otherwise walk. Both tools also honour .gitignore, which covers a
# virtualenv.
MARKDOWN_EXCLUDED_DIRS = ("node_modules", "vendor", ".git")
MARKDOWN_GLOB = "**/*.md"

# markdownlint-cli2 reads these from the repo root (and every directory below
# it), so any one of them means the repo has stated its own rules.
MARKDOWNLINT_CONFIGS = (
    ".markdownlint.json",
    ".markdownlint.jsonc",
    ".markdownlint.yaml",
    ".markdownlint.yml",
    ".markdownlint.cjs",
    ".markdownlint.mjs",
    ".markdownlint-cli2.jsonc",
    ".markdownlint-cli2.yaml",
    ".markdownlint-cli2.cjs",
    ".markdownlint-cli2.mjs",
)
# The fleet's defaults judge whether the page is RIGHT, not whether it is to
# anyone's taste, because a gate that fails on taste is a gate people skip.
# Calibrated against twenty fleet repos: with every rule on there were 28,000
# findings, and with these off about a dozen remain, each a real defect (a
# skipped heading level, a broken #fragment, a table row with the wrong cell
# count, an undefined reference link). A repo that wants more states it in its
# own config and gets none of this (MARKDOWNLINT_CONFIGS).
#   Layout and style, which render identically either way: MD004 list marker,
#   MD007 list indent, MD009 trailing space, MD012 blank runs, MD013 line
#   length, MD014 `$` before a command, MD022/MD031/MD032/MD058 blank lines
#   around headings, fences, lists and tables, MD025 more than one H1, MD026
#   heading punctuation, MD028 blank inside a quote, MD029 ordered-list numbers,
#   MD040 fence language, MD046 code-block style, MD047 final newline, MD049
#   emphasis style, MD059 link text and MD060 table column style.
#   Content the fleet writes on purpose: MD033 inline HTML, MD034 bare URLs,
#   MD036 bold used as a heading, MD041 first line a heading, and MD024
#   duplicate headings, which every Keep-a-Changelog file has (`### Fixed`
#   twice in one release is a habit, not a broken page; MD051 still catches an
#   anchor that no longer resolves).
#   False positives on how a line WRAPS or what a code span holds: MD018 raised
#   on `#47)` at the start of a wrapped line, MD037 and MD038 raised on
#   `* ` and `COPY . ` that are the point of the sentence.
