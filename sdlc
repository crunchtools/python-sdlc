    return next((f for f in CONTAINERFILES if (REPO / f).is_file()), None)


def image_containerfiles() -> list[str]:
    """Each `[[tool.sdlc.images]]` entry's `containerfile`, in the order written."""
    given = config_document().get("tool", {}).get("sdlc", {}).get("images", [])
    if not isinstance(given, list) or not all(isinstance(e, dict) for e in given):
