# The host launcher, bin/sdlc, shipped inside the image that it starts. A repo
# with no `rev:` to pin gets it from here (bin/sdlc-bootstrap), so the launcher
# floats with the image tag exactly as every tool in the image does.
LAUNCHER = Path("/usr/share/sdlc/launcher")
LAUNCHED_FROM_LINE = "LAUNCHED_FROM=\n"


def t_launcher(ref: str | None) -> int:
    """Print the launcher, with the image it came from written into it.

    The caller names the ref because only it knows which one it pulled: the
    image cannot see its own tag. The ref is checked before it is written into
    a shell script, and written single-quoted all the same.
    """
    if not ref:
        cannot("launcher needs the image it is run from, e.g. quay.io/crunchtools/sdlc:latest")
    ref = image_ref("launcher", "image", ref)
    try:
        text = LAUNCHER.read_text()
    except OSError as exc:
        cannot(f"this image ships no launcher at {LAUNCHER}: {exc}")
    if text.count(LAUNCHED_FROM_LINE) != 1:
        cannot(f"{LAUNCHER} has no single `LAUNCHED_FROM=` line to write the image into")
    sys.stdout.write(text.replace(LAUNCHED_FROM_LINE, f"LAUNCHED_FROM='{ref}'\n", 1))
    return CLEAN


# ------------------------------------------------------------------ sdlc event

# Where sdlc_jobs/ is found: beside this script in a checkout, and where the
# image installs it.
JOBS_PATHS = (Path(__file__).resolve().parent, Path("/usr/share/sdlc"))
JOB_NAME = re.compile(r"[a-z][a-z0-9_]*")


def event_payload() -> tuple[str, dict]:
    """GITHUB_EVENT_NAME and the payload at GITHUB_EVENT_PATH."""
    event_name = os.environ.get("GITHUB_EVENT_NAME", "")
    if not event_name:
        cannot("GITHUB_EVENT_NAME is not set: `sdlc event` runs inside a workflow job")
    event_path = os.environ.get("GITHUB_EVENT_PATH", "")
    try:
        event = json.loads(Path(event_path).read_text()) if event_path else {}
    except (OSError, ValueError) as exc:
        cannot(f"the event payload at {event_path} does not load: {exc}")
    if not isinstance(event, dict):
        cannot(f"the event payload at {event_path} is not an object")
    return event_name, event


def job_module(job: str) -> types.ModuleType:
    """sdlc_jobs.<job>, or a 2 naming the handler this sdlc does not have."""
    # Reversed, so the first of JOBS_PATHS -- this script's own directory -- ends
    # up first on sys.path and a checkout runs its own sdlc_jobs.
    for where in reversed(JOBS_PATHS):
        if (where / "sdlc_jobs").is_dir() and str(where) not in sys.path:
            sys.path.insert(0, str(where))
    try:
        return importlib.import_module(f"sdlc_jobs.{job}")
    except ModuleNotFoundError as exc:
        if exc.name in ("sdlc_jobs", f"sdlc_jobs.{job}"):
            cannot(f"this sdlc has no handler for job `{job}` (sdlc_jobs/{job}.py)")
        raise


def t_event(job: str | None) -> int:
    """Run this workflow job's trust level for this event: sdlc_jobs.<job>.run.

    The job is the argument, or GITHUB_JOB. A job with no module yet is a 2
    naming it, never a silent pass. `write` with DIGEST set is sdlc's rollback
    dispatch, and does nothing: the workflow's `if:` already skips it, and this
    is the second guard.
    """
    job = job or os.environ.get("GITHUB_JOB", "")
    if not JOB_NAME.fullmatch(job):
        cannot(f"no job to run: GITHUB_JOB is {job!r}")
    event_name, event = event_payload()
    if job == "write" and os.environ.get("DIGEST"):
        step("write: DIGEST is set, a rollback dispatch; nothing to do")
        return CLEAN
    module = job_module(job)
    core = importlib.import_module("sdlc_jobs._core")
    step(f"sdlc event: job {job}, event {event_name}")
    try:
        return core.run_job(module, event_name, event, os.environ)
    except core.CannotRunError as exc:
        cannot(str(exc))


