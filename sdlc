def pyproject() -> dict:
    """The repo's pyproject.toml, or {} when it has none.

    A repo with NO pyproject.toml is not an error here. `constitution`,
    `gourmand` and `gatehouse` are language-agnostic, and this image's own repo
    has none of its own policy to state. The Python-specific checks assert the
    project separately, through `need_project()`.
    """
    path = REPO / "pyproject.toml"
    if not path.is_file():
        return {}
    try:
        return tomllib.loads(path.read_text(encoding="utf-8"))
    except (OSError, tomllib.TOMLDecodeError) as exc:
        cannot(f"cannot read {path}: {exc}")


# A repo with no pyproject.toml writes the same `[tool.sdlc]` tables in
# `sdlc.toml` instead, so moving a block between the two is copy and paste and
# every message that names `[tool.sdlc.ci]` names what the reader wrote. Only
# one of them, ever: a repo with a pyproject.toml configures sdlc there, because
# two files that can both say what CI runs are two answers to one question.
SDLC_TOML = "sdlc.toml"


def config_document() -> dict:
    """Where `[tool.sdlc]` is read from: pyproject.toml, or sdlc.toml without one."""
    doc = pyproject()
    path = REPO / SDLC_TOML
    if not path.is_file():
        return doc
    if (REPO / "pyproject.toml").is_file():
        cannot(
            f"{SDLC_TOML} and pyproject.toml both exist; a repo with a pyproject.toml "
            f"configures sdlc in its [tool.sdlc] tables, so remove {SDLC_TOML}"
        )
    try:
        return tomllib.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError) as exc:
        cannot(f"cannot read {path}: {exc}")


