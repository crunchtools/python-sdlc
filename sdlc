def t_pip_audit(s: dict) -> int:
    """Audit the project's locked dependencies, and GATE on it.

    17 repos in the fleet run this as `pip-audit … || true`, which means the
    scan cannot fail and has never once blocked anything. This one returns the
    tool's verdict.
    """
    need_project()
    env = project_env()
    sync_project(env)
    step("pip-audit")
    # NOT --strict. A local path dependency is legitimately absent from PyPI --
    # trentina vendors `petit-plus` from tests/fixtures -- and --strict turns
    # "could not audit this one" into a failed gate. The fleet's own
    # dependency-audit.yml runs without it, and a local gate that is stricter
    # than CI trains people to skip the local gate.
    #
    # The cost is that an unauditable package passes quietly, so it is reported
    # explicitly below rather than left in the log for nobody.
    rc, out = run(
        ["uv", "run", "--locked", "--all-extras", "--with", "pip-audit", "pip-audit"],
        env=env,
        cwd=project_dir(),
        tee=True,
    )
    unaudited = [
        line.split("could not be audited:")[-1].strip()
        for line in out.splitlines()
        if "could not be audited" in line
    ]
    if unaudited:
        print(
            "\nNOT AUDITED -- no PyPI record, so these were skipped rather than "
            "cleared:\n  "
            + "\n  ".join(sorted(set(unaudited)))
            + "\nA local path or vendored dependency is expected here. Anything "
            "else in this list is a real gap in the scan."
        )
    return rc


def t_constitution(s: dict) -> int:
    """Validate the repo's manifest against the constitution IT pins.

    The constitution is cloned at the tag the repo's own manifest names, never
    baked into this image. Two reasons, and both matter: the fleet spans v1.0.0
    to v1.29.0 so a baked copy would judge most repos by rules they have not
    adopted; and the validator resolves `constitution.md` and `profiles/` from
    its own directory, so a partial copy makes its pin, file and version checks
    silently vanish rather than fail.
    """
    manifest = Path(str(s.get("manifest", ".specify/memory/constitution.md")))
    if not (REPO / manifest).is_file():
        cannot(f"{manifest} does not exist")
    return run(["sdlc-validate", str(manifest)], env=project_env())[0]


def t_codeql(s: dict) -> int:
    default_config = ".github/codeql/codeql-config.yml"
    config = str(s.get("config", default_config))
    # A config the repo NAMED and that is not there is a missing config path,
    # which the contract says is a 2 -- silently falling back to a default query
    # suite would run a different analysis than the repo asked for and call it a
    # pass. A repo that simply has no config, and named none, gets the default
    # suite; that is not a missing path.
    if config != default_config and not (REPO / config).is_file():
        cannot(f"codeql config {config} does not exist")
    db = CACHE / "codeql" / project_name()
    # Held until this process exits. The database directory is named for the
    # worktree's basename, so two checkouts that share one -- or a push retried
    # while the last is still running -- used ONE directory: each deleted the
    # other's database mid-run, which left half-built caches and analyses dying
    # with nothing to read (python-sdlc#33).
    lock_codeql(db)
    # Compiled query plans, kept between runs. CodeQL's default is ~/.codeql,
    # which is /tmp in this image and gone when the container exits, so every
    # run compiled all of security-extended again: 1m32s-3m13s of trentina's
    # analysis, against 46s for the whole analysis on a warm cache. Shared by
    # every repo on the volume, which is the point -- the standard packs are the
    # same bytes everywhere -- and keyed by CodeQL on each query's own hash, so
    # a changed query recompiles and nothing stale is reused.
    caches = CACHE / "codeql-common"
    sarif = Path("/tmp/codeql-results.sarif")
    clear_database(db)
    # An unwritable cache is a 2, not a traceback and not a 1. The same bug in
    # `validate` surfaced as a PermissionError stack trace with an exit status
    # that claimed a finding.
    try:
        caches.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        cannot(f"cannot create the CodeQL database directory {db.parent}: {exc}")
    ram = f"--ram={codeql_ram_mb()}"

    create = [
        "codeql",
        "database",
        "create",
        str(db),
        "--language=python",
        "--source-root=.",
        "--overwrite",
        f"--common-caches={caches}",
        ram,
    ]
    analyze = [
        "codeql",
        "database",
        "analyze",
        str(db),
        "--format=sarif-latest",
        f"--output={sarif}",
        f"--threads={os.environ.get('SDLC_JOBS', '0')}",
        f"--common-caches={caches}",
        ram,
    ]

    # `--codescanning-config` is NOT a CLI flag in 2.27.4, on either subcommand.
    # `database analyze --help` describes it ("if a Code Scanning configuration
    # file was specified at database creation time using --codescanning-config")
    # but that is the Action's internal flow; `create` does not list it and
    # `analyze` rejects it outright with "Unknown option". Both were tried.
    #
    # So the config is read HERE and applied in two parts: the query list goes
    # to `analyze`, and `paths-ignore` filters the SARIF afterwards.
    #
    # Honouring paths-ignore is not a nicety. trentina's config excludes
    # `tests/fixtures/boundary-review`, which holds DELIBERATELY vulnerable code
    # used to grade a reviewer. Analyse without it and the local gate reports a
    # pile of findings CI does not, which teaches people to ignore the gate.
    queries, ignores = read_codeql_config(REPO / config)
    analyze += queries or ["python-security-extended.qls"]
    run_codeql(create, analyze, sarif)
    return report_sarif(sarif, ignores, baseline_path(s))


def path_ignored(artifact: str, ignores: list[str]) -> bool:
    """Does a SARIF artifact URI fall under a `paths-ignore` entry?

    This is the local stand-in for the config the CodeQL CLI will not read, so
    it has to match CodeQL's own semantics, and those include GLOBS -- `tests/**`
    and `**/vendor/*` are both legal in a code-scanning config. Matching only
    literal paths and directory prefixes would silently fail to suppress them,
    and the local gate would then report -- and fail on -- findings CI
    ignores.

    Three forms, because CodeQL accepts all three:
      - an exact path
      - a directory, suppressing everything beneath it
      - a glob, where `**` crosses separators and `*` does not
    """
    for entry in ignores:
        item = entry.strip().rstrip("/")
        if not item:
            continue
        if artifact == item or artifact.startswith(item + "/"):
            return True
        if not any(c in item for c in "*?["):
            continue
        pattern = _glob_to_regex(item)
        if re.fullmatch(pattern, artifact) or re.fullmatch(pattern + r"/.*", artifact):
            return True
    return False


def _glob_to_regex(glob: str) -> str:
    """Translate a code-scanning path glob to a regex.

    Hand-built rather than handed to `fnmatch`, because fnmatch's `*` crosses
    `/` -- which is what `**` means and what `*` must not do.
    """
    out = ""
    for part in re.split(r"(\*\*/?|\*|\?)", glob):
        if part == "**/":
            out += r"(?:.*/)?"
        elif part == "**":
            out += r".*"
        elif part == "*":
            out += r"[^/]*"
        elif part == "?":
            out += r"[^/]"
        else:
            out += re.escape(part)
    return out


def read_codeql_config(path: Path) -> tuple[list[str], list[str]]:
    """Read `queries:` and `paths-ignore:` out of the Action's config format.

    Parsed here rather than trusted entirely to the CLI flag so that the query
    set is explicit and the ignore list is available as a backstop filter. The
    one mapping that matters: a bare suite name like `security-extended` is the
    Action's shorthand for this language's `.qls`.
    """
    if not path.is_file():
        return [], []
    try:
        data = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
    except Exception as exc:
        cannot(f"cannot read {path}: {exc}")
    queries: list[str] = []
    for entry in data.get("queries") or []:
        uses = (entry or {}).get("uses") if isinstance(entry, dict) else entry
        if not uses:
            continue
        if str(uses).startswith("."):
            queries.append(str(uses))
        else:
            queries.append(f"python-{uses}.qls")
    ignores = [str(p) for p in (data.get("paths-ignore") or [])]
    return queries, ignores


def lock_codeql(db: Path) -> None:
    """Take this project's CodeQL lock, waiting for whoever holds it."""
    try:
        db.parent.mkdir(parents=True, exist_ok=True)
        # Deliberately never closed: the lock is released when the process ends.
        fd = os.open(db.parent / f"{db.name}.lock", os.O_RDWR | os.O_CREAT, 0o644)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print(f"codeql: another run holds {db.name}'s database; waiting for it", flush=True)
            fcntl.flock(fd, fcntl.LOCK_EX)
    except OSError as exc:
        cannot(f"cannot lock the CodeQL database directory {db.parent}: {exc}")


def clear_database(db: Path) -> None:
    """Remove the last run's database, and PROVE it is gone.

    Nothing in it is reused, so a half-built one -- `trap/` and `working/` with
    no `db-python`, from a run that was killed -- is just a cache miss. This
    used to be `rmtree(ignore_errors=True)`, and when that quietly left anything
    behind, `create --overwrite` refused the directory as "not a CodeQL
    database" and a person had to delete it by hand.
    """
    errors: list[str] = []

    def retry(func: Callable[[str], object], path: str, _exc: BaseException) -> None:
        # A read-only directory cannot have its entries unlinked; open it up
        # and try once more before recording the failure.
        try:
            os.chmod(os.path.dirname(path) or ".", 0o700)
            if os.path.isdir(path) and not os.path.islink(path):
                os.chmod(path, 0o700)
            func(path)
        except OSError as again:
            errors.append(f"{path}: {again}")

    if db.exists() or db.is_symlink():
        shutil.rmtree(db, onexc=retry)
    if db.exists() or db.is_symlink():
        cannot(f"cannot clear the previous CodeQL database {db}: {'; '.join(errors[:3])}")


def memory_limit_mb() -> int | None:
    """The smallest memory ceiling this container can see, in MB.

    Three sources, because none is reliable alone. `SDLC_MEMORY` is the budget
    the launcher gave `podman run --memory`, which rootless podman silently
    drops when the cgroup memory controller is not delegated -- a gate inside a
    developer container is exactly that. The cgroup's own `memory.max` is the
    one the kernel enforces. MemTotal is the machine.
    """
    found: list[int] = []
    budget = os.environ.get("SDLC_MEMORY", "").strip().lower()
    match = re.fullmatch(r"(\d+)([kmg]?)b?", budget)
    if match:
        scale = {"": 1 / 2**20, "k": 1 / 1024, "m": 1, "g": 1024}[match.group(2)]
        found.append(int(int(match.group(1)) * scale))
    try:
        cg = Path("/sys/fs/cgroup/memory.max").read_text(encoding="utf-8").strip()
        if cg.isdigit():
            found.append(int(cg) // 2**20)
    except OSError:
        pass
    try:
        for line in Path("/proc/meminfo").read_text(encoding="utf-8").splitlines():
            if line.startswith("MemTotal:"):
                found.append(int(line.split()[1]) // 1024)
    except OSError, ValueError, IndexError:
        pass
    return min((f for f in found if f > 0), default=None)


def codeql_ram_mb() -> int:
    """`--ram` for the evaluator: three quarters of the ceiling, never under 2048.

    Left to itself CodeQL does not look at the container at all. `codeql
    resolve ram` gave a 1509 MB heap in a container with 8g and in one with 2g
    alike, and 1253 MB on josui-skills' dataset -- where analyze then died with
    status 70 (python-sdlc#33). The 8g the launcher budgets was never used.

    The quarter left over is for the JVM outside its heap, file-backed maps of
    the dataset, and /tmp, which is a tmpfs and so is charged to this same
    cgroup. 2048 is CodeQL's own floor; it rounds anything smaller up.
    """
    limit = memory_limit_mb()
    return max(2048, limit * 3 // 4) if limit else 2048


def ci_judges() -> bool:
    """Is a push's CodeQL also judged by CI on this same commit?

    True only at the push tier, outside CI, with codeql in the ci tier and a
    workflow that RUNS `bin/sdlc ci`. Anywhere else -- `sdlc ci` itself, the
    inner loop's `sdlc codeql`, a repo without that workflow -- nobody else
    will judge the commit, and a check that could not run stays a 2.
    """
    if os.environ.get("SDLC_TIER") != "push" or os.environ.get("CI"):
        return False
    if "codeql" not in resolve(sdlc_config(), "ci"):
        return False
    workflows = REPO / ".github" / "workflows"
    try:
        files = [*workflows.glob("*.yml"), *workflows.glob("*.yaml")]
    except OSError as exc:
        print(f"codeql: cannot read {workflows}, so nothing may be deferred: {exc}", flush=True)
        return False
    # The launcher knows it; 10 of the 69 checkouts in this fleet are not main.
    default = (os.environ.get("SDLC_DEFAULT_BRANCH") or "").removeprefix("origin/")
    for f in files:
        try:
            if runs_sdlc_ci(f.read_text(encoding="utf-8", errors="replace"), default):
                return True
        except OSError as exc:
            print(f"codeql: cannot read {f}, so it cannot grant a deferral: {exc}", flush=True)
    return False


JUDGING_EVENTS = ("pull_request", "pull_request_target", "merge_group", "push")

# A path ending in `bin/sdlc`, then `ci` as its argument: how a workflow
# actually invokes the gate (`$RUNNER_TEMP/sdlc/bin/sdlc ci`).
_RUNS_SDLC_CI = re.compile(r"""(?:^|[\s;&|("'=])\S*bin/sdlc\s+ci\b""")


def runs_sdlc_ci(text: str, default_branch: str) -> bool:
    """Does this workflow RUN the gate, in a job that this commit reaches?

    Not "does the text `sdlc ci` appear in it". Every way of answering that
    question loosely hands a push a verdict nobody ever reaches, and each of
    these was a real finding against an earlier version of this function:

    - trentina carries `VERIFIER_JOB: sdlc ci` as a job name and `sdlc ci`
      inside an error message. So the invocation is looked for in parsed
      `steps[].run` scripts only -- never in a comment, a `name:`, an `env:`
      value or an echoed string (python-sdlc#34).
    - a job or step behind an `if:` may be skipped on this very commit, so a
      conditional one grants nothing.
    - a workflow triggered only by `workflow_dispatch` or `schedule` judges
      nothing anybody pushed, and `on: push` filtered to another branch is the
      same gap wearing the right event name. The trigger has to reach
      `default_branch`, which is the branch XII's required status check guards.

    A workflow this cannot parse grants nothing.
    """
    try:
        doc = yaml.safe_load(text)
    except yaml.YAMLError:
        return False
    if not isinstance(doc, dict):
        return False
    return judges_a_commit(doc, default_branch) and any_step_runs_the_gate(doc)


def judges_a_commit(doc: dict, default_branch: str) -> bool:
    """Does a trigger of this workflow cover the default branch?

    `on:` is YAML 1.1's boolean `True` once parsed, which is why both keys are
    looked for.
    """
    on = doc.get("on", doc.get(True))
    if isinstance(on, str):
        events: dict[str, object] = {on: None}
    elif isinstance(on, list):
        events = {e: None for e in on if isinstance(e, str)}
    elif isinstance(on, dict):
        events = {k: v for k, v in on.items() if isinstance(k, str)}
    else:
        return False
    return any(covers_branch(events[e], default_branch) for e in JUDGING_EVENTS if e in events)


def covers_branch(filters: object, branch: str) -> bool:
    """Does this event's branch filter reach `branch`?

    GitHub applies `branches` in order and lets a later `!pattern` take a
    branch back out, which a set of names cannot express: `['**', '!main']`
    excludes `main` while containing a pattern that matches everything
    (Gatehouse, on the first version of this). Rather than reimplement that
    ordering, a filter carrying any negation grants nothing, and so does
    `branches-ignore`, which cannot be evaluated without knowing every branch.
    """
    if not isinstance(filters, dict):
        return True
    if "branches-ignore" in filters:
        return False
    branches = filters.get("branches")
    if branches is None:
        return True
    if not isinstance(branches, list) or not all(isinstance(b, str) for b in branches):
        return False
    if any(b.startswith("!") for b in branches):
        return False
    return bool(branch) and any(branch_matches(b, branch) for b in branches)


def branch_matches(pattern: str, branch: str) -> bool:
    """GitHub's filter-pattern glob, where `*` stops at a `/` and `**` does not."""
    out = ["^"]
    i = 0
    while i < len(pattern):
        c = pattern[i]
        if c == "*":
            if pattern[i + 1 : i + 2] == "*":
                out.append(".*")
                i += 2
                continue
            out.append("[^/]*")
        elif c == "?":
            out.append("[^/]")
        elif c == "+":
            out.append(".")
        else:
            out.append(re.escape(c))
        i += 1
    out.append("$")
    return re.match("".join(out), branch) is not None


def any_step_runs_the_gate(doc: dict) -> bool:
    """Is there an unconditional `steps[].run` that invokes `bin/sdlc ci`?"""
    jobs = doc.get("jobs")
    if not isinstance(jobs, dict):
        return False
    for job in jobs.values():
        if not isinstance(job, dict) or job.get("if") is not None:
            continue
        steps = job.get("steps")
        if not isinstance(steps, list):
            continue
        for step in steps:
            if not isinstance(step, dict) or step.get("if") is not None:
                continue
            run = step.get("run")
            if isinstance(run, str) and invokes_the_gate(run):
                return True
    return False


def invokes_the_gate(script: str) -> bool:
    """Does this shell script run the gate, rather than talk about it?"""
    for raw in script.splitlines():
        line = raw.split("#", 1)[0]
        if "echo" in line or "printf" in line:
            continue
        if _RUNS_SDLC_CI.search(line):
            return True
    return False


def codeql_broke(msg: str) -> NoReturn:
    """CodeQL itself failed: defer to CI when CI will judge, otherwise a 2.

    Only for the TOOL breaking. A config the repo got wrong stays a 2 wherever
    it is found, because CI would fail on it in exactly the same way.
    """
    if ci_judges():
        raise DeferredError(msg)
    cannot(msg)


def run_codeql(create: list[str], analyze: list[str], sarif: Path) -> None:
    """Build the database and analyse it, or report that it could not run.

    Either step failing means no verdict was reached, which is a 2 -- except
    on a push whose CI will judge the same commit, where `codeql_broke` makes
    it a 3 and says so loudly (constitution XII, v1.35.0).
    """
    step("codeql database create")
    rc, _ = run(create, env=project_env())
    if rc != 0:
        codeql_broke(f"codeql could not build a database (exit {rc}); nothing was analysed")
    step("codeql database analyze")
    rc, _ = run(analyze, env=project_env())
    if rc != 0:
        # Analysis failing is not the tool's verdict ON the code -- it means no
        # verdict was reached, which the exit-code contract makes a 2, or a 3
        # where CI will judge this commit.
        codeql_broke(f"codeql database analyze failed (exit {rc}); nothing was judged")


def baseline_path(s: dict) -> Path:
    return REPO / str(s.get("baseline", ".sdlc/codeql-baseline.json"))


def sarif_findings(sarif: Path, ignores: list[str]) -> list[dict]:
    """Every result outside `paths-ignore`, with the key a baseline matches on."""
    try:
        data = json.loads(sarif.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        cannot(f"codeql wrote no readable SARIF: {exc}")
    out = []
    for run_ in data.get("runs", []):
        for result in run_.get("results", []):
            phys = ((result.get("locations") or [{}])[0]).get("physicalLocation") or {}
            uri = (phys.get("artifactLocation") or {}).get("uri", "?")
            if path_ignored(uri, ignores):
                continue
            line = (phys.get("region") or {}).get("startLine", "?")
            # The line HASH, not the line number, so a finding that moves
            # because code was added above it is still the same finding.
            fingerprint = (result.get("partialFingerprints") or {}).get(
                "primaryLocationLineHash", f"line:{line}"
            )
            out.append(
                {
                    "rule": result.get("ruleId", "?"),
                    "path": uri,
                    "fingerprint": fingerprint,
                    "line": line,
                    "message": (result.get("message") or {}).get("text", ""),
                }
            )
    return out


def finding_key(f: dict) -> tuple[str, str, str]:
    return (f["rule"], f["path"], f["fingerprint"])


def report_sarif(sarif: Path, ignores: list[str], baseline: Path) -> int:
    """Fail on any finding that is not in the committed baseline.

    CodeQL in the push tier has to be able to fail, or it is a check that cannot
    fail sitting next to ones that can. But trentina's green main carries 19
    findings that were triaged and accepted in GitHub's Security tab, which this
    cannot see. The baseline is that acceptance, committed: the findings a
    person has looked at. Anything not in it is new, and new blocks.

    `sdlc codeql-baseline` writes it. With no baseline file, every finding is
    new.
    """
    accepted: set[tuple[str, str, str]] = set()
    if baseline.is_file():
        try:
            for entry in json.loads(baseline.read_text(encoding="utf-8")):
                accepted.add((entry["rule"], entry["path"], entry["fingerprint"]))
        except (OSError, ValueError, KeyError, TypeError) as exc:
            cannot(f"cannot read the CodeQL baseline {baseline.relative_to(REPO)}: {exc}")
    findings = sarif_findings(sarif, ignores)
    new = [f for f in findings if finding_key(f) not in accepted]
    known = len(findings) - len(new)
    for f in new:
        print(f"  NEW {f['path']}:{f['line']} [{f['rule']}] {f['message']}")
    print(f"codeql: {len(new)} new, {known} in the baseline")
    return FOUND if new else CLEAN


def t_codeql_baseline() -> int:
    """Accept every current finding: write them to the baseline file.

    The one deliberate way to make a finding stop failing besides fixing it, and
    it lands in a commit someone reviews.
    """
    settings = check_settings(sdlc_config(), "codeql")
    config = str(settings.get("config", ".github/codeql/codeql-config.yml"))
    _, ignores = read_codeql_config(REPO / config)
    # Its verdict does not matter here: findings are what is being accepted.
    t_codeql(settings)
    sarif = Path("/tmp/codeql-results.sarif")
    findings = sorted(sarif_findings(sarif, ignores), key=finding_key)
    path = baseline_path(settings)
    path.parent.mkdir(parents=True, exist_ok=True)
    entries = [{k: f[k] for k in ("rule", "path", "fingerprint")} for f in findings]
    path.write_text(json.dumps(entries, indent=2) + "\n", encoding="utf-8")
    print(f"wrote {len(entries)} finding(s) to {path.relative_to(REPO)}")
    return CLEAN


