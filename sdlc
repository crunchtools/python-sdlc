)

# lychee's fleet defaults, as a config file the repo's own lychee.toml is merged
# over (later `-c` wins, key by key). Offline so the gate is deterministic and
# needs no network: what it judges is the repo's OWN links -- a file that was
# renamed, an anchor that was reworded. Fragments are checked because that is
# the half of a local link a rename does not announce.
LYCHEE_FLEET_CONFIG = 'offline = true\ninclude_fragments = "anchor-only"\nno_progress = true\n'
# What is not the page's fault when the check does go to the network: a rate
# limit, a timeout. Everything else a remote returns is a finding.
LYCHEE_EXTERNAL_ARGS = (
    "--offline=false",
    # A link to localhost, a private range or link-local (cloud metadata) is
    # never fetched: the gate runs on a developer's machine and a CI runner,
    # and a repo's Markdown must not be a way to make either of them ask.
    "--exclude-all-private",
    "--accept-timeouts",
    "--accept",
    "100..=103,200..=299,429",
)
# lychee prints this header, and only this header, when it checked links and
# some were broken. Its exit 2 is ALSO what its argument parser exits with, so
# the header is how a broken link is told from a broken command line.
LYCHEE_FOUND_HEADER = re.compile(r"^Issues found in \d+ inputs?\b", re.M)


def has_markdown() -> bool:
    """Is there any Markdown for the docs checks to read?

    Asked of git first, which already knows what is ignored, so a repo with a
    large ignored tree (build output, a vendored SDK) is not walked to answer a
    yes-or-no question. A tree that is not a git checkout is walked instead,
    with the same exclusions, and the walk stops at the first file it finds.
    """
    try:
        proc = subprocess.run(
            ["git", "-c", "safe.directory=*", "ls-files", "-co", "--exclude-standard", "*.md"],
            cwd=REPO,
            capture_output=True,
            check=False,
        )
    except OSError:
        proc = None
    if proc is not None and proc.returncode == 0:
        return any(
            not set(Path(f).parts) & set(MARKDOWN_EXCLUDED_DIRS)
            for f in proc.stdout.decode("utf-8", "surrogateescape").splitlines()
        )
    for _, dirs, files in os.walk(REPO):
        dirs[:] = [d for d in dirs if d not in MARKDOWN_EXCLUDED_DIRS]
        if any(f.endswith(".md") for f in files):
            return True
    return False


def markdown_globs(name: str, s: dict) -> list[str]:
    """`globs` in a docs check's table, else every Markdown file in the repo."""
    return names(s.get("globs"), f"{name}.globs") or [MARKDOWN_GLOB]


def repo_markdownlint_config() -> str | None:
    """The first of the repo's own markdownlint config files, or None."""
    return next((c for c in MARKDOWNLINT_CONFIGS if (REPO / c).is_file()), None)


def markdownlint_fleet_config() -> str:
    """The fleet defaults as a markdownlint-cli2 config document.

    The ignore-file switch is a cli2 option, not a rule, so the defaults ride
    in a cli2 config file; JSON is valid JSONC, which is what cli2 reads it as.
    """
    rules: dict[str, object] = {"default": True}
    rules.update(dict.fromkeys(MARKDOWNLINT_FLEET_OFF, False))
    return json.dumps({"gitignore": True, "config": rules}, indent=2) + "\n"


def tmp_file(name: str, text: str) -> str:
    """Write a generated config where this container can: the repo is read-only."""
    try:
        path = Path(tempfile.mkdtemp(prefix="sdlc-docs-")) / name
        path.write_text(text, encoding="utf-8")
    except OSError as exc:
        cannot(f"cannot write {name} under /tmp: {exc}")
    return str(path)


def t_markdown_lint(s: dict) -> int:
    """markdownlint-cli2 over the repo's Markdown.

    A repo with its own markdownlint config (MARKDOWNLINT_CONFIGS) is judged by
    that and nothing else. Without one, MARKDOWNLINT_FLEET_OFF is switched off
    and the rest of markdownlint's defaults apply, from a config file written
    under /tmp: the repo is mounted read-only and is not ours to put a file in.
    The repo's ignore file is honoured.

    markdownlint-cli2 answers 0 clean, 1 findings, and anything else is the
    tool: a config it could not parse, a glob it could not read.
    """
    if not has_markdown():
        print("There is no Markdown in this repository; nothing to lint.")
        return CLEAN
    cmd = ["markdownlint-cli2"]
    own = repo_markdownlint_config()
    if own is None:
        cmd += ["--config", tmp_file(".markdownlint-cli2.jsonc", markdownlint_fleet_config())]
    cmd += markdown_globs("markdown-lint", s)
    cmd += [f"#{d}" for d in MARKDOWN_EXCLUDED_DIRS]
    step(f"markdownlint-cli2, {'the repo config ' + own if own else 'the fleet defaults'}")
    rc = run(cmd)[0]
    if rc not in (CLEAN, FOUND):
        cannot(f"markdownlint-cli2 could not run (exit {rc})")
    return rc


def lychee_verdict(rc: int, out: str) -> int:
    """lychee's exit status and report as this file's 0, 1 or a refusal.

    lychee exits 0 clean, 2 for broken links, 3 for a config it could not load,
    1 for an unexpected failure -- and 2 again for an invalid command line, so
    its 2 alone is not a verdict. A 2 is a finding only when it also printed
    the header it prints over a list of broken links. Translated here and
    nowhere else, as t_scan_rootfs does for grype.
    """
    if rc == 0:
        return CLEAN
    if rc == 2 and LYCHEE_FOUND_HEADER.search(out):  # noqa: PLR2004 -- lychee's own "broken links"
        return FOUND
    cannot(f"lychee could not check the links (exit {rc})")


def t_link_check(s: dict) -> int:
    """lychee over the repo's Markdown: do its links point at something.

    OFFLINE by default (LYCHEE_FLEET_CONFIG): local files and their #fragments,
    so the verdict does not depend on anyone's uptime. `external = true` in the
    check's table adds the network; a remote that times out or rate-limits is
    accepted rather than reported, and any other bad answer is a finding. A
    repo's lychee.toml is merged OVER the defaults, key by key, so it can
    exclude a pattern without having to restate `offline`, and its
    .lycheeignore applies as lychee reads it. Root-relative links (`/docs/x.md`)
    resolve against the repo root, the way the forge renders them.
    """
    external = s.get("external", False)
    if not isinstance(external, bool):
        cannot("link-check: external must be true or false")
    if not has_markdown():
        print("There is no Markdown in this repository; no links to check.")
        return CLEAN
    cmd = ["lychee", "--config", tmp_file("lychee.toml", LYCHEE_FLEET_CONFIG)]
    if (REPO / "lychee.toml").is_file():
        cmd += ["--config", str(REPO / "lychee.toml")]
    cmd += ["--root-dir", str(REPO.resolve())]
    # The repo as a DIRECTORY input, not a `**/*.md` glob, and that is
    # deliberate: lychee reads .gitignore while it walks a directory and not
    # for a glob, so a glob would judge `build/` and a vendored tree the
    # ignore file excludes. --hidden brings `.github/` in, as markdownlint-cli2
    # already reads it; the VCS directory is then excluded by hand.
    cmd += ["--extensions", "md", "--hidden"]
    for d in MARKDOWN_EXCLUDED_DIRS:
        cmd += ["--exclude-path", f"(^|/){re.escape(d)}/"]
    # On the command line as well as in the fleet config, because lychee lets
    # a later --config override an earlier one and the repo's lychee.toml is
    # the later one: `offline = false` there must not turn an offline check
    # into one that fetches whatever the repo's Markdown links to.
    cmd += list(LYCHEE_EXTERNAL_ARGS) if external else ["--offline"]
    cmd += names(s.get("globs"), "link-check.globs") or ["."]
    step(f"lychee, {'local links and remote links' if external else 'local links only (offline)'}")
    rc, out = run(cmd, tee=True)
    return lychee_verdict(rc, out)


# pytest and the plugins an in-image run needs. Pure Python, so one install
# serves a target image on any Python the lock admits.
PYTEST_PACKAGES = ("pytest", "pytest-asyncio", "pytest-xdist", "pytest-timeout")


def t_pytest_deps() -> int:
    """Install the lock's pytest into the cache volume for `pytest-in-image`."""
    need_lock_dep("pytest")
    lock = tomllib.loads((project_dir() / "uv.lock").read_text(encoding="utf-8"))
    pins = sorted(
        f"{pkg['name']}=={pkg['version']}"
        for pkg in lock.get("package", [])
        if pkg.get("name") in PYTEST_PACKAGES and pkg.get("version")
    )
    target = CACHE / "pytest" / project_name()
    stamp = target / ".sdlc-pins"
    if stamp.is_file() and stamp.read_text(encoding="utf-8") == "\n".join(pins):
        return CLEAN
    shutil.rmtree(target, ignore_errors=True)
    step(f"install {', '.join(pins)} for the in-image run")
    rc, _ = run(
        ["uv", "pip", "install", "--target", str(target), *pins],
        env=project_env(),
        cwd=project_dir(),
    )
    if rc != 0:
        cannot("could not install pytest for the in-image run")
    stamp.write_text("\n".join(pins), encoding="utf-8")
    return CLEAN


def project_dir() -> Path:
    """Where the uv project is, which is not always the repo root.

    `[tool.sdlc] project = "image-server"` in the ROOT pyproject.toml points the
    uv-driven checks -- mypy, pytest, pip-audit and the sync they share -- at a
    subdirectory. Everything repo-wide stays at the root: the constitution
    validator, Gourmand, Gatehouse, CodeQL and `ruff check .`, whose own config
    is hierarchical and already picks up a nested pyproject for files under it.

    Written in the root pyproject and nowhere else, because the two hooks and
    the CI job all read that file and must agree; an env var or a CI argument
    would have to be told to three entry points separately.
    """
    raw = pyproject().get("tool", {}).get("sdlc", {}).get("project", ".")
    if not isinstance(raw, str):
        cannot(f"[tool.sdlc] project must be a string, not {type(raw).__name__}")
    if Path(raw).is_absolute() or ".." in Path(raw).parts:
        cannot(f"[tool.sdlc] project must be a relative path inside the repo; got {raw!r}")
    target = (REPO / raw).resolve()
    if not str(target).startswith(str(REPO.resolve())):
        cannot(f"[tool.sdlc] project escapes the repo: {raw!r}")
    if raw != "." and not (target / "pyproject.toml").is_file():
        cannot(f"[tool.sdlc] project {raw!r} has no pyproject.toml")
    return target


def need_project() -> None:
    """Assert this is a Python project, for the targets that require one."""
    if not (project_dir() / "pyproject.toml").is_file():
        cannot(
            "pyproject.toml does not exist, so this target has no project to "
            "check. constitution, gourmand and gatehouse work on any repo; "
            "ruff, mypy, pytest, semgrep and pip-audit need a Python project."
        )


def project_env() -> dict[str, str]:
    """Environment for the uv-managed project venv.

    The venv lives in the cache volume, keyed by project AND Python version.
    gates.sh records why the key needs both: two gates sharing one
    UV_PROJECT_ENVIRONMENT across different Python versions make uv rebuild the
    venv on every invocation, in both directions, forever.
    """
    # The subdirectory is part of the key: one repo can hold two projects, and
    # sharing a venv between them would make uv rebuild it on every invocation.
    sub = project_dir().relative_to(REPO.resolve())
    default = REPO.name if str(sub) == "." else f"{REPO.name}-{str(sub).replace('/', '-')}"
    name = os.environ.get("SDLC_PROJECT", default)
    pyver = f"{sys.version_info.major}.{sys.version_info.minor}"
    env = dict(os.environ)
    env.update(
        {
            "UV_CACHE_DIR": str(CACHE / "uv"),
            "UV_PROJECT_ENVIRONMENT": str(CACHE / "venv" / f"{name}-py{pyver.replace('.', '')}"),
            "UV_PYTHON_DOWNLOADS": "never",
            # The worktree is mounted read-only for most targets and HOME is
            # where uv, pytest and semgrep want to write their state.
            "HOME": "/tmp",
        }
    )
    return env


def run(
    cmd: list[str],
    *,
    env: dict[str, str] | None = None,
    stdin: bytes | None = None,
    tee: bool = False,
    # Where the tool runs. Defaults to the repo root; the uv-driven checks
    # pass the project directory, which [tool.sdlc] project may move.
    cwd: Path | None = None,
) -> tuple[int, str]:
    """Run a tool and return (ITS exit status, captured output).

    Anything that is not the tool's own verdict raises CannotRun.

    `tee=True` captures stderr+stdout AND prints it, for the one caller that has
    to read what the tool said as well as show it.
    """
    try:
        if tee:
            proc = subprocess.run(
                cmd,
                cwd=cwd or REPO,
                env=env if env is not None else dict(os.environ),
                input=stdin,
                check=False,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
            )
            sys.stdout.write(proc.stdout or "")
            sys.stdout.flush()
            captured = proc.stdout or ""
        else:
            proc = subprocess.run(
                cmd,
                cwd=cwd or REPO,
                env=env if env is not None else dict(os.environ),
                input=stdin,
                check=False,
            )
            captured = ""
    except FileNotFoundError:
        cannot(f"{cmd[0]} is not in this image")
    except PermissionError:
        cannot(f"{cmd[0]} is not executable")
    except OSError as exc:
        cannot(f"cannot start {cmd[0]}: {exc}")
    # 126/127 from a shell layer mean the same as the exceptions above: the tool
    # never ran. Never report those as a finding.
    if proc.returncode in (126, 127):
        cannot(f"{cmd[0]} could not be invoked (exit {proc.returncode})")
    return proc.returncode, captured


def need_lock_dep(name: str) -> None:
    """Refuse to claim a pass for a tool the project does not pin.

    mypy and pytest are the two checks whose version comes from the project's
    own uv.lock rather than from this image -- they load the project's plugins
    inside their own interpreter, so they cannot come from a tool venv. That
    makes "the repo forgot to depend on mypy" a real case, and the honest answer
    to it is 2, not 0.
    """
    lock = project_dir() / "uv.lock"
    if not lock.is_file():
        cannot("uv.lock is missing; mypy and pytest resolve from the project lock")
    try:
        text = lock.read_text(encoding="utf-8")
    except OSError as exc:
        cannot(f"cannot read uv.lock: {exc}")
    if f'name = "{name}"' not in text:
        cannot(
            f"{name} is not in uv.lock, so this check cannot run. "
            f"Add it to the project's dev dependencies -- it must come from the "
            f"project environment, not from this image, because it loads the "
            f"project's own plugins."
        )


def sync_project(env: dict[str, str]) -> None:
    """Build the project venv, or fail as 'could not run'."""
    step("uv sync --locked --all-extras")
    rc, _ = run(["uv", "sync", "--locked", "--all-extras"], env=env, cwd=project_dir())
    if rc != 0:
        cannot(
            "uv sync --locked failed. The lockfile is out of date with "
            "pyproject.toml, or a dependency is unavailable. Nothing was checked."
        )


# ---------------------------------------------------------------------- targets


# Every check takes its own settings table, `[tool.sdlc.<command>.<check>]`,
# empty when the repo wrote none. Paths are NOT settings here: each tool reads
# its own config (`[tool.ruff]` excludes, `[tool.mypy] files`,
# `[tool.pytest] testpaths`), so there is one place to say what gets checked.


def passthrough() -> list[str]:
    """What the caller put after `--` on a single-check run.

    `bin/sdlc` joins those words with the unit separator and exports
    SDLC_ARGS. It is deliberately not a plan field: the plan is this script
    telling the host what to run, and `plain()` guards it so that a repo's
    config can never forge a line into the host's shell. This travels the other
    way and ends up in an argv list, so there is no shell between the caller
    and the tool.

    Only a check that is a tool invocation reads this: `pytest`, and `pip-audit`
    for its one `--report`. A tier never sees it -- `bin/sdlc` clears the variable for
    commit/push/ci rather than refusing it, so an exported SDLC_ARGS cannot
    reach a tier's pytest -- and no `host` step argv is built from it.
    """
    raw = os.environ.get("SDLC_ARGS")
    if not raw:
        return []
    # Not filtered: `-k ''` is a legitimate empty argument.
    return raw.split(UNIT_SEPARATOR)


def t_ruff_check(s: dict) -> int:
    need_project()
    step("ruff check --fix .")
    return run(["ruff", "check", "--fix", "."])[0]


def t_ruff_format(s: dict) -> int:
    need_project()
    step("ruff format .")
    return run(["ruff", "format", "."])[0]


def t_lint(s: dict) -> int:
    """What ruff-check and ruff-format would change, as a finding rather than a fix.

    The commit tier's ruff steps rewrite the tree, so a fixable violation passes
    there -- which is right on a laptop and useless as a verdict. This changes
    nothing, so it runs on a read-only tree in the main lane. Both always run,
    so one push reports both kinds of finding.
    `--no-cache` because the tree is read-only and `.ruff_cache` lives in it.

    `--no-fix-only` because a repo's `[tool.ruff] fix-only = true` beats
    `--no-fix`: ruff then reports nothing and exits 0, so lint would pass an
    F821 without a word.
    """
    need_project()
    step("ruff check --no-fix .")
    checked = run(["ruff", "check", "--no-fix", "--no-fix-only", "--no-cache", "."])[0]
    step("ruff format --check .")
    formatted = run(["ruff", "format", "--check", "--no-cache", "."])[0]
    # A syntax error is a finding to `ruff check` (1) and unparsable to the
    # formatter (2). It is the code that is wrong, not the gate, so a finding
    # from either outranks the other's 2.
    if FOUND in (checked, formatted):
        return FOUND
    return max(checked, formatted)


def t_mypy(s: dict) -> int:
    """Type check what `[tool.mypy] files` names. mypy's own exit 2 is ours too.

    `--show-traceback` because a mypy crash is an exit 2 whose only clue is
    the traceback, and without the flag mypy prints a note asking for it
    instead. A crash that happens on one runner pool and not on a rerun cannot
    be asked again (mcp-trove#132). mypy reads the flag only when it crashes,
    and it is not one of the options that key its cache.
    """
    need_project()
    need_lock_dep("mypy")
    env = project_env()
    sync_project(env)
    step("mypy")
    return run(
        [
            "uv",
            "run",
            "--locked",
            "--all-extras",
            "mypy",
            "--show-traceback",
            "--cache-dir",
            str(CACHE / "mypy" / project_name()),
        ],
        env=env,
        cwd=project_dir(),
    )[0]


def t_pytest(s: dict) -> int:
    need_project()
    need_lock_dep("pytest")
    env = project_env()
    for key, value in table(s, "env").items():
        env[str(key)] = token(value)
    sync_project(env)
    jobs = os.environ.get("SDLC_JOBS", "0")
    args = names(s.get("args", ["-q", "-rfE"]), "pytest.args")
    extra = passthrough()
    step("pytest" + ("".join(f" {a}" for a in extra) if extra else ""))
    cmd = [
        "uv",
        "run",
        "--locked",
        "--all-extras",
        "pytest",
        # The worktree is read-only and cacheprovider writes into the rootdir.
        "-p",
        "no:cacheprovider",
        *args,
    ]
    if jobs != "0" and "pytest-xdist" in (project_dir() / "uv.lock").read_text(encoding="utf-8"):
        cmd += ["-n", jobs]
    # LAST, after the config's args and after `-n`, so what the caller asked
    # for on the command line wins: `-- -n0` turns off the parallelism this
    # just added, which is how you read a traceback.
    cmd += extra
    return run(cmd, env=env, cwd=project_dir())[0]


GOURMAND_SIDECARS = (
    "gourmand-exceptions.toml",
    "gourmand-patterns.toml",
    "gourmand-audit-ledger.toml",
)
"""Files gourmand resolves RELATIVE TO gourmand.toml, so each one needs it to exist."""


def gourmand_orphan(root: Path) -> str | None:
    """The sidecar file that would be ignored for want of a gourmand.toml, if there is one."""
    if (root / "gourmand.toml").is_file():
        return None
    return next((name for name in GOURMAND_SIDECARS if (root / name).is_file()), None)


def t_gourmand(s: dict) -> int:
    # With no gourmand.toml, a sidecar file is found on disk, never parsed, and nothing is
    # said about it: the gate goes red listing violations you already justified, which reads
    # exactly like a wrong justification, so the natural response is to rewrite the
    # justification. That cost an evening on this repository before the cause was spotted,
    # and 26 repositories carry an exceptions file. A 2, not a warning: a check that cannot
    # do what it was configured to do must not report as though it did, and a warning
    # scrolls past on a long run with the violation list underneath it.
    orphan = gourmand_orphan(REPO)
    if orphan:
        cannot(
            f"found {orphan} but no gourmand.toml beside it, so no entry in it would be "
            f"loaded. Add a gourmand.toml (an empty [output] table is enough) or remove "
            f"{orphan}"
        )
    # gourmand keeps its cache in .gourmand-cache/ under the tree. CI's check job runs it
    # as the image's non-root user on a checkout it cannot write (and a review mount is
    # read-only), where that is "Permission denied" before a single check: the cache goes
    # to a scratch directory instead whenever the tree is not ours to write.
    if os.access(REPO, os.W_OK):
        step("gourmand check --full")
        return run(["gourmand", "check", "--full", "."])[0]
    with tempfile.TemporaryDirectory(prefix="gourmand-cache-") as cache:
        step("gourmand check --full (cache outside the read-only tree)")
        return run(["gourmand", "check", "--full", "--cache-dir", cache, "."])[0]


def ci_required_findings(consensus: dict) -> list[dict]:
    """The reported findings CI's gate would hold a pull request for.

    `--consensus-json` lists only what Gatehouse reports, after dropping what
    gatehouse-findings.toml has judged, so every record is one CI would post.
    The rule is sdlc_jobs._findings', the one the `gate` job applies.
    """
    requires_answer = job_module("_findings").requires_answer
    return [
        f
        for f in consensus.get("findings", [])
        if requires_answer(str(f.get("severity", "")), str(f.get("agent", "")))
    ]


def t_gatehouse(s: dict) -> int:
    """Review the branch. The diff arrives on stdin, computed by the host.

    It is the host's job because the diff needs origin fetched, which needs the
    developer's git credentials and network -- neither of which belongs in this
    container. The verdict is CI's: a finding the fleet's gate would make the
    pull request answer fails here too, so it is fixed, or judged in
    gatehouse-findings.toml, before a CI cycle is spent finding it.
    """
    diff = sys.stdin.buffer.read()
    if not diff.strip():
        print("nothing to review: the diff is empty")
        return 0
    samples = os.environ.get("SDLC_GATEHOUSE_SAMPLES")
    with tempfile.TemporaryDirectory() as tmp:
        consensus = Path(tmp) / "consensus.json"
        required_low = job_module("_findings").REQUIRED_LOW_AGENTS
        cmd = [
            "gatehouse",
            "--stdin",
            "--required-low-agents",
            ",".join(required_low),
            "--consensus-json",
            str(consensus),
        ]
        if samples:
            cmd += ["--samples", samples]
        step(f"gatehouse --stdin ({len(diff)} bytes)")
        rc = run(cmd, stdin=diff)[0]
        if rc != 0:
            return rc
        try:
            required = ci_required_findings(json.loads(consensus.read_text()))
        except (OSError, ValueError) as err:
            cannot(f"gatehouse wrote no readable --consensus-json ({err})")
    if required:
        print(
            f"{len(required)} finding(s) above are ones CI's gate would hold the pull "
            f"request for: fix each, or judge it in gatehouse-findings.toml"
        )
        return 1
    return 0


def t_semgrep(s: dict) -> int:
    """The repo's own rules. Semgrep has no file-based scan list, so `paths`
    is the one path setting here; `.semgrepignore` narrows it further."""
    need_project()
    config = str(s.get("config", ".semgrep"))
    if not (REPO / config).exists():
        cannot(f"semgrep config {config} does not exist; set config in its table, or skip it")
    tests = str(s.get("tests", ".semgrep/run-tests.sh"))
    sarif_dir = sarif_dir_from_env()
    # The rule tests are the repo's own shell. Under `sdlc sarif` they would run
    # with the uploader's directory mounted writable, free to plant or replace
    # what goes to code scanning; `sdlc ci` has already run them on this tree.
    if sarif_dir is None and (REPO / tests).is_file():
        step(f"semgrep rule tests ({tests})")
        rc, _ = run(["sh", tests], env=project_env())
        if rc != 0:
            return rc
    paths = names(s.get("paths", ["."]), "semgrep.paths")
    missing = [p for p in paths if not (REPO / p).exists()]
    if missing:
        cannot(f"semgrep paths do not exist: {', '.join(missing)}")
    step(f"semgrep scan --config {config}")
    argv = ["semgrep", "scan", "--config", config, "--error", "--metrics=off"]
    # `sdlc sarif` mounts a directory for the check job's uploader. The flag
    # writes a COPY of the SARIF beside the normal output, so what is printed
    # and the exit status (--error) are the same with or without it.
    if sarif_dir is not None:
        argv.append(f"--sarif-output={sarif_dir / 'semgrep.sarif'}")
    return run([*argv, *paths], env=project_env())[0]


def sarif_dir_from_env() -> Path | None:
    """`SDLC_SARIF_DIR`, when it names a directory; None leaves a check unchanged.

    Set only by the launcher's `sarif` target, which mounts the check job's
    directory there. A value that is not a directory is ignored rather than
    created: the mount is the job's decision, and a check must not invent a
    path the uploader never reads.
    """
    raw = os.environ.get("SDLC_SARIF_DIR", "")
    return Path(raw) if raw and Path(raw).is_dir() else None


# pip-audit's own --timeout is pip's 15s socket default. On a runner whose cores
# are all busy that is too short for a read that PyPI answers in well under a
# second when idle, so the timeout is raised and a network failure is retried
# before it is reported. The delays are the pauses BETWEEN attempts.
PIP_AUDIT_TIMEOUT = 60
PIP_AUDIT_BACKOFF = (10, 30)

# What pip-audit, or the `uv run --with pip-audit` that fetches it, prints when
# the network failed rather than the scan. pip-audit 2.9.0 turns a connect
# timeout into "Could not connect ..." and lets a READ timeout, a reset or a
# 5xx escape as a raw requests traceback -- every one of them exit 1, which is
# the same status as "found a vulnerability". None of these is a verdict.
_PIP_AUDIT_NETWORK = re.compile(
    r"ReadTimeout|ConnectTimeout|ConnectionError|ProxyError|SSLError"
    r"|Max retries exceeded|Could not connect to PyPI|PyPI is not redirecting"
    r"|requests\.exceptions\.HTTPError|Failed to fetch|error sending request"
)


# pip-audit's summary when it finished auditing and found something
# (_cli.py:607 in 2.9.0). It is printed only after every lookup came back, so a
# run that printed it reached a verdict, whatever else is in its output.
_PIP_AUDIT_FOUND = re.compile(r"^Found \d+ known vulnerabilit", re.MULTILINE)


def _dist(name: str) -> str:
    """A distribution name normalised as PEP 503 does, so lock, venv and pip-audit agree."""
    return re.sub(r"[-_.]+", "-", name).lower()


def locked_registry(lock: Path) -> tuple[set[str], set[str]]:
    """Packages uv.lock resolves from a registry: (from PyPI itself, from any registry).

    The PyPI ones all have a PyPI record by construction, so pip-audit reporting
    one of them "not found on PyPI" means the lookup failed, not that it is
    unauditable.
    """
    try:
        data = tomllib.loads(lock.read_text(encoding="utf-8"))
    except (OSError, tomllib.TOMLDecodeError) as exc:
        cannot(f"cannot read {lock}: {exc}")
    registry = {
        _dist(str(pkg.get("name", ""))): str((pkg.get("source") or {}).get("registry", ""))
        for pkg in data.get("package", [])
        if (pkg.get("source") or {}).get("registry")
    }
    return {n for n, url in registry.items() if "pypi.org" in url}, set(registry)


def installed(env: dict[str, str]) -> set[str]:
    """Distributions installed in the project venv, which is what pip-audit audits."""
    venv = Path(env.get("UV_PROJECT_ENVIRONMENT", ""))
    return {
        _dist(d.name.removesuffix(".dist-info").rsplit("-", 1)[0])
        for d in venv.glob("lib/python*/site-packages/*.dist-info")
    }


def pip_audit_once(env: dict[str, str], report: Path | None = None) -> tuple[int, str, list[str]]:
    """One pip-audit run: (its status, its output, what it skipped as not found).

    It runs inside the project venv, so it comes from `--with` rather than the
    image's own tool install -- pinned to that install's version, because the
    network-failure patterns above are read from that version's code.

    With `report`, pip-audit writes its JSON report there. Its summary line stays
    on stderr, but the skip reasons move into the report, so they are read back
    from it.
    """
    version = BAKED["pip-audit"]
    if version == "unknown":
        cannot("SDLC_PIP_AUDIT_VERSION is not set, so pip-audit has no version to pin")
    rc, out = run(
        [
            "uv",
            "run",
            "--locked",
            "--all-extras",
            "--with",
            f"pip-audit=={version}",
            "pip-audit",
            "--timeout",
            str(PIP_AUDIT_TIMEOUT),
            "--progress-spinner",
            "off",
            *(["--format", "json", "--output", str(report)] if report else []),
        ],
        env=env,
        cwd=project_dir(),
        tee=True,
    )
    lines = out.splitlines()
    if report is not None:
        lines += [str(d.get("skip_reason")) for d in pip_audit_report(report, missing={})]
    unaudited = sorted(
        {
            line.split("could not be audited:")[-1].strip()
            for line in lines
            if "could not be audited" in line
        }
    )
    return rc, out, unaudited


# The line `pip-audit -- --report` prints its report on, for the weekly `check`
# job (sdlc_jobs/check.py), which hands it to the constitution's audit_alert.
AUDIT_REPORT = "SDLC-AUDIT-REPORT "


def pip_audit_report(path: Path, *, missing: dict | None = None) -> list[dict]:
    """The dependencies of pip-audit's JSON report; `missing` stands in for no file."""
    try:
        doc = json.loads(path.read_text(encoding="utf-8")) if path.is_file() else missing
    except (OSError, ValueError) as exc:
        cannot(f"pip-audit's report did not read as JSON: {exc}")
    if doc is None:
        cannot("pip-audit wrote no report")
    deps = doc.get("dependencies", []) if isinstance(doc, dict) else None
    if not isinstance(deps, list) or not all(isinstance(d, dict) for d in deps):
        cannot("pip-audit's report has no dependencies list")
    return deps


def pip_audit_report_path() -> Path | None:
    """Where a `-- --report` run writes its JSON report; None without one."""
    args = passthrough()
    if args not in ([], ["--report"]):
        cannot("pip-audit takes one argument, --report, after `--`")
    return Path(tempfile.mkdtemp(prefix="sdlc-audit-")) / "audit.json" if args else None


def print_pip_audit_report(report: Path) -> None:
    deps = pip_audit_report(report)
    print(AUDIT_REPORT + json.dumps({"dependencies": deps}, separators=(",", ":")), flush=True)


def t_pip_audit(s: dict) -> int:
    """Audit the project's locked dependencies, and GATE on it.

    17 repos in the fleet run this as `pip-audit … || true`, which means the
    scan cannot fail and has never once blocked anything. This one returns the
    tool's verdict -- and only the tool's verdict. A network failure is retried,
    and one that outlasts the retries is a 2, never a 1 that reads as a finding
    and never a 0 that reads as a pass.
    """
    need_project()
    report = pip_audit_report_path()
    try:
        return pip_audit_gate(report)
    finally:
        if report is not None:
            shutil.rmtree(report.parent, ignore_errors=True)


def pip_audit_gate(report: Path | None) -> int:
    """t_pip_audit's run: sync, audit with retries, and print the report if asked."""
    env = project_env()
    sync_project(env)
    pypi, registry = locked_registry(project_dir() / "uv.lock")
    # NOT --strict. A local path dependency is legitimately absent from PyPI --
    # trentina vendors `petit-plus` from tests/fixtures -- and --strict turns
    # "could not audit this one" into a failed gate. The fleet's own
    # dependency-audit.yml runs without it, and a local gate that is stricter
    # than CI trains people to skip the local gate.
    #
    # The cost is that an unauditable package passes quietly, so it is reported
    # explicitly below rather than left in the log for nobody. A package the
    # lock takes from PyPI cannot be unauditable, though: "not found" for one of
    # those is a lookup that failed -- an egress proxy answering 404 skips every
    # package and exits 0 -- so it is retried with the network failures. So is
    # a run that skipped every registry package it should have audited, which
    # is the same failure behind a mirror, where none of them is from PyPI.
    attempts = len(PIP_AUDIT_BACKOFF) + 1
    for attempt in range(1, attempts + 1):
        step(f"pip-audit (attempt {attempt} of {attempts})" if attempt > 1 else "pip-audit")
        if report is not None:
            report.unlink(missing_ok=True)
        rc, out, unaudited = pip_audit_once(env, report)
        # A verdict is a verdict: a finding next to a skipped package or uv's
        # own network noise is still a finding, and retrying it would turn a 1
        # into a 2 on every run.
        if _PIP_AUDIT_FOUND.search(out):
            break
        skipped = {_dist(u.split(" (")[0]) for u in unaudited}
        auditable = installed(env) & registry
        lost = skipped & pypi
        if lost:
            why = f"PyPI answered 'not found' for {len(lost)} package(s) uv.lock takes from PyPI"
        elif auditable and auditable <= skipped:
            why = f"every one of the {len(auditable)} registry packages was skipped"
        elif rc != CLEAN and _PIP_AUDIT_NETWORK.search(out):
            why = "the PyPI lookup failed on the network"
        else:
            break
        if attempt == attempts:
            cannot(
                f"pip-audit could not run: {why}, on all {attempts} attempts "
                f"(timeout {PIP_AUDIT_TIMEOUT}s). The audit never completed, so this is "
                f"neither a pass nor a finding."
            )
        delay = PIP_AUDIT_BACKOFF[attempt - 1]
        print(f"\npip-audit: {why}; retrying in {delay}s.", flush=True)
        time.sleep(delay)
    if unaudited:
        print(
            "\nNOT AUDITED -- no PyPI record, so these were skipped rather than "
            "cleared:\n  "
            + "\n  ".join(unaudited)
            + "\nA local path or vendored dependency is expected here. Anything "
            "else in this list is a real gap in the scan."
        )
    if report is not None and rc in (CLEAN, FOUND):
        print_pip_audit_report(report)
    return rc


def t_constitution(s: dict) -> int:
    """Judge the repo by the constitution it is on.

    v2 (constitution 2.0.0): a repo that carries no per-repo constitution is
    judged by `sdlc-constitution check`, whose rules ship in this image, so a
    rule change reaches every converted repo as one sdlc release (G5).

    v1: a repo that still carries its manifest is validated against the
    constitution IT pins, cloned at the tag the manifest names, never baked into
    this image. Two reasons, and both matter: the fleet spans many v1 releases,
    so a baked copy would judge most repos by rules they have not adopted; and
    the validator resolves `constitution.md` and `profiles/` from its own
    directory, so a partial copy makes its pin, file and version checks silently
    vanish rather than fail.
    """
    manifest = Path(str(s.get("manifest", ".specify/memory/constitution.md")))
    if not (REPO / manifest).is_file():
        return run(["sdlc-constitution", "check", str(REPO)], env=project_env())[0]
    return run(["sdlc-validate", str(manifest)], env=project_env())[0]


def t_codeql(s: dict) -> int:
    default_config = ".github/codeql/codeql-config.yml"
    config = str(s.get("config", default_config))
    # A config the repo NAMED and that is not there is a missing config path,
    # which the contract says is a 2 -- silently falling back to a default query
    # suite would run a different analysis than the repo asked for and call it a
    # pass. A repo that simply has no config, and named none, gets the default
    # suite; that is not a missing path.
    if config != default_config and not (REPO / config).is_file():
        cannot(f"codeql config {config} does not exist")
    sarif_dir = sarif_dir_from_env()
    # `sdlc sarif` keeps nothing on the cache volume. `sdlc ci` ran the repo's
    # own code (pytest, conftest) with that volume writable just before, so a
    # compiled query plan there could be the repo's, and what this run uploads
    # must not rest on it. A cold compile is the price: 1-3 minutes.
    work = CACHE if sarif_dir is None else Path("/tmp/codeql-sarif")
    db = work / "codeql" / project_name()
    # Held until this process exits. The database directory is named for the
    # worktree's basename, so two checkouts that share one -- or a push retried
    # while the last is still running -- used ONE directory: each deleted the
    # other's database mid-run, which left half-built caches and analyses dying
    # with nothing to read (#33).
    lock_codeql(db)
    # Compiled query plans, kept between runs. CodeQL's default is ~/.codeql,
    # which is /tmp in this image and gone when the container exits, so every
    # run compiled all of security-extended again: 1m32s-3m13s of trentina's
    # analysis, against 46s for the whole analysis on a warm cache. Shared by
    # every repo on the volume, which is the point -- the standard packs are the
    # same bytes everywhere -- and keyed by CodeQL on each query's own hash, so
    # a changed query recompiles and nothing stale is reused.
    caches = work / "codeql-common"
    sarif = Path("/tmp/codeql-results.sarif")
    clear_database(db)
    # An unwritable cache is a 2, not a traceback and not a 1. The same bug in
    # `validate` surfaced as a PermissionError stack trace with an exit status
    # that claimed a finding.
    try:
        caches.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        cannot(f"cannot create the CodeQL database directory {db.parent}: {exc}")
    ram = f"--ram={codeql_ram_mb()}"

    create = [
        "codeql",
        "database",
        "create",
        str(db),
        "--language=python",
        "--source-root=.",
        "--overwrite",
        f"--common-caches={caches}",
        ram,
    ]
    analyze = [
        "codeql",
        "database",
        "analyze",
        str(db),
        "--format=sarif-latest",
        f"--output={sarif}",
        f"--threads={os.environ.get('SDLC_JOBS', '0')}",
        f"--common-caches={caches}",
        ram,
    ]

    # `--codescanning-config` is NOT a CLI flag in 2.27.4, on either subcommand.
    # `database analyze --help` describes it ("if a Code Scanning configuration
    # file was specified at database creation time using --codescanning-config")
    # but that is the Action's internal flow; `create` does not list it and
    # `analyze` rejects it outright with "Unknown option". Both were tried.
    #
    # So the config is read HERE and applied in two parts: the query list goes
    # to `analyze`, and `paths-ignore` filters the SARIF afterwards.
    #
    # Honouring paths-ignore is not a nicety. trentina's config excludes
    # `tests/fixtures/boundary-review`, which holds DELIBERATELY vulnerable code
    # used to grade a reviewer. Analyse without it and the local gate reports a
    # pile of findings CI does not, which teaches people to ignore the gate.
    queries, ignores = read_codeql_config(REPO / config)
    analyze += queries or ["python-security-extended.qls"]
    run_codeql(create, analyze, sarif)
    if sarif_dir is not None:
        export_sarif(sarif, ignores, sarif_dir / "codeql-results.sarif")
    return report_sarif(sarif, ignores, baseline_path(s))


def path_ignored(artifact: str, ignores: list[str]) -> bool:
    """Does a SARIF artifact URI fall under a `paths-ignore` entry?

    This is the local stand-in for the config the CodeQL CLI will not read, so
    it has to match CodeQL's own semantics, and those include GLOBS -- `tests/**`
    and `**/vendor/*` are both legal in a code-scanning config. Matching only
    literal paths and directory prefixes would silently fail to suppress them,
    and the local gate would then report -- and fail on -- findings CI
    ignores.

    Three forms, because CodeQL accepts all three:
      - an exact path
      - a directory, suppressing everything beneath it
      - a glob, where `**` crosses separators and `*` does not
    """
    for entry in ignores:
        item = entry.strip().rstrip("/")
        if not item:
            continue
        if artifact == item or artifact.startswith(item + "/"):
            return True
        if not any(c in item for c in "*?["):
            continue
        pattern = _glob_to_regex(item)
        if re.fullmatch(pattern, artifact) or re.fullmatch(pattern + r"/.*", artifact):
            return True
    return False


def _glob_to_regex(glob: str) -> str:
    """Translate a code-scanning path glob to a regex.

    Hand-built rather than handed to `fnmatch`, because fnmatch's `*` crosses
    `/` -- which is what `**` means and what `*` must not do.
    """
    out = ""
    for part in re.split(r"(\*\*/?|\*|\?)", glob):
        if part == "**/":
            out += r"(?:.*/)?"
        elif part == "**":
            out += r".*"
        elif part == "*":
            out += r"[^/]*"
        elif part == "?":
            out += r"[^/]"
        else:
            out += re.escape(part)
    return out


def read_codeql_config(path: Path) -> tuple[list[str], list[str]]:
    """Read `queries:` and `paths-ignore:` out of the Action's config format.

    Parsed here rather than trusted entirely to the CLI flag so that the query
    set is explicit and the ignore list is available as a backstop filter. The
    one mapping that matters: a bare suite name like `security-extended` is the
    Action's shorthand for this language's `.qls`.
    """
    if not path.is_file():
        return [], []
    try:
        data = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
    except Exception as exc:
        cannot(f"cannot read {path}: {exc}")
    queries: list[str] = []
    for entry in data.get("queries") or []:
        uses = (entry or {}).get("uses") if isinstance(entry, dict) else entry
        if not uses:
            continue
        if str(uses).startswith("."):
            queries.append(str(uses))
        else:
            queries.append(f"python-{uses}.qls")
    ignores = [str(p) for p in (data.get("paths-ignore") or [])]
    return queries, ignores


def lock_codeql(db: Path) -> None:
    """Take this project's CodeQL lock, waiting for whoever holds it."""
    try:
        db.parent.mkdir(parents=True, exist_ok=True)
        # Deliberately never closed: the lock is released when the process ends.
        fd = os.open(db.parent / f"{db.name}.lock", os.O_RDWR | os.O_CREAT, 0o644)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print(f"codeql: another run holds {db.name}'s database; waiting for it", flush=True)
            fcntl.flock(fd, fcntl.LOCK_EX)
    except OSError as exc:
        cannot(f"cannot lock the CodeQL database directory {db.parent}: {exc}")


def clear_database(db: Path) -> None:
    """Remove the last run's database, and PROVE it is gone.

    Nothing in it is reused, so a half-built one -- `trap/` and `working/` with
    no `db-python`, from a run that was killed -- is just a cache miss. This
    used to be `rmtree(ignore_errors=True)`, and when that quietly left anything
    behind, `create --overwrite` refused the directory as "not a CodeQL
    database" and a person had to delete it by hand.
    """
    errors: list[str] = []

    def retry(func: Callable[[str], object], path: str, _exc: BaseException) -> None:
        # A read-only directory cannot have its entries unlinked; open it up
        # and try once more before recording the failure.
        try:
            os.chmod(os.path.dirname(path) or ".", 0o700)
            if os.path.isdir(path) and not os.path.islink(path):
                os.chmod(path, 0o700)
            func(path)
        except OSError as again:
            errors.append(f"{path}: {again}")

    if db.exists() or db.is_symlink():
        shutil.rmtree(db, onexc=retry)
    if db.exists() or db.is_symlink():
        cannot(f"cannot clear the previous CodeQL database {db}: {'; '.join(errors[:3])}")


def memory_limit_mb() -> int | None:
    """The smallest memory ceiling this container can see, in MB.

    Three sources, because none is reliable alone. `SDLC_MEMORY` is the budget
    the launcher gave `podman run --memory`, which rootless podman silently
    drops when the cgroup memory controller is not delegated -- a gate inside a
    developer container is exactly that. The cgroup's own `memory.max` is the
    one the kernel enforces. MemTotal is the machine.
    """
    found: list[int] = []
    budget = os.environ.get("SDLC_MEMORY", "").strip().lower()
    match = re.fullmatch(r"(\d+)([kmg]?)b?", budget)
    if match:
        scale = {"": 1 / 2**20, "k": 1 / 1024, "m": 1, "g": 1024}[match.group(2)]
        found.append(int(int(match.group(1)) * scale))
    try:
        cg = Path("/sys/fs/cgroup/memory.max").read_text(encoding="utf-8").strip()
        if cg.isdigit():
            found.append(int(cg) // 2**20)
    except OSError:
        pass
    try:
        for line in Path("/proc/meminfo").read_text(encoding="utf-8").splitlines():
            if line.startswith("MemTotal:"):
                found.append(int(line.split()[1]) // 1024)
    except OSError, ValueError, IndexError:
        pass
    return min((f for f in found if f > 0), default=None)


def codeql_ram_mb() -> int:
    """`--ram` for the evaluator: three quarters of the ceiling, never under 2048.

    Left to itself CodeQL does not look at the container at all. `codeql
    resolve ram` gave a 1509 MB heap in a container with 8g and in one with 2g
    alike, and 1253 MB on josui-skills' dataset -- where analyze then died with
    status 70 (#33). The 8g the launcher budgets was never used.

    The quarter left over is for the JVM outside its heap, file-backed maps of
    the dataset, and /tmp, which is a tmpfs and so is charged to this same
    cgroup. 2048 is CodeQL's own floor; it rounds anything smaller up.
    """
    limit = memory_limit_mb()
    return max(2048, limit * 3 // 4) if limit else 2048


def ci_judges() -> bool:
    """Is a push's CodeQL also judged by CI on this same commit?

    True only at the push tier, outside CI, with codeql in the ci tier and a
    workflow that RUNS `bin/sdlc ci`. Anywhere else -- `sdlc ci` itself, the
    inner loop's `sdlc codeql`, a repo without that workflow -- nobody else
    will judge the commit, and a check that could not run stays a 2.
    """
    if os.environ.get("SDLC_TIER") != "push" or os.environ.get("CI"):
        return False
    if "codeql" not in resolve(sdlc_config(), "ci"):
        return False
    workflows = REPO / ".github" / "workflows"
    try:
        files = [*workflows.glob("*.yml"), *workflows.glob("*.yaml")]
    except OSError as exc:
        print(f"codeql: cannot read {workflows}, so nothing may be deferred: {exc}", flush=True)
        return False
    # The launcher knows it; 10 of the 69 checkouts in this fleet are not main.
    default = (os.environ.get("SDLC_DEFAULT_BRANCH") or "").removeprefix("origin/")
    for f in files:
        try:
            if runs_sdlc_ci(f.read_text(encoding="utf-8", errors="replace"), default):
                return True
        except OSError as exc:
            print(f"codeql: cannot read {f}, so it cannot grant a deferral: {exc}", flush=True)
    return False


JUDGING_EVENTS = ("pull_request", "pull_request_target", "merge_group", "push")

# A path ending in `bin/sdlc`, then `ci` as its argument: how a workflow
# actually invokes the gate (`$RUNNER_TEMP/sdlc/bin/sdlc ci`).
_RUNS_SDLC_CI = re.compile(r"""(?:^|[\s;&|("'=])\S*bin/sdlc\s+ci\b""")


def runs_sdlc_ci(text: str, default_branch: str) -> bool:
    """Does this workflow RUN the gate, in a job that this commit reaches?

    Not "does the text `sdlc ci` appear in it". Every way of answering that
    question loosely hands a push a verdict nobody ever reaches, and each of
    these was a real finding against an earlier version of this function:

    - trentina carries `VERIFIER_JOB: sdlc ci` as a job name and `sdlc ci`
      inside an error message. So the invocation is looked for in parsed
      `steps[].run` scripts only -- never in a comment, a `name:`, an `env:`
      value or an echoed string (#34).
    - a job or step behind an `if:` may be skipped on this very commit, so a
      conditional one grants nothing.
    - a workflow triggered only by `workflow_dispatch` or `schedule` judges
      nothing anybody pushed, and `on: push` filtered to another branch is the
      same gap wearing the right event name. The trigger has to reach
      `default_branch`, which is the branch XII's required status check guards.

    A workflow this cannot parse grants nothing.
    """
    try:
        doc = yaml.safe_load(text)
    except yaml.YAMLError:
        return False
    if not isinstance(doc, dict):
        return False
    return judges_a_commit(doc, default_branch) and any_step_runs_the_gate(doc)


def judges_a_commit(doc: dict, default_branch: str) -> bool:
    """Does a trigger of this workflow cover the default branch?

    `on:` is YAML 1.1's boolean `True` once parsed, which is why both keys are
    looked for.
    """
    on = doc.get("on", doc.get(True))
    if isinstance(on, str):
        events: dict[str, object] = {on: None}
    elif isinstance(on, list):
        events = {e: None for e in on if isinstance(e, str)}
    elif isinstance(on, dict):
        events = {k: v for k, v in on.items() if isinstance(k, str)}
    else:
        return False
    return any(covers_branch(events[e], default_branch) for e in JUDGING_EVENTS if e in events)


def covers_branch(filters: object, branch: str) -> bool:
    """Does this event's branch filter reach `branch`?

    GitHub applies `branches` in order and lets a later `!pattern` take a
    branch back out, which a set of names cannot express: `['**', '!main']`
    excludes `main` while containing a pattern that matches everything
    (Gatehouse, on the first version of this). Rather than reimplement that
    ordering, a filter carrying any negation grants nothing, and so does
    `branches-ignore`, which cannot be evaluated without knowing every branch.
    """
    if not isinstance(filters, dict):
        return True
    if "branches-ignore" in filters:
        return False
    branches = filters.get("branches")
    if branches is None:
        return True
    if not isinstance(branches, list) or not all(isinstance(b, str) for b in branches):
        return False
    if any(b.startswith("!") for b in branches):
        return False
    return bool(branch) and any(branch_matches(b, branch) for b in branches)


def branch_matches(pattern: str, branch: str) -> bool:
    """GitHub's filter-pattern glob, where `*` stops at a `/` and `**` does not."""
    out = ["^"]
    i = 0
    while i < len(pattern):
        c = pattern[i]
        if c == "*":
            if pattern[i + 1 : i + 2] == "*":
                out.append(".*")
                i += 2
                continue
            out.append("[^/]*")
        elif c == "?":
            out.append("[^/]")
        elif c == "+":
            out.append(".")
        else:
            out.append(re.escape(c))
        i += 1
    out.append("$")
    return re.match("".join(out), branch) is not None


def any_step_runs_the_gate(doc: dict) -> bool:
    """Is there an unconditional `steps[].run` that invokes `bin/sdlc ci`?"""
    jobs = doc.get("jobs")
    if not isinstance(jobs, dict):
        return False
    for job in jobs.values():
        if not isinstance(job, dict) or job.get("if") is not None:
            continue
        steps = job.get("steps")
        if not isinstance(steps, list):
            continue
        for step in steps:
            if not isinstance(step, dict) or step.get("if") is not None:
                continue
            run = step.get("run")
            if isinstance(run, str) and invokes_the_gate(run):
                return True
    return False


def invokes_the_gate(script: str) -> bool:
    """Does this shell script run the gate, rather than talk about it?"""
    for raw in script.splitlines():
        line = raw.split("#", 1)[0]
        if "echo" in line or "printf" in line:
            continue
        if _RUNS_SDLC_CI.search(line):
            return True
    return False


def codeql_broke(msg: str) -> NoReturn:
    """CodeQL itself failed: defer to CI when CI will judge, otherwise a 2.

    Only for the TOOL breaking. A config the repo got wrong stays a 2 wherever
    it is found, because CI would fail on it in exactly the same way.
    """
    if ci_judges():
        raise DeferredError(msg)
    cannot(msg)


def run_codeql(create: list[str], analyze: list[str], sarif: Path) -> None:
    """Build the database and analyse it, or report that it could not run.

    Either step failing means no verdict was reached, which is a 2 -- except
    on a push whose CI will judge the same commit, where `codeql_broke` makes
    it a 3 and says so loudly (constitution XII, v1.35.0).
    """
    step("codeql database create")
    rc, _ = run(create, env=project_env())
    if rc != 0:
        codeql_broke(f"codeql could not build a database (exit {rc}); nothing was analysed")
    step("codeql database analyze")
    rc, _ = run(analyze, env=project_env())
    if rc != 0:
        # Analysis failing is not the tool's verdict ON the code -- it means no
        # verdict was reached, which the exit-code contract makes a 2, or a 3
        # where CI will judge this commit.
        codeql_broke(f"codeql database analyze failed (exit {rc}); nothing was judged")


def baseline_path(s: dict) -> Path:
    return REPO / str(s.get("baseline", ".sdlc/codeql-baseline.json"))


def result_uri(result: dict) -> str:
    """The artifact a SARIF result points at, or `?` when it names none."""
    phys = ((result.get("locations") or [{}])[0]).get("physicalLocation") or {}
    return (phys.get("artifactLocation") or {}).get("uri", "?")


def read_sarif(sarif: Path) -> dict:
    """CodeQL's SARIF, held to the shape the filters walk: an object whose runs are objects."""
    try:
        data = json.loads(sarif.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        cannot(f"codeql wrote no readable SARIF: {exc}")
    runs = data.get("runs", []) if isinstance(data, dict) else None
    if not isinstance(runs, list) or not all(isinstance(r, dict) for r in runs):
        cannot(f"codeql wrote SARIF without a list of runs: {sarif}")
    data["runs"] = runs
    for run_ in runs:
        results = run_.get("results", [])
        if not isinstance(results, list) or not all(isinstance(r, dict) for r in results):
            cannot(f"codeql wrote a SARIF run whose results are not objects: {sarif}")
        run_["results"] = results
    return data


def export_sarif(sarif: Path, ignores: list[str], dest: Path) -> None:
    """Write CodeQL's SARIF to `dest` without the results under `paths-ignore`.

    The code-scanning Action honours `paths-ignore` itself; the CLI does not, so
    uploading the raw file would put a repo's deliberately vulnerable fixtures
    in the Security tab -- the same findings the local gate already filters.
    The BASELINE is not applied: it is a gating decision ("a person has looked
    at this"), and an alert the Security tab shows is how it is triaged there.

    Written to a temp file and renamed, so the uploader never reads half a file.
    """
    data = read_sarif(sarif)
    for run_ in data["runs"]:
        run_["results"] = [
            r for r in run_.get("results", []) if not path_ignored(result_uri(r), ignores)
        ]
    tmp = dest.with_name(f".{dest.name}.tmp")
    try:
        tmp.write_text(json.dumps(data), encoding="utf-8")
        tmp.replace(dest)
    except OSError as exc:
        tmp.unlink(missing_ok=True)
        cannot(f"cannot write the SARIF to {dest}: {exc}")


def sarif_findings(sarif: Path, ignores: list[str]) -> list[dict]:
    """Every result outside `paths-ignore`, with the key a baseline matches on."""
    data = read_sarif(sarif)
    out = []
    for run_ in data["runs"]:
        for result in run_.get("results", []):
            phys = ((result.get("locations") or [{}])[0]).get("physicalLocation") or {}
            uri = result_uri(result)
            if path_ignored(uri, ignores):
                continue
            line = (phys.get("region") or {}).get("startLine", "?")
            # The line HASH, not the line number, so a finding that moves
            # because code was added above it is still the same finding.
            fingerprint = (result.get("partialFingerprints") or {}).get(
                "primaryLocationLineHash", f"line:{line}"
            )
            out.append(
                {
                    "rule": result.get("ruleId", "?"),
                    "path": uri,
                    "fingerprint": fingerprint,
                    "line": line,
                    "message": (result.get("message") or {}).get("text", ""),
                }
            )
    return out


def finding_key(f: dict) -> tuple[str, str, str]:
    return (f["rule"], f["path"], f["fingerprint"])


def report_sarif(sarif: Path, ignores: list[str], baseline: Path) -> int:
    """Fail on any finding that is not in the committed baseline.

    CodeQL in the push tier has to be able to fail, or it is a check that cannot
    fail sitting next to ones that can. But trentina's green main carries 19
    findings that were triaged and accepted in GitHub's Security tab, which this
    cannot see. The baseline is that acceptance, committed: the findings a
    person has looked at. Anything not in it is new, and new blocks.

    `sdlc codeql-baseline` writes it. With no baseline file, every finding is
    new.
    """
    accepted: set[tuple[str, str, str]] = set()
    if baseline.is_file():
        try:
            for entry in json.loads(baseline.read_text(encoding="utf-8")):
                accepted.add((entry["rule"], entry["path"], entry["fingerprint"]))
        except (OSError, ValueError, KeyError, TypeError) as exc:
            cannot(f"cannot read the CodeQL baseline {baseline.relative_to(REPO)}: {exc}")
    findings = sarif_findings(sarif, ignores)
    new = [f for f in findings if finding_key(f) not in accepted]
    known = len(findings) - len(new)
    for f in new:
        print(f"  NEW {f['path']}:{f['line']} [{f['rule']}] {f['message']}")
    print(f"codeql: {len(new)} new, {known} in the baseline")
    return FOUND if new else CLEAN


def t_codeql_baseline() -> int:
    """Accept every current finding: write them to the baseline file.

    The one deliberate way to make a finding stop failing besides fixing it, and
    it lands in a commit someone reviews.
    """
    settings = check_settings(sdlc_config(), "codeql")
    config = str(settings.get("config", ".github/codeql/codeql-config.yml"))
    _, ignores = read_codeql_config(REPO / config)
    # Its verdict does not matter here: findings are what is being accepted.
    t_codeql(settings)
    sarif = Path("/tmp/codeql-results.sarif")
    findings = sorted(sarif_findings(sarif, ignores), key=finding_key)
    path = baseline_path(settings)
    path.parent.mkdir(parents=True, exist_ok=True)
    entries = [{k: f[k] for k in ("rule", "path", "fingerprint")} for f in findings]
    path.write_text(json.dumps(entries, indent=2) + "\n", encoding="utf-8")
    print(f"wrote {len(entries)} finding(s) to {path.relative_to(REPO)}")
    return CLEAN


