PYTEST_PACKAGES = ("pytest", "pytest-asyncio", "pytest-xdist", "pytest-timeout")


def t_pytest_deps() -> int:
    """Install the lock's pytest into the cache volume for `pytest-in-image`."""
    need_lock_dep("pytest")
    lock = tomllib.loads((project_dir() / "uv.lock").read_text(encoding="utf-8"))
    pins = sorted(
        f"{pkg['name']}=={pkg['version']}"
        for pkg in lock.get("package", [])
        if pkg.get("name") in PYTEST_PACKAGES and pkg.get("version")
    )
    target = CACHE / "pytest" / project_name()
    stamp = target / ".sdlc-pins"
    if stamp.is_file() and stamp.read_text(encoding="utf-8") == "\n".join(pins):
        return CLEAN
    shutil.rmtree(target, ignore_errors=True)
    step(f"install {', '.join(pins)} for the in-image run")
    rc, _ = run(
        ["uv", "pip", "install", "--target", str(target), *pins],
        env=project_env(),
        cwd=project_dir(),
    )
    if rc != 0:
        cannot("could not install pytest for the in-image run")
    stamp.write_text("\n".join(pins), encoding="utf-8")
    return CLEAN


def project_dir() -> Path:
    """Where the uv project is, which is not always the repo root.

    `[tool.sdlc] project = "image-server"` in the ROOT pyproject.toml points the
    uv-driven checks -- mypy, pytest, pip-audit and the sync they share -- at a
    subdirectory. Everything repo-wide stays at the root: the constitution
    validator, Gourmand, Gatehouse, CodeQL and `ruff check .`, whose own config
    is hierarchical and already picks up a nested pyproject for files under it.

    Written in the root pyproject and nowhere else, because the two hooks and
    the CI job all read that file and must agree; an env var or a CI argument
    would have to be told to three entry points separately.
    """
    raw = pyproject().get("tool", {}).get("sdlc", {}).get("project", ".")
    if not isinstance(raw, str):
        cannot(f"[tool.sdlc] project must be a string, not {type(raw).__name__}")
    if Path(raw).is_absolute() or ".." in Path(raw).parts:
        cannot(f"[tool.sdlc] project must be a relative path inside the repo; got {raw!r}")
    target = (REPO / raw).resolve()
    if not str(target).startswith(str(REPO.resolve())):
        cannot(f"[tool.sdlc] project escapes the repo: {raw!r}")
    if raw != "." and not (target / "pyproject.toml").is_file():
        cannot(f"[tool.sdlc] project {raw!r} has no pyproject.toml")
    return target


def need_project() -> None:
    """Assert this is a Python project, for the targets that require one."""
    if not (project_dir() / "pyproject.toml").is_file():
        cannot(
            "pyproject.toml does not exist, so this target has no project to "
            "check. constitution, gourmand and gatehouse work on any repo; "
            "ruff, mypy, pytest, semgrep and pip-audit need a Python project."
        )


def project_env() -> dict[str, str]:
    """Environment for the uv-managed project venv.

    The venv lives in the cache volume, keyed by project AND Python version.
    gates.sh records why the key needs both: two gates sharing one
    UV_PROJECT_ENVIRONMENT across different Python versions make uv rebuild the
    venv on every invocation, in both directions, forever.
    """
    # The subdirectory is part of the key: one repo can hold two projects, and
    # sharing a venv between them would make uv rebuild it on every invocation.
    sub = project_dir().relative_to(REPO.resolve())
    default = REPO.name if str(sub) == "." else f"{REPO.name}-{str(sub).replace('/', '-')}"
    name = os.environ.get("SDLC_PROJECT", default)
    pyver = f"{sys.version_info.major}.{sys.version_info.minor}"
    env = dict(os.environ)
    env.update(
        {
            "UV_CACHE_DIR": str(CACHE / "uv"),
            "UV_PROJECT_ENVIRONMENT": str(CACHE / "venv" / f"{name}-py{pyver.replace('.', '')}"),
            "UV_PYTHON_DOWNLOADS": "never",
            # The worktree is mounted read-only for most targets and HOME is
            # where uv, pytest and semgrep want to write their state.
            "HOME": "/tmp",
        }
    )
    return env


def run(
    cmd: list[str],
    *,
    env: dict[str, str] | None = None,
    stdin: bytes | None = None,
    tee: bool = False,
    # Where the tool runs. Defaults to the repo root; the uv-driven checks
    # pass the project directory, which [tool.sdlc] project may move.
    cwd: Path | None = None,
) -> tuple[int, str]:
    """Run a tool and return (ITS exit status, captured output).

    Anything that is not the tool's own verdict raises CannotRun.

    `tee=True` captures stderr+stdout AND prints it, for the one caller that has
    to read what the tool said as well as show it.
    """
    try:
        if tee:
            proc = subprocess.run(
                cmd,
                cwd=cwd or REPO,
                env=env if env is not None else dict(os.environ),
                input=stdin,
                check=False,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
            )
            sys.stdout.write(proc.stdout or "")
            sys.stdout.flush()
            captured = proc.stdout or ""
        else:
            proc = subprocess.run(
                cmd,
                cwd=cwd or REPO,
                env=env if env is not None else dict(os.environ),
                input=stdin,
                check=False,
            )
            captured = ""
    except FileNotFoundError:
        cannot(f"{cmd[0]} is not in this image")
    except PermissionError:
        cannot(f"{cmd[0]} is not executable")
    except OSError as exc:
        cannot(f"cannot start {cmd[0]}: {exc}")
    # 126/127 from a shell layer mean the same as the exceptions above: the tool
    # never ran. Never report those as a finding.
    if proc.returncode in (126, 127):
        cannot(f"{cmd[0]} could not be invoked (exit {proc.returncode})")
    return proc.returncode, captured


def need_lock_dep(name: str) -> None:
    """Refuse to claim a pass for a tool the project does not pin.

    mypy and pytest are the two checks whose version comes from the project's
    own uv.lock rather than from this image -- they load the project's plugins
    inside their own interpreter, so they cannot come from a tool venv. That
    makes "the repo forgot to depend on mypy" a real case, and the honest answer
    to it is 2, not 0.
    """
    lock = project_dir() / "uv.lock"
    if not lock.is_file():
        cannot("uv.lock is missing; mypy and pytest resolve from the project lock")
    try:
        text = lock.read_text(encoding="utf-8")
    except OSError as exc:
        cannot(f"cannot read uv.lock: {exc}")
    if f'name = "{name}"' not in text:
        cannot(
            f"{name} is not in uv.lock, so this check cannot run. "
            f"Add it to the project's dev dependencies -- it must come from the "
            f"project environment, not from this image, because it loads the "
            f"project's own plugins."
        )


def sync_project(env: dict[str, str]) -> None:
    """Build the project venv, or fail as 'could not run'."""
    step("uv sync --locked --all-extras")
    rc, _ = run(["uv", "sync", "--locked", "--all-extras"], env=env, cwd=project_dir())
    if rc != 0:
        cannot(
            "uv sync --locked failed. The lockfile is out of date with "
            "pyproject.toml, or a dependency is unavailable. Nothing was checked."
        )


# ---------------------------------------------------------------------- targets


# Every check takes its own settings table, `[tool.sdlc.<command>.<check>]`,
# empty when the repo wrote none. Paths are NOT settings here: each tool reads
# its own config (`[tool.ruff]` excludes, `[tool.mypy] files`,
# `[tool.pytest] testpaths`), so there is one place to say what gets checked.


def passthrough() -> list[str]:
    """What the caller put after `--` on a single-check run.

    `bin/sdlc` joins those words with the unit separator and exports
    SDLC_ARGS. It is deliberately not a plan field: the plan is this script
    telling the host what to run, and `plain()` guards it so that a repo's
    config can never forge a line into the host's shell. This travels the other
    way and ends up in an argv list, so there is no shell between the caller
    and the tool.

    Only a check that is a tool invocation reads this, and only `pytest` does
    today. A tier never sees it -- `bin/sdlc` clears the variable for
    commit/push/ci rather than refusing it, so an exported SDLC_ARGS cannot
    reach a tier's pytest -- and no `host` step argv is built from it.
    """
    raw = os.environ.get("SDLC_ARGS")
    if not raw:
        return []
    # Not filtered: `-k ''` is a legitimate empty argument.
    return raw.split(UNIT_SEPARATOR)


def t_ruff_check(s: dict) -> int:
    need_project()
    step("ruff check --fix .")
    return run(["ruff", "check", "--fix", "."])[0]


def t_ruff_format(s: dict) -> int:
