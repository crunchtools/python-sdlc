TOOL_COMMANDS = {
    "tiers": t_tiers,
    "list": t_list,
    "versions": t_versions,
    "pytest-deps": t_pytest_deps,
    "codeql-baseline": t_codeql_baseline,
}


def main() -> int:
    ap = argparse.ArgumentParser(
        prog="sdlc",
        description="The in-image half of `sdlc`. Exit 2 means a check COULD NOT RUN "
        "and is never to be worked around.",
    )
    ap.add_argument("what", help="a check name, or plan/tiers/list/versions")
    ap.add_argument("arg", nargs="?", help="for plan: commit, push, ci or a check name")
    args = ap.parse_args()

    if args.what == "plan":
        if not args.arg:
            cannot("plan needs commit, push, ci or a check name")
        return t_plan(args.arg)
    tool = TOOL_COMMANDS.get(args.what)
    if tool is not None:
        return tool()
    fn = BUILTINS.get(args.what)
    if fn is None:
        cannot(f"{args.what} is not a check this image runs itself")
    rc = fn(check_settings(sdlc_config(), args.what))
    # A tool's own 3 is not a deferral; only DeferredError grants one.
    return CANNOT_RUN if rc == DEFERRED else rc


if __name__ == "__main__":
    try:
        sys.exit(main())
    except CannotRunError as exc:
        print(f"GATE CANNOT RUN: {exc}", file=sys.stderr)
        sys.exit(CANNOT_RUN)
    except DeferredError as exc:
        print(
            f"GATE CANNOT RUN: {exc}\n"
            f"DEFERRED TO CI: this push is NOT blocked, and NOTHING was judged here. "
            f"The `sdlc ci` job is the judge of this commit -- read its verdict "
            f"before merging. Rerun `sdlc codeql` to see the failure as a 2.",
            file=sys.stderr,
        )
        sys.exit(DEFERRED)
    except KeyboardInterrupt:
        sys.exit(CANNOT_RUN)
