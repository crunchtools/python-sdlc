BUILD_VAR = re.compile(r"\$(?:\{(?P<braced>\w+)(?::?-(?P<default>[^}]*))?\}|(?P<bare>\w+))")
FROM_AS_WORDS = 3  # image, AS, name


def logical_lines(text: str) -> list[str]:
    """Containerfile instructions: continuations joined, comment lines dropped."""
    lines, buf = [], ""
    for raw in text.splitlines():
        if raw.lstrip().startswith("#"):
            continue  # a comment, even inside a continuation, is not an instruction
        if raw.rstrip().endswith("\\"):
            buf += raw.rstrip()[:-1] + " "
            continue
        lines.append((buf + raw).strip())
        buf = ""
    if buf.strip():
        lines.append(buf.strip())
    return lines


def build_stages(text: str) -> tuple[dict[str, str], list[tuple[str, str | None]]]:
    """The global ARG defaults, and each stage's (image word, lowercased AS name)."""
    args: dict[str, str] = {}
    stages: list[tuple[str, str | None]] = []
    for words in (line.split() for line in logical_lines(text)):
        op = words[0].upper() if words else ""
        if op == "ARG" and not stages:
            for name, eq, value in (w.partition("=") for w in words[1:]):
                if eq:
                    args[name] = value.strip("\"'")
        elif op == "FROM":
            rest = [w for w in words[1:] if not w.startswith("--")]
            is_aliased = len(rest) >= FROM_AS_WORDS and rest[1].upper() == "AS"
            if rest:
                stages.append((rest[0], rest[2].lower() if is_aliased else None))
    return args, stages


def final_base(text: str) -> str | None:
    """The image the FINAL stage of a Containerfile is built on, or None.

    Substring-matching every FROM line called a bootc builder stage under a plain
    runtime image bootc, and missed `ARG BASE=...-bootc` + `FROM ${BASE}`. What
    ships is the last stage, so resolve that: fill $X, ${X} and ${X:-d} from the
    global ARG defaults, and follow a `FROM <earlier-stage>` back to its own
    base. An unset variable gives None.
    """
    args, stages = build_stages(text)
    index = len(stages) - 1
    seen: set[int] = set()
    while index >= 0 and index not in seen:
        seen.add(index)
        image = stages[index][0]
        names = [m["braced"] or m["bare"] for m in BUILD_VAR.finditer(image)]
        defaults = [m["default"] for m in BUILD_VAR.finditer(image)]
        if any(n not in args and d is None for n, d in zip(names, defaults, strict=True)):
            return None
        image = BUILD_VAR.sub(
            lambda m: args.get(m["braced"] or m["bare"], m["default"] or ""), image
        )
        earlier = [i for i in range(index) if stages[i][1] == image.lower()]
        if not earlier:
            return image or None
        index = earlier[-1]
    return None


def is_bootc(path: str) -> bool:
    """Does this Containerfile build a bootable host rather than a container?

    A bootc image starts systemd as PID 1 and is not meant to run as an app, so
    a smoke run of it judges nothing. It gets its own stack instead.
    """
    try:
        text = (REPO / path).read_text(encoding="utf-8", errors="replace")
    except OSError as exc:
        cannot(f"cannot read {path} to tell a container from a bootc image: {exc}")
    base = final_base(text)
    return base is not None and "bootc" in base.lower()


def detect_stacks() -> list[str]:
    """The stacks this repo's files show, in STACKS-then-planned order."""
    found = []
    if (REPO / "pyproject.toml").is_file():
        found.append("python")
    cf = containerfile()
    if cf and not is_bootc(cf):
        found.append("container")
    if (REPO / "package.json").is_file() or package_dirs():
        found.append("node")
    if cf and is_bootc(cf):
        found.append("bootc")
    return found or ["docs"]


def package_dirs() -> list[str]:
    """Directories below the root holding a package.json of the repo's own.

    A package.json only in `frontend/` is still a node project. Without this a
    repo with no other stack fell through to docs and went green with its code
    never linted, tested or audited. It is detected as node, and node_packages
    then refuses the default `packages = ["."]` with these directories named,
    so the repo says which ones are its packages rather than the gate guessing.

    Asked of git, which knows what is ignored; a tree that is not a checkout is
    walked. Never anything under node_modules.
    """
    try:
        proc = subprocess.run(
            ["git", "-c", "safe.directory=*", "ls-files", "-co", "--exclude-standard"],
            cwd=REPO,
            capture_output=True,
            check=False,
        )
        listed = (
            proc.stdout.decode("utf-8", "surrogateescape").splitlines()
            if proc.returncode == 0
            else None
        )
    except OSError:
        listed = None
    if listed is None:
        listed = []
        for root, dirs, files in os.walk(REPO):
            dirs[:] = [d for d in dirs if d not in (".git", "node_modules")]
            listed += [str((Path(root) / f).relative_to(REPO)) for f in files]
    return sorted(
        str(Path(f).parent)
        for f in listed
        if Path(f).name == "package.json"
        and Path(f).parent != Path()
        and "node_modules" not in Path(f).parts
    )


def stack_names(value: object, where: str) -> list[str]:
    out = names(value, where)
    unknown = sorted(set(out) - set(STACKS) - set(PLANNED_STACKS))
    if unknown:
        cannot(
            f"{where} names {', '.join(unknown)}; the stacks are "
            f"{', '.join(STACKS + PLANNED_STACKS)}"
        )
    return out


def active_stacks(cfg: dict) -> tuple[str, ...]:
    """The stacks this repo runs: detected, plus `stacks`, minus `skip-stacks`."""
    add = stack_names(cfg.get("stacks"), "[tool.sdlc] stacks")
    drop = stack_names(cfg.get("skip-stacks"), "[tool.sdlc] skip-stacks")
    if "stacks" not in cfg and "skip-stacks" not in cfg and (REPO / "pyproject.toml").is_file():
        return COMPAT_STACKS
    out = [s for s in detect_stacks() if s not in drop]
    out += [s for s in add if s not in out and s not in drop]
    # A stack this image cannot run yet is refused rather than left out: a repo
    # whose only stack is node, judged by nothing but the constitution, would
    # report green for checks that never existed.
    planned = [s for s in out if s in PLANNED_STACKS]
    if planned:
        cannot(
            f"this repo has the {', '.join(planned)} stack(s), which this image cannot "
            f"check yet. To run the rest without them, say so in its config: "
            f"[tool.sdlc] skip-stacks = {json.dumps(planned)}"
        )
    return tuple(out)


def in_stacks(check: str, stacks: tuple[str, ...]) -> bool:
    owner = STACK_OF.get(check)
    return owner is None or any(o in stacks for o in owner)


